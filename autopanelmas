#!/usr/bin/env bash
# Automates the MAS GUI (itzmasgaming) Pterodactyl installer.
# Requires `expect`. Installs it automatically if missing (Debian/Ubuntu).
#
# WHAT THIS DOES:
#   - Replays your menu selections automatically (3, 1, enters, 0,1,2,1, etc.)
#   - Feeds in your Cloudflare tunnel token when asked
#   - PAUSES once, because creating a node in the panel's web UI can't be
#     scripted — you log in, make the node, then paste back 4 values here
#   - Resumes and hands control to the terminal once Wings starts (no auto Ctrl+C)
#
# Review the installer source yourself before running this, it's an
# unofficial third-party script: 
#   curl -s https://raw.githubusercontent.com/itzmasgaming/gui/main/Mas | less
#
# Default panel login is Admin / 12345678 — change that password the moment
# you're inside the panel.

set -euo pipefail

if ! command -v expect >/dev/null 2>&1; then
  echo "Installing 'expect'..."
  sudo apt-get update -y && sudo apt-get install -y expect
fi

read -rp "Cloudflare Tunnel Token: " CF_TOKEN
echo
echo "Starting installer. It will pause partway through and ask you to"
echo "log into the panel (Admin / 12345678 — change this password!), create"
echo "a node with Daemon Port 8443, and paste back its UUID/Token ID/Token/URL."
echo

CF_TOKEN="$CF_TOKEN" expect -f - <<'EXPECT_EOF'
set timeout -1
set cf_token $env(CF_TOKEN)

proc send_line {val} { send -- "$val\r" }

spawn bash -c {bash <(curl -s https://raw.githubusercontent.com/itzmasgaming/gui/main/Mas)}

# --- Initial setup menu ---
sleep 1; send_line "3"
sleep 1; send_line "1"
sleep 1; send_line ""
sleep 1; send_line ""
sleep 1; send_line ""
sleep 1; send_line ""

# leave/back out to main menu
sleep 2; send_line ""

sleep 1; send_line "0"
sleep 1; send_line "1"
sleep 1; send_line "2"
sleep 1; send_line "1"

# --- Cloudflare token prompt ---
sleep 1; send_line "3"
expect -re {(?i)TOKEN.*:}
send_line $cf_token

sleep 1; send_line "0"
sleep 1; send_line "6"
sleep 1; send_line "1"
sleep 1; send_line "y"
sleep 1; send_line "y"
sleep 1; send_line ""
sleep 1; send_line "2"
sleep 1; send_line "1"
sleep 1; send_line "0"
sleep 1; send_line "0"
sleep 1; send_line "4"
sleep 1; send_line "1"
sleep 1; send_line ""
sleep 1; send_line "2"

# --- Manual step: you must use the panel's web UI here ---
send_user "\n\n=== ACTION NEEDED ===\n"
send_user "Open the Panel URL printed above in your browser.\n"
send_user "Log in with Admin / 12345678, CHANGE THAT PASSWORD immediately.\n"
send_user "Create a node (Daemon Port 8443 — match this in Cloudflare too).\n"
send_user "Then copy its UUID, Token ID, Token, and remote/Panel link.\n\n"

expect -re {(?i)UUID.*:}
send_user "Paste UUID: "
expect_user -re {(.*)\n}
send_line $expect_out(1,string)

expect -re {(?i)Token ID.*:}
send_user "Paste Token ID: "
expect_user -re {(.*)\n}
send_line $expect_out(1,string)

expect -re {(?i)Token.*:}
send_user "Paste Token: "
expect_user -re {(.*)\n}
send_line $expect_out(1,string)

expect -re {(?i)Panel URL.*:}
send_user "Paste Panel URL: "
expect_user -re {(.*)\n}
send_line $expect_out(1,string)

sleep 1; send_line "3"
sleep 1; send_line "1"

# Wings is starting now — hand the terminal back to you.
# Do NOT press Ctrl+C from here on.
interact
EXPECT_EOF
