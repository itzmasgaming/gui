#!/bin/bash

# Clear screen
clear
echo "=========================================="
echo "   MasGaming Auto Setup Script"
echo "=========================================="
echo ""

# Ask for Cloudflare Token first
read -p "Enter Cloudflare TOKEN: " CF_TOKEN
echo "Starting initial phase..."

# Define the sequence up until the panel setup
(
    echo "3"; sleep 1
    echo "1"; sleep 2
    echo ""; sleep 1 
    echo ""; sleep 1 
    echo ""; sleep 1 
    echo ""; sleep 1 
    echo ""; sleep 2 
    echo "0"; sleep 1
    echo "1"; sleep 1
    echo ""; sleep 1
    echo "2"; sleep 1
    echo "1"; sleep 1
    echo ""; sleep 2
    echo "3"; sleep 1
    echo "$CF_TOKEN"; sleep 2
    echo "0"; sleep 1
    echo "6"; sleep 1
    echo "1"; sleep 1
    echo "y"; sleep 1
    echo "y"; sleep 1
    echo ""; sleep 5 
    echo "2"; sleep 1
    echo "1"; sleep 1
    echo "0"; sleep 1
    echo "0"; sleep 1
    echo "4"; sleep 1
    echo "1"; sleep 1
    echo ""; sleep 2
    echo "2"; sleep 1
) | bash <(curl -s https://githubusercontent.com)

# Pause to let user configure the Panel
echo ""
echo "=================================================================="
echo "⚠️  PAUSED: ACTION REQUIRED IN YOUR BROWSER"
echo "=================================================================="
echo "1. Log into your Panel with these credentials:"
echo "   - Username: Admin"
echo "   - Password: 12345678"
echo "2. Create a node."
echo "   (Note: Daemon Port is 8443, change this in Cloudflare too)"
echo "3. Copy the Node configuration details."
echo "=================================================================="
echo ""

# Grab credentials from keyboard input
read -p "Enter Node UUID: " NODE_UUID < /dev/tty
read -p "Enter Node Token ID: " NODE_TOKEN_ID < /dev/tty
read -p "Enter Node Token: " NODE_TOKEN < /dev/tty
read -p "Enter Panel URL: " PANEL_URL < /dev/tty

echo ""
echo "Resuming automation to start Wings... Do not press Ctrl+C."
echo "=========================================="

# Final execution sequence using the newly gathered variables
(
    echo "$NODE_UUID"; sleep 1
    echo "$NODE_TOKEN_ID"; sleep 1
    echo "$NODE_TOKEN"; sleep 1
    echo "$PANEL_URL"; sleep 2
    echo "3"; sleep 1
    echo "1"; sleep 1
) | bash <(curl -s https://githubusercontent.com)
