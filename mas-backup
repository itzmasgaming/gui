#!/bin/bash
# MAS Backup - GoFile backup/restore menu
# Run: bash <(curl -sL itzmasgaming.github.io/gui/mas-backup)

[ "$(id -u)" -ne 0 ] && { echo "Run as root."; exit 1; }

DIR=/root/.masgui
HIST=$DIR/history.txt
TOKEN_FILE=$DIR/token
mkdir -p "$DIR"; touch "$HIST"

G='\033[1;32m'; R='\033[1;31m'; C='\033[1;36m'; Y='\033[1;33m'; N='\033[0m'

# ---- dependencies ----
need() {
  for t in curl tar jq; do
    command -v $t >/dev/null 2>&1 && continue
    echo -e "${Y}Installing $t...${N}"
    export DEBIAN_FRONTEND=noninteractive
    if command -v apt-get >/dev/null; then apt-get update -y >/dev/null 2>&1; apt-get install -y $t >/dev/null 2>&1
    elif command -v dnf >/dev/null; then dnf install -y $t >/dev/null 2>&1
    elif command -v yum >/dev/null; then yum install -y $t >/dev/null 2>&1
    elif command -v apk >/dev/null; then apk add $t >/dev/null 2>&1; fi
    command -v $t >/dev/null || { echo -e "${R}Could not install $t. Install it manually.${N}"; exit 1; }
  done
}

banner() {
  clear
  echo -e "${C}=============================="
  echo -e "        MAS  BACKUP"
  echo -e "==============================${N}"
}

pause() { echo; read -rp "Press Enter to continue..." _; }

# ---- 1) DOWNLOAD (create) BACKUP -> GoFile ----
do_backup() {
  banner
  echo -e "${G}Backup this VPS to GoFile${N}\n"
  echo "What to back up?"
  echo "  1) Default  (/home /root /etc /var/www /opt /srv)"
  echo "  2) Full system (everything)"
  echo "  3) Custom folders"
  read -rp "Choose [1]: " m; m=${m:-1}

  EXC=(--exclude=proc --exclude=sys --exclude=dev --exclude=run --exclude=tmp --exclude=mnt
       --exclude=media --exclude=lost+found --exclude=swapfile --exclude=root/.masgui
       --exclude=var/cache --exclude=var/tmp)
  case $m in
    2) PATHS=(.) ;;
    3) read -rp "Folders (space separated, e.g. /home /opt/app): " c
       PATHS=(); for p in $c; do [ -e "$p" ] && PATHS+=("${p#/}") || echo "Skip (not found): $p"; done ;;
    *) PATHS=(); for p in home root etc var/www opt srv; do [ -e "/$p" ] && PATHS+=("$p"); done ;;
  esac
  [ ${#PATHS[@]} -eq 0 ] && { echo -e "${R}Nothing to back up.${N}"; pause; return; }

  NAME="mas-$(hostname)-$(date +%Y%m%d-%H%M%S).tar.gz"
  OUT="$DIR/$NAME"
  echo -e "\n${Y}[1/2] Creating archive...${N}"
  tar -C / -czpf "$OUT" "${EXC[@]}" "${PATHS[@]}" 2>"$DIR/tar.err"
  rc=$?
  if [ $rc -gt 1 ]; then echo -e "${R}Archive failed:${N}"; tail -5 "$DIR/tar.err"; rm -f "$OUT"; pause; return; fi
  echo -e "Size: $(du -h "$OUT" | cut -f1)"

  echo -e "\n${Y}[2/2] Uploading to GoFile...${N}"
  AUTH=()
  [ -s "$TOKEN_FILE" ] && AUTH=(-H "Authorization: Bearer $(cat "$TOKEN_FILE")")
  curl -# "${AUTH[@]}" -F "file=@$OUT" https://upload.gofile.io/uploadfile -o "$DIR/resp.json"
  echo
  if [ "$(jq -r .status "$DIR/resp.json" 2>/dev/null)" != "ok" ]; then
    echo -e "${R}Upload failed:${N}"; cat "$DIR/resp.json"; echo
    echo "Archive kept at: $OUT"; pause; return
  fi
  LINK=$(jq -r .data.downloadPage "$DIR/resp.json")
  echo "$(date '+%Y-%m-%d %H:%M')|$(hostname)|$NAME|$LINK" >> "$HIST"
  rm -f "$OUT"
  echo -e "\n${G}DONE! Backup link (saved):${N}"
  echo -e "${C}$LINK${N}"
  pause
}

# ---- 2) IMPORT BACKUP <- GoFile ----
do_import() {
  banner
  echo -e "${G}Import backup from GoFile${N}\n"
  if [ -s "$HIST" ]; then
    echo "Saved backups:"
    nl -w2 -s') ' <(awk -F'|' '{print $1"  "$2"  "$4}' "$HIST")
    echo
  fi
  read -rp "Paste GoFile link (or number from list): " LINK
  if [[ "$LINK" =~ ^[0-9]+$ ]]; then LINK=$(sed -n "${LINK}p" "$HIST" | awk -F'|' '{print $4}'); fi
  [ -z "$LINK" ] && { echo -e "${R}No link.${N}"; pause; return; }
  CODE=${LINK%/}; CODE=${CODE##*/}

  read -rp "Restore to [/] (/ = same places as before): " TARGET; TARGET=${TARGET:-/}
  echo "Skip system files (network, fstab, hostname, SSH host keys)?"
  read -rp "Say Y when moving to a DIFFERENT vps [Y/n]: " SK; SK=${SK:-Y}
  echo -e "${R}This will overwrite files in $TARGET.${N}"
  read -rp "Continue? [y/N]: " ok; [[ "$ok" =~ ^[Yy]$ ]] || return

  echo -e "\n${Y}[1/2] Downloading...${N}"
  TOKEN=$(curl -s -X POST https://api.gofile.io/accounts | jq -r .data.token)
  [ -z "$TOKEN" -o "$TOKEN" = null ] && { echo -e "${R}Could not get GoFile token.${N}"; pause; return; }
  META=$(curl -s -H "Authorization: Bearer $TOKEN" "https://api.gofile.io/contents/$CODE?wt=4fd6sg89d7s6")
  if [ "$(echo "$META" | jq -r .status)" != "ok" ]; then
    echo -e "${R}GoFile error (link expired/deleted?):${N}"; echo "$META" | head -c 300; echo; pause; return
  fi
  FURL=$(echo "$META" | jq -r '[.data.children[] | select(.type=="file")][0].link')
  [ -z "$FURL" -o "$FURL" = null ] && { echo -e "${R}No file found at this link.${N}"; pause; return; }
  IN="$DIR/restore.tar.gz"
  curl -# -L -H "Cookie: accountToken=$TOKEN" "$FURL" -o "$IN"
  tar -tzf "$IN" >/dev/null 2>&1 || { echo -e "${R}Downloaded file is not a valid backup.${N}"; rm -f "$IN"; pause; return; }

  echo -e "\n${Y}[2/2] Restoring to $TARGET ...${N}"
  mkdir -p "$TARGET"
  SKIP=()
  if [[ "$SK" =~ ^[Yy]$ ]]; then
    SKIP=(--exclude=etc/fstab --exclude=etc/netplan --exclude=etc/network --exclude=etc/hostname
          --exclude=etc/hosts --exclude=etc/machine-id --exclude=etc/resolv.conf --exclude=etc/cloud
          --exclude=boot "--exclude=etc/ssh/ssh_host_*")
  fi
  tar -xzpf "$IN" -C "$TARGET" --numeric-owner "${SKIP[@]}" 2>"$DIR/tar.err"
  rc=$?
  rm -f "$IN"
  [ $rc -gt 1 ] && { echo -e "${R}Restore had errors:${N}"; tail -5 "$DIR/tar.err"; } || echo -e "${G}DONE! Files restored.${N}"
  echo "Tip: restart your services (nginx, docker...) or reboot."
  pause
}

need
while true; do
  banner
  echo
  echo -e "  ${G}1)${N} Download backup"
  echo -e "  ${G}2)${N} Import backup"
  echo -e "  ${R}0)${N} Exit"
  echo
  read -rp "Choose: " ch
  case $ch in
    1) do_backup ;;
    2) do_import ;;
    0) echo "Bye!"; exit 0 ;;
    *) echo "Invalid option"; sleep 1 ;;
  esac
done
