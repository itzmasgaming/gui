#!/bin/bash
# MAS GUI v4.5 - GoFile backup/restore menu
# Run: bash <(curl -sL itzmasgaming.github.io/gui/mas-backup)

[ "$(id -u)" -ne 0 ] && { echo "Run as root."; exit 1; }

DIR=/root/.masgui
HIST=$DIR/history.txt
TOKEN_FILE=$DIR/token
mkdir -p "$DIR"; touch "$HIST"

[[ "${LANG:-}${LC_ALL:-}" != *[Uu][Tt][Ff]* ]] && export LANG=C.UTF-8 LC_ALL=C.UTF-8
VER="v4.5"
T='\033[38;5;115m'; G='\033[1;32m'; R='\033[1;31m'; C='\033[1;36m'; Y='\033[1;33m'
W='\033[1;37m'; D='\033[2m'; N='\033[0m'
BW=50   # box width

# ---- dependencies ----
need() {
  for t in curl tar jq; do
    command -v $t >/dev/null 2>&1 && continue
    echo -e "${Y}Installing $t...${N}"
    export DEBIAN_FRONTEND=noninteractive
    if command -v apt-get >/dev/null; then apt-get update -y >/dev/null 2>&1; apt-get install -y $t >/dev/null 2>&1
    elif command -v dnf >/dev/null; then dnf install -y $t >/dev/null 2>&1
    elif command -v yum >/dev/null; then yum install -y $t >/dev/null 2>&1
    elif command -v apk >/dev/null; then apk add $t >/dev/null 2>&1; fi
    command -v $t >/dev/null || { echo -e "${R}Could not install $t. Install it manually.${N}"; exit 1; }
  done
}

# centered line inside the box
bline() { local t="$1" col="$2" pad l r tt="${1//◆/x}"; pad=$(( BW - 2 - ${#tt} )); l=$(( pad / 2 )); r=$(( pad - l ))
  printf "${T}┃${N}%*s${col}%s${N}%*s${T}┃${N}\n" $l "" "$t" $r ""; }

banner() {   # $1 = sub title
  clear
  local h; h=$(printf '━%.0s' $(seq 1 $((BW-2))))
  echo
  echo -e "${T}┏${h}┓${N}"
  bline "" ""
  bline "◆ MAS GUI ◆" "$W"
  bline "${1:-Main Menu}" "$T"
  bline "$VER" "$W"
  bline "" ""
  echo -e "${T}┗${h}┛${N}"
  echo
}

opt()  { echo -e "  ${T}❯${N} ${T}$1${N} $2"; }          # menu option
optx() { echo -e "  ${T}❯${N} ${R}$1${N} $2"; }          # exit/back option
ok()   { echo -e "  ${G}✔${N} $1"; }
bad()  { echo -e "  ${R}✘${N} $1"; }
step() { echo -e "\n  ${Y}➜${N} ${W}$1${N}"; }
ask()  { printf "${T}%s${N} " "$1"; }                 # prompt prefix

sysinfo() {
  local ip free n last
  ip=$(hostname -I 2>/dev/null | awk '{print $1}'); free=$(df -h / 2>/dev/null | awk 'NR==2{print $4}')
  n=$(wc -l < "$HIST" 2>/dev/null); last=$(tail -1 "$HIST" 2>/dev/null | cut -d'|' -f1)
  echo -e "  ${D}Host${N} ${W}$(hostname)${N}  ${D}IP${N} ${W}${ip:-?}${N}  ${D}Free${N} ${W}${free:-?}${N}"
  echo -e "  ${D}Backups${N} ${W}${n:-0}${N}  ${D}Last${N} ${W}${last:-never}${N}"
}

pause() { echo; printf "  ${D}Press Enter to go back...${N}"; read -r _; }

# ---- 1) DOWNLOAD (create) BACKUP -> GoFile ----
do_backup() {
  banner "Download Backup"
  echo -e "  ${W}What to back up?${N}\n"
  opt 1 "Default ${D}(/home /root /etc /var/www /opt /srv)${N}"
  opt 2 "Full system ${D}(everything)${N}"
  opt 3 "Custom folders"
  echo; ask "Select an option [1]:"; read -r m; m=${m:-1}

  EXC=(--exclude=proc --exclude=sys --exclude=dev --exclude=run --exclude=tmp --exclude=mnt
       --exclude=media --exclude=lost+found --exclude=swapfile --exclude=root/.masgui
       --exclude=var/cache --exclude=var/tmp)
  case $m in
    2) PATHS=(.) ;;
    3) ask "Folders (e.g. /home /opt/app):"; read -r c
       PATHS=(); for p in $c; do [ -e "$p" ] && PATHS+=("${p#/}") || echo "Skip (not found): $p"; done ;;
    *) PATHS=(); for p in home root etc var/www opt srv; do [ -e "/$p" ] && PATHS+=("$p"); done ;;
  esac
  [ ${#PATHS[@]} -eq 0 ] && { bad "Nothing to back up."; pause; return; }

  NAME="mas-$(hostname)-$(date +%Y%m%d-%H%M%S).tar.gz"
  OUT="$DIR/$NAME"
  step "[1/2] Creating archive..."
  tar -C / -czpf "$OUT" "${EXC[@]}" "${PATHS[@]}" 2>"$DIR/tar.err"
  rc=$?
  if [ $rc -gt 1 ]; then echo -e "${R}Archive failed:${N}"; tail -5 "$DIR/tar.err"; rm -f "$OUT"; pause; return; fi
  echo -e "Size: $(du -h "$OUT" | cut -f1)"

  step "[2/2] Uploading to GoFile..."
  AUTH=()
  [ -s "$TOKEN_FILE" ] && AUTH=(-H "Authorization: Bearer $(cat "$TOKEN_FILE")")
  curl -# "${AUTH[@]}" -F "file=@$OUT" https://upload.gofile.io/uploadfile -o "$DIR/resp.json"
  echo
  if [ "$(jq -r .status "$DIR/resp.json" 2>/dev/null)" != "ok" ]; then
    echo -e "${R}Upload failed:${N}"; cat "$DIR/resp.json"; echo
    echo "Archive kept at: $OUT"; pause; return
  fi
  LINK=$(jq -r .data.downloadPage "$DIR/resp.json")
  echo "$(date '+%Y-%m-%d %H:%M')|$(hostname)|$NAME|$LINK" >> "$HIST"
  rm -f "$OUT"
  echo; ok "Backup done and saved!"
  echo -e "  ${D}Link${N}  ${T}$LINK${N}"
  pause
}

is_gz() { [ "$(head -c2 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n')" = "1f8b" ]; }

# ---- Google Drive (public "anyone with the link" files) ----
fetch_gdrive() {
  local link=$1 out=$2 id jar="$DIR/gd.cookie" page="$DIR/gd.tmp" uuid base
  id=$(echo "$link" | sed -nE 's#.*/d/([A-Za-z0-9_-]+).*#\1#p')
  [ -z "$id" ] && id=$(echo "$link" | sed -nE 's#.*[?&]id=([A-Za-z0-9_-]+).*#\1#p')
  [ -z "$id" ] && { echo "  Could not find the file ID in that link."; return 1; }
  base="https://drive.usercontent.google.com/download?id=$id&export=download&confirm=t"
  rm -f "$jar" "$page"
  curl -# -L -c "$jar" -b "$jar" "$base" -o "$page" || return 1
  if ! is_gz "$page"; then   # large-file warning page: read its hidden form field and retry
    uuid=$(grep -oE 'name="uuid" value="[^"]+"' "$page" | head -1 | sed -E 's/.*value="([^"]+)".*/\1/')
    if [ -n "$uuid" ]; then curl -# -L -c "$jar" -b "$jar" "$base&uuid=$uuid" -o "$page" || return 1; fi
  fi
  rm -f "$jar"
  if is_gz "$page"; then mv "$page" "$out"; return 0; fi
  if grep -qi 'quota\|too many users' "$page" 2>/dev/null; then echo "  Google Drive download quota exceeded. Try again later."
  else echo "  Not a backup file. Set sharing to 'Anyone with the link' and check the link."; fi
  rm -f "$page"; return 1
}

# ---- any direct download link (Dropbox, your own server, etc.) ----
fetch_url() {
  local url=$1 out=$2
  url=${url/dl=0/dl=1}
  curl -# -L -A "Mozilla/5.0" "$url" -o "$out" || return 1
  is_gz "$out" || { echo "  Not a valid .tar.gz backup at that link."; rm -f "$out"; return 1; }
}

# ---- GoFile web-client style download (works for any public link, free) ----
GF_UA="Mozilla/5.0"
GF_H=(-H "User-Agent: $GF_UA" -H "Origin: https://gofile.io" -H "Referer: https://gofile.io/" -H "X-BL: en-US")

# X-Website-Token = sha256("UA::en-US::accountToken::timeSlot::salt"), changes every 4 hours
gf_wt() { printf '%s' "${GF_UA}::en-US::${1}::$(( $(date +%s) / 14400 ))::12af056dacea0b" | sha256sum | cut -d' ' -f1; }

gf_try() {   # $1=code $2=out $3=token
  local code=$1 out=$2 token=$3 meta st furl
  meta=$(curl -s "${GF_H[@]}" -H "Authorization: Bearer $token" -H "X-Website-Token: $(gf_wt "$token")" \
         "https://api.gofile.io/contents/$code?cache=true&sortField=createTime&sortDirection=1")
  st=$(echo "$meta" | jq -r .status 2>/dev/null)
  if [ "$st" != ok ]; then echo -e "  GoFile says: ${st:-no response}"; return 1; fi
  furl=$(echo "$meta" | jq -r '[.data.children[] | select(.type=="file")][0].link' 2>/dev/null)
  [ -z "$furl" -o "$furl" = null ] && furl=$(echo "$meta" | jq -r 'select(.data.type=="file") | .data.link' 2>/dev/null)
  [ -z "$furl" -o "$furl" = null ] && { echo "  No file found at this link."; return 1; }
  echo -e "${Y}Downloading...${N}"
  curl -# -L "${GF_H[@]}" -H "Cookie: accountToken=$token" "$furl" -o "$out" || return 1
  is_gz "$out" || { echo "  Downloaded file is not a valid backup."; rm -f "$out"; return 1; }
}

fetch_gofile() {
  local code=$1 out=$2 token
  # 1) saved account token (if any)
  if [ -s "$TOKEN_FILE" ]; then gf_try "$code" "$out" "$(cat "$TOKEN_FILE")" && return 0; fi
  # 2) free guest account
  token=$(curl -s -X POST "${GF_H[@]}" -H "X-Website-Token: $(gf_wt "")" https://api.gofile.io/accounts | jq -r .data.token 2>/dev/null)
  [ -z "$token" -o "$token" = null ] && { echo "  Could not create GoFile guest account."; return 1; }
  gf_try "$code" "$out" "$token"
}

get_backup() {   # $1=kind $2=link $3=out
  case $1 in
    gofile) local c=${2%/}; c=${c##*/}; fetch_gofile "$c" "$3" ;;
    gdrive) fetch_gdrive "$2" "$3" ;;
    url)    fetch_url "$2" "$3" ;;
  esac
}

# ---- 2) IMPORT BACKUP (GoFile / Google Drive / any link) ----
do_import() {
  banner "Import Backup"
  opt 1 "GoFile link"
  opt 2 "Google Drive"
  opt 3 "3rd party ${D}(link to download)${N}"
  echo -e "  ${D}❯ 4 More options coming soon${N}"
  optx 0 "Back"
  echo; ask "Select an option:"; read -r src
  local kind LINK
  case $src in
    1) kind=gofile
       if [ -s "$HIST" ]; then
         echo; echo -e "  ${W}Saved backups:${N}"
         nl -w4 -s') ' <(awk -F'|' '{print $1"  "$2"  "$4}' "$HIST")
       fi
       echo; ask "GoFile link (or number from list):"; read -r LINK
       if [[ "$LINK" =~ ^[0-9]+$ ]]; then LINK=$(sed -n "${LINK}p" "$HIST" | awk -F'|' '{print $4}'); fi ;;
    2) kind=gdrive
       echo; echo -e "  ${D}The file must be shared as \"Anyone with the link\".${N}"
       ask "Google Drive link:"; read -r LINK ;;
    3) kind=url
       echo; ask "Direct download link (https://...):"; read -r LINK ;;
    4) echo -e "\n  ${Y}Coming soon!${N}"; pause; return ;;
    *) return ;;
  esac
  [ -z "$LINK" ] && { bad "No link."; pause; return; }

  echo
  ask "Restore to [/] (/ = same places):"; read -r TARGET; TARGET=${TARGET:-/}
  echo -e "  ${D}Skip system files (network, fstab, hostname, SSH host keys)?${N}"
  ask "Y = moving to a DIFFERENT vps [Y/n]:"; read -r SK; SK=${SK:-Y}
  echo -e "  ${R}This will overwrite files in $TARGET.${N}"
  ask "Continue? [y/N]:"; read -r ok; [[ "$ok" =~ ^[Yy]$ ]] || return

  IN="$DIR/restore.tar.gz"; KEEP=0
  step "[1/2] Getting backup..."
  if ! get_backup "$kind" "$LINK" "$IN"; then
    echo; bad "Could not download the backup."; echo
    [ "$kind" = gofile ] && opt 1 "Paste my GoFile account token"
    opt 2 "Use a backup .tar.gz already on this VPS"
    optx 0 "Back"
    echo; ask "Select an option:"; read -r o
    case $o in
      1) [ "$kind" = gofile ] || return
         ask "Token:"; read -r t; [ -z "$t" ] && return
         echo "$t" > "$TOKEN_FILE"; chmod 600 "$TOKEN_FILE"
         get_backup "$kind" "$LINK" "$IN" || { bad "Still failed."; pause; return; } ;;
      2) ask "Path to .tar.gz:"; read -r p
         [ -f "$p" ] || { bad "File not found."; pause; return; }
         IN="$p"; KEEP=1 ;;
      *) return ;;
    esac
  fi

  step "[2/2] Restoring to $TARGET ..."
  mkdir -p "$TARGET"
  SKIP=()
  if [[ "$SK" =~ ^[Yy]$ ]]; then
    SKIP=(--exclude=etc/fstab --exclude=etc/netplan --exclude=etc/network --exclude=etc/hostname
          --exclude=etc/hosts --exclude=etc/machine-id --exclude=etc/resolv.conf --exclude=etc/cloud
          --exclude=boot "--exclude=etc/ssh/ssh_host_*")
  fi
  tar -xzpf "$IN" -C "$TARGET" --numeric-owner "${SKIP[@]}" 2>"$DIR/tar.err"
  rc=$?
  [ $KEEP -eq 0 ] && rm -f "$IN"
  if [ $rc -gt 1 ]; then bad "Restore had errors:"; tail -5 "$DIR/tar.err"; else ok "Files restored."; fi
  echo -e "  ${D}Tip: restart your services (nginx, docker...) or reboot.${N}"
  pause
}

need
while true; do
  banner "Main Menu"
  opt 1 "Download backup"
  opt 2 "Import backup"
  optx 0 "Exit"
  echo
  ask "Select an option:"; read -r ch
  case $ch in
    1) do_backup ;;
    2) do_import ;;
    0) echo -e "\n  ${T}Bye!${N}\n"; exit 0 ;;
    *) bad "Invalid option"; sleep 1 ;;
  esac
done
