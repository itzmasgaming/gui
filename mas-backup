#!/bin/bash
# MAS GUI - Backup/Restore installer
# Usage: bash <(curl -sL itzmasgaming.github.io/gui/mas-backup)
if [ "$(id -u)" -ne 0 ]; then echo "Run as root."; exit 1; fi

export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
APP=/opt/masgui
PORT=8080
mkdir -p "$APP"

echo "[1/5] Installing dependencies (broken repos are ignored)..."
if command -v apt-get >/dev/null 2>&1; then
  apt-get update -y >/dev/null 2>&1 || true
  apt-get install -y python3 python3-venv python3-pip curl >/dev/null 2>&1 || \
    apt-get install -y python3 python3-venv python3-pip curl --allow-unauthenticated >/dev/null 2>&1 || true
elif command -v dnf >/dev/null 2>&1; then
  dnf install -y python3 python3-pip curl >/dev/null 2>&1 || true
elif command -v yum >/dev/null 2>&1; then
  yum install -y python3 python3-pip curl >/dev/null 2>&1 || true
fi

echo "[2/5] Setting up Python environment..."
if [ ! -x "$APP/venv/bin/pip" ]; then
  rm -rf "$APP/venv"
  python3 -m venv "$APP/venv" || { echo "ERROR: python3-venv missing. Run: apt install -y python3-venv"; exit 1; }
fi
"$APP/venv/bin/pip" install -q --upgrade pip >/dev/null 2>&1 || true
"$APP/venv/bin/pip" install -q flask requests requests_toolbelt

echo "[3/5] Writing app..."
cat > "$APP/masgui.py" <<'PYEOF'
#!/usr/bin/env python3
"""
MAS GUI - Backup to GoFile / Restore from GoFile (VPS1 -> VPS2, or VPS1 -> VPS1 after reset)

Install:   pip install flask requests requests_toolbelt
Run:       sudo python3 masgui.py            (root is needed to read/restore all files)
Open:      http://SERVER_IP:8080   (login: admin / password printed on first run)
Safer:     sudo python3 masgui.py --host 127.0.0.1   then use:  ssh -L 8080:127.0.0.1:8080 user@server
"""
import argparse, json, os, secrets, socket, tarfile, threading, time, uuid
from datetime import datetime
from functools import wraps

import requests
from flask import Flask, Response, jsonify, request
from requests_toolbelt import MultipartEncoder, MultipartEncoderMonitor

CFG_DIR = os.path.expanduser("~/.masgui")
CFG_FILE = os.path.join(CFG_DIR, "config.json")
HIST_FILE = os.path.join(CFG_DIR, "history.json")
WORK_DIR = os.path.join(CFG_DIR, "work")
os.makedirs(WORK_DIR, exist_ok=True)

DEFAULT_PATHS = ["/home", "/root", "/etc", "/var/www", "/opt", "/srv"]
ALWAYS_EXCLUDE = ("/proc", "/sys", "/dev", "/run", "/tmp", "/mnt", "/media",
                  "/lost+found", "/swapfile", "/root/.masgui", "/var/cache", "/var/tmp")
# Files that break a DIFFERENT server if restored onto it (network, disks, host identity)
SYSTEM_SKIP = ("etc/fstab", "etc/netplan", "etc/network", "etc/hostname", "etc/hosts",
               "etc/machine-id", "etc/resolv.conf", "etc/cloud", "boot", "etc/ssh/ssh_host_")
MANIFEST = "MASGUI_MANIFEST.json"

app = Flask(__name__)
JOBS = {}


# ---------- config / auth ----------
def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default

def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2)

cfg = load_json(CFG_FILE, {})
if "password" not in cfg:
    cfg["password"] = secrets.token_urlsafe(10)
    save_json(CFG_FILE, cfg)
    os.chmod(CFG_FILE, 0o600)

def auth(f):
    @wraps(f)
    def w(*a, **k):
        au = request.authorization
        if not au or au.username != "admin" or not secrets.compare_digest(au.password or "", cfg["password"]):
            return Response("Login required", 401, {"WWW-Authenticate": 'Basic realm="MAS GUI"'})
        return f(*a, **k)
    return w


# ---------- jobs ----------
def new_job(kind):
    jid = uuid.uuid4().hex[:8]
    JOBS[jid] = {"id": jid, "kind": kind, "status": "running", "log": [], "pct": 0, "result": None}
    return JOBS[jid]

def log(job, msg):
    job["log"].append(f"[{time.strftime('%H:%M:%S')}] {msg}")


# ---------- GoFile ----------
def gofile_token():
    r = requests.post("https://api.gofile.io/accounts", timeout=30)
    r.raise_for_status()
    return r.json()["data"]["token"]

def gofile_upload(path, job):
    token = cfg.get("gofile_token")
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    size = os.path.getsize(path)
    with open(path, "rb") as fh:
        enc = MultipartEncoder(fields={"file": (os.path.basename(path), fh, "application/gzip")})
        last = [0]
        def cb(m):
            pct = int(m.bytes_read * 100 / max(enc.len, 1))
            if pct != last[0]:
                last[0] = pct
                job["pct"] = 50 + pct // 2
        mon = MultipartEncoderMonitor(enc, cb)
        headers["Content-Type"] = mon.content_type
        r = requests.post("https://upload.gofile.io/uploadfile", data=mon, headers=headers, timeout=None)
    r.raise_for_status()
    j = r.json()
    if j.get("status") != "ok":
        raise RuntimeError(f"GoFile error: {j}")
    return j["data"]["downloadPage"], size

def gofile_download(link, dest, job):
    code = link.rstrip("/").split("/")[-1]
    token = gofile_token()
    r = requests.get(f"https://api.gofile.io/contents/{code}?wt=4fd6sg89d7s6",
                     headers={"Authorization": f"Bearer {token}"}, timeout=30)
    r.raise_for_status()
    j = r.json()
    if j.get("status") != "ok":
        raise RuntimeError(f"GoFile said: {j}")
    files = [c for c in j["data"].get("children", {}).values() if c.get("type") == "file"]
    if not files:
        raise RuntimeError("No file found at this link (expired or deleted?)")
    f = files[0]
    log(job, f"Downloading {f['name']} ({f.get('size', 0) // 1024 // 1024} MB)")
    with requests.get(f["link"], headers={"Cookie": f"accountToken={token}"}, stream=True, timeout=60) as d:
        d.raise_for_status()
        total = int(d.headers.get("content-length", 0)) or 1
        got = 0
        with open(dest, "wb") as out:
            for chunk in d.iter_content(1024 * 1024):
                out.write(chunk)
                got += len(chunk)
                job["pct"] = min(50, int(got * 50 / total))


# ---------- backup ----------
def excluded(p):
    return any(p == e or p.startswith(e + "/") for e in ALWAYS_EXCLUDE)

def do_backup(job, paths):
    try:
        name = f"masgui-{socket.gethostname()}-{datetime.now():%Y%m%d-%H%M%S}.tar.gz"
        out = os.path.join(WORK_DIR, name)
        log(job, f"Creating {name}")
        count = skipped = 0
        manifest = {"host": socket.gethostname(), "created": datetime.now().isoformat(), "paths": paths}
        mpath = os.path.join(WORK_DIR, MANIFEST)
        save_json(mpath, manifest)
        with tarfile.open(out, "w:gz") as tar:
            tar.add(mpath, arcname=MANIFEST)
            for base in paths:
                if not os.path.exists(base):
                    log(job, f"Skip (not found): {base}")
                    continue
                for root, dirs, files in os.walk(base):
                    dirs[:] = [d for d in dirs if not excluded(os.path.join(root, d))]
                    for n in dirs + files:
                        full = os.path.join(root, n)
                        try:
                            tar.add(full, arcname=full.lstrip("/"), recursive=False)
                            count += 1
                        except Exception:
                            skipped += 1
                job["pct"] = min(45, job["pct"] + 45 // max(len(paths), 1))
                log(job, f"Added {base}")
        os.remove(mpath)
        log(job, f"Archive done: {count} items, {skipped} skipped. Uploading to GoFile...")
        job["pct"] = 50
        link, size = gofile_upload(out, job)
        os.remove(out)
        hist = load_json(HIST_FILE, [])
        hist.insert(0, {"name": name, "link": link, "size": size, "date": datetime.now().strftime("%Y-%m-%d %H:%M"),
                        "host": socket.gethostname()})
        save_json(HIST_FILE, hist)
        job.update(status="done", pct=100, result=link)
        log(job, f"DONE. Link saved: {link}")
    except Exception as e:
        job.update(status="error")
        log(job, f"ERROR: {e}")


# ---------- restore ----------
def skip_member(name, skip_system):
    n = name.lstrip("./")
    if n == MANIFEST:
        return True
    if ".." in n.split("/"):
        return True  # path traversal guard
    return skip_system and any(n == s or n.startswith(s) for s in SYSTEM_SKIP)

def do_restore(job, link, target, skip_system):
    try:
        os.makedirs(target, exist_ok=True)
        dest = os.path.join(WORK_DIR, "restore.tar.gz")
        gofile_download(link, dest, job)
        log(job, f"Extracting into {target} (skip system files: {skip_system})")
        done = skipped = 0
        with tarfile.open(dest, "r:gz") as tar:
            members = tar.getmembers()
            for i, m in enumerate(members):
                if skip_member(m.name, skip_system):
                    skipped += 1
                    continue
                try:
                    try:
                        tar.extract(m, target, filter="tar")
                    except TypeError:  # older Python
                        tar.extract(m, target)
                    done += 1
                except Exception as e:
                    skipped += 1
                    log(job, f"Skip {m.name}: {e}")
                if i % 200 == 0:
                    job["pct"] = 50 + int(i * 50 / max(len(members), 1))
        os.remove(dest)
        job.update(status="done", pct=100)
        log(job, f"DONE. Restored {done} items, skipped {skipped}.")
        log(job, "Tip: restart your services (nginx, docker, etc.) or reboot.")
    except Exception as e:
        job.update(status="error")
        log(job, f"ERROR: {e}")


# ---------- API ----------
@app.post("/api/backup")
@auth
def api_backup():
    paths = [p.strip() for p in (request.json or {}).get("paths", DEFAULT_PATHS) if p.strip()]
    job = new_job("backup")
    threading.Thread(target=do_backup, args=(job, paths), daemon=True).start()
    return jsonify(id=job["id"])

@app.post("/api/restore")
@auth
def api_restore():
    d = request.json or {}
    job = new_job("restore")
    threading.Thread(target=do_restore, args=(job, d["link"], d.get("target") or "/", d.get("skip_system", True)),
                     daemon=True).start()
    return jsonify(id=job["id"])

@app.get("/api/job/<jid>")
@auth
def api_job(jid):
    return jsonify(JOBS.get(jid, {"status": "unknown", "log": [], "pct": 0}))

@app.get("/api/history")
@auth
def api_history():
    return jsonify(load_json(HIST_FILE, []))

@app.post("/api/settings")
@auth
def api_settings():
    cfg["gofile_token"] = (request.json or {}).get("token", "").strip()
    save_json(CFG_FILE, cfg)
    return jsonify(ok=True)

@app.get("/")
@auth
def index():
    return PAGE.replace("__PATHS__", "\n".join(DEFAULT_PATHS))


PAGE = """<!doctype html><html><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>MAS GUI</title><style>
body{font-family:system-ui;background:#0f1218;color:#e6e8ee;margin:0;padding:20px}
.wrap{max-width:820px;margin:auto}h1{margin:0 0 16px}
.card{background:#181d27;border:1px solid #2a3142;border-radius:12px;padding:18px;margin-bottom:16px}
h2{margin:0 0 10px;font-size:18px}textarea,input[type=text]{width:100%;box-sizing:border-box;background:#0f1218;color:#e6e8ee;border:1px solid #2a3142;border-radius:8px;padding:10px;font-family:monospace}
textarea{height:110px}button{background:#4f7cff;color:#fff;border:0;border-radius:8px;padding:10px 18px;font-size:15px;cursor:pointer;margin-top:10px}
button.s{background:#2a3142;padding:6px 10px;font-size:13px;margin:0}
.bar{height:10px;background:#2a3142;border-radius:6px;margin-top:12px;overflow:hidden}.bar div{height:100%;width:0;background:#4f7cff;transition:.3s}
pre{background:#0b0e13;padding:10px;border-radius:8px;max-height:220px;overflow:auto;font-size:12px;margin:10px 0 0}
table{width:100%;border-collapse:collapse;font-size:13px}td{padding:6px;border-bottom:1px solid #2a3142}
label{font-size:14px;display:block;margin-top:8px}small{color:#8b93a7}
</style></head><body><div class=wrap><h1>MAS GUI &mdash; Backup &amp; Restore</h1>

<div class=card><h2>1) Upload Backup</h2>
<small>One folder per line. Everything is packed and uploaded to GoFile, and the link is saved below.</small>
<textarea id=paths>__PATHS__</textarea>
<button onclick=backup()>Create backup &amp; upload to GoFile</button></div>

<div class=card><h2>2) Import Backup</h2>
<input type=text id=link placeholder="GoFile link (https://gofile.io/d/xxxxx)">
<input type=text id=target value="/" style="margin-top:8px" placeholder="Restore to (/ = same places as before)">
<label><input type=checkbox id=skip checked> Skip system files (network, fstab, hostname, SSH host keys) &mdash; keep ON when restoring to a different VPS</label>
<button onclick=restore()>Download &amp; restore</button></div>

<div class=card><h2>Progress</h2><div class=bar><div id=b></div></div><pre id=log>Idle.</pre></div>

<div class=card><h2>Saved backups</h2><table id=hist></table></div>

<div class=card><h2>GoFile account token (optional)</h2>
<small>Guest uploads can be deleted after inactivity. A free account token keeps files longer.</small>
<input type=text id=tok placeholder="paste token"><button class=s onclick=saveTok()>Save</button></div>
</div><script>
const j=(u,d)=>fetch(u,d?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)}:{}).then(r=>r.json());
let timer;
function watch(id){clearInterval(timer);timer=setInterval(async()=>{const s=await j('/api/job/'+id);
 b.style.width=s.pct+'%';log.textContent=s.log.join('\\n');log.scrollTop=1e9;
 if(s.status!='running'){clearInterval(timer);loadHist();}},1000)}
async function backup(){const r=await j('/api/backup',{paths:paths.value.split('\\n')});watch(r.id)}
async function restore(){if(!link.value)return alert('Paste a link');
 if(!confirm('This will overwrite files in '+target.value+'. Continue?'))return;
 const r=await j('/api/restore',{link:link.value,target:target.value,skip_system:skip.checked});watch(r.id)}
async function loadHist(){const h=await j('/api/history');
 hist.innerHTML=h.map(x=>`<tr><td>${x.date}<br><small>${x.host}</small></td><td><a style=color:#7aa2ff href="${x.link}" target=_blank>${x.link}</a></td>
 <td>${(x.size/1048576).toFixed(1)} MB</td><td><button class=s onclick="link.value='${x.link}'">Use</button></td></tr>`).join('')||'<tr><td>No backups yet</td></tr>'}
function saveTok(){j('/api/settings',{token:tok.value}).then(()=>alert('Saved'))}
loadHist();
</script></body></html>"""


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("--host", default="0.0.0.0")
    ap.add_argument("--port", type=int, default=8080)
    a = ap.parse_args()
    if os.geteuid() != 0:
        print("WARNING: not running as root - some files can't be read/restored.")
    print(f"\nMAS GUI on http://{a.host}:{a.port}   login: admin / {cfg['password']}\n")
    app.run(host=a.host, port=a.port, threaded=True)
PYEOF

echo "[4/5] Opening firewall port $PORT..."
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then ufw allow $PORT/tcp >/dev/null 2>&1 || true; fi
if command -v iptables >/dev/null 2>&1; then iptables -C INPUT -p tcp --dport $PORT -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport $PORT -j ACCEPT 2>/dev/null || true; fi

echo "[5/5] Starting MAS GUI..."
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
cat > /etc/systemd/system/masgui.service <<UNIT
[Unit]
Description=MAS GUI Backup
After=network.target

[Service]
ExecStart=$APP/venv/bin/python $APP/masgui.py --port $PORT
Restart=always
User=root

[Install]
WantedBy=multi-user.target
UNIT
  systemctl daemon-reload
  systemctl enable masgui >/dev/null 2>&1
  systemctl restart masgui
  sleep 3
  PASS=$(python3 -c "import json;print(json.load(open('/root/.masgui/config.json'))['password'])")
  IP=$(curl -s4 ifconfig.me || hostname -I | awk '{print $1}')
  echo
  echo "=============================================="
  echo " MAS GUI is running (auto-starts on reboot)"
  echo " URL:      http://$IP:$PORT"
  echo " Login:    admin"
  echo " Password: $PASS"
  echo "=============================================="
  echo " Open port $PORT in your firewall/panel if it doesn't load."
  echo " Stop:  systemctl stop masgui   |  Logs: journalctl -u masgui -f"
else
  echo "No systemd found, running in foreground (Ctrl+C to stop)..."
  exec "$APP/venv/bin/python" "$APP/masgui.py" --port $PORT
fi
