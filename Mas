MENU_VERSION="3.0"

# Where each Mas_<first5> toolkit is loaded from.
BASE_URL="${MAS_BASE_URL:-https://raw.githubusercontent.com/itzmasgaming/gui/main}"

# ---------------- COLORS (aqua theme) ----------------
AQUA='\033[1;96m'      # bright aqua - borders, numbers, prompt
AQUA2='\033[0;36m'     # soft aqua   - subtitles, commands
WHITE='\033[1;37m'
YELLOW='\033[1;93m'
RED='\033[1;91m'
GREEN='\033[1;92m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================
#  UI helpers
# ============================================================
pause() {
    echo
    read -rp "$(echo -e "${YELLOW}Press ENTER to return to the menu...${NC}")" _
}

# Boxed banner. Usage: banner "Subtitle"
banner() {
    clear
    local width=48 line text left right
    line=$(printf '\u2501%.0s' $(seq 1 "$width"))

    center() {
        text="$1"
        left=$(( (width - ${#text}) / 2 ))
        right=$(( width - ${#text} - left ))
        (( left < 0 )) && left=0
        (( right < 0 )) && right=0
        printf '%*s%s%*s' "$left" "" "$text" "$right" ""
    }

    echo -e "${AQUA}${BOLD}\u250f${line}\u2513${NC}"
    echo -e "${AQUA}${BOLD}\u2503${NC}$(center "")${AQUA}${BOLD}\u2503${NC}"
    echo -e "${AQUA}${BOLD}\u2503${NC}${WHITE}${BOLD}$(center "\u25c6 MAS GUI \u25c6")${NC}${AQUA}${BOLD}\u2503${NC}"
    echo -e "${AQUA}${BOLD}\u2503${NC}${AQUA2}$(center "${1:-Hosting Toolkit}")${NC}${AQUA}${BOLD}\u2503${NC}"
    echo -e "${AQUA}${BOLD}\u2503${NC}${WHITE}$(center "v${MENU_VERSION}")${NC}${AQUA}${BOLD}\u2503${NC}"
    echo -e "${AQUA}${BOLD}\u2503${NC}$(center "")${AQUA}${BOLD}\u2503${NC}"
    echo -e "${AQUA}${BOLD}\u2517${line}\u251b${NC}"
    echo
}

# One menu line. Usage: opt <key> <emoji+label>
opt() { echo -e "  \u276f ${AQUA}$1${NC} $2"; }

ask() { read -rp "$(echo -e "${AQUA}${BOLD}Select an option: ${NC}")" "$1"; }

invalid() { echo -e "\n${RED}Invalid option.${NC}"; sleep 1; }

# Generic menu. Usage: menu_loop "Subtitle" "info text (or empty)" "Label::function" ...
menu_loop() {
    local title="$1" info="$2"; shift 2
    local acts=("$@") i a c fn
    while true; do
        banner "$title"
        [ -n "$info" ] && echo -e "$info\n"
        i=1
        for a in "${acts[@]}"; do opt "$i" "${a%%::*}"; i=$((i+1)); done
        echo -e "  \u276f ${RED}0${NC} \u21a9\ufe0f  Back"
        echo
        ask c
        if [ "$c" = "0" ]; then return; fi
        if [[ "$c" =~ ^[0-9]+$ ]] && (( c >= 1 && c <= ${#acts[@]} )); then
            fn="${acts[$((c-1))]##*::}"
            "$fn"
        else
            invalid
        fi
    done
}

# ============================================================
#  Core helpers
# ============================================================
server_ip() { hostname -I 2>/dev/null | awk '{print $1}'; }

need_root() {
    if [ "${EUID:-$(id -u)}" -ne 0 ]; then
        echo -e "\n  ${RED}This needs root.${NC} Run ${WHITE}sudo -i${NC}, then start the menu again."
        pause; return 1
    fi
}

# ============================================================
#  Panel launcher
#  Prefers a local Mas_<first5> file next to this menu,
#  otherwise fetches it from BASE_URL.
# ============================================================
run_panel() {
    local file="$1" name="$2"
    echo
    echo -e "  ${YELLOW}\u23f3 Loading ${name} tools...${NC}"
    echo -e "  ${AQUA2}This may take a few moments while the toolkit is being decoded.${NC}"
    echo

    local self_dir
    self_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"

    if [ -n "$self_dir" ] && [ -f "$self_dir/$file" ]; then
        echo -e "  ${AQUA2}Using local file: $self_dir/$file${NC}"
        bash "$self_dir/$file" || { echo -e "\n  ${RED}Could not run $file.${NC}"; pause; }
    else
        echo -e "  ${AQUA2}Fetching: $BASE_URL/$file${NC}"
        bash <(curl -fsSL "$BASE_URL/$file" | tr -d '\r') || {
            echo -e "\n  ${RED}Could not load $file from the server.${NC}"
            pause
        }
    fi
}

# Thin wrappers so each menu entry is self-documenting.
