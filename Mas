prompt_admin_details() {
    echo ""
    echo -e "${RED}>>> Enter Panel admin account details (press ENTER to use default)${NC}"
    read -rp "$(echo -e ${YELLOW}"Let's Encrypt / Panel email [default: admin@gmail.com]: "${NC})" CFG_EMAIL
    read -rp "$(echo -e ${YELLOW}"Admin email [default: admin@admin.com]: "${NC})" CFG_ADMIN_EMAIL
    read -rp "$(echo -e ${YELLOW}"Admin username [default: admin]: "${NC})" CFG_ADMIN_USERNAME
    read -srp "$(echo -e ${YELLOW}"Admin password [default: 12345678]: "${NC})" CFG_ADMIN_PASSWORD
    echo ""

    CFG_EMAIL="${CFG_EMAIL:-admin@gmail.com}"
    CFG_ADMIN_EMAIL="${CFG_ADMIN_EMAIL:-admin@admin.com}"
    CFG_ADMIN_USERNAME="${CFG_ADMIN_USERNAME:-admin}"
