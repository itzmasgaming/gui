# ---------------- HELPERS ----------------
banner() {
    clear
    echo -e "$WATERMARK"

    # small tag top-left: "ɪᴛᴢᴍᴀꜱɢᴀᴍɪɴɢ"
    tag="ɪᴛᴢᴍᴀꜱɢᴀᴍɪɴɢ"
    echo -e "${BRED}${tag}${NC}"

    echo -e "${CYAN}${BOLD}============================================${NC}"
    echo -e "${BRED}${BOLD}                MAS Gui${NC}"
    echo -e "${CYAN}${BOLD}============================================${NC}"
    echo ""
}

pause() {
    echo ""
    read -rp "$(echo -e ${BYELLOW}"Press ENTER to return to the menu..."${NC})" _
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${BRED}This script must be run as root. Try: sudo bash $0${NC}"
        exit 1
    fi
}

# ============================================================
# CLOUDFLARE
# ============================================================
run_cloudflare_foreground() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        pause
        return
    fi
    echo ""
    read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi
    echo ""
    echo -e "${CYAN}>>> Running Cloudflare tunnel in terminal (foreground)...${NC}"
    echo -e "${YELLOW}>>> Press Ctrl+C to stop. Closing this terminal will stop the tunnel.${NC}"
    echo ""
    sleep 1
    cloudflared tunnel run --protocol http2 --token "$cf_token"
    pause
}

run_cloudflare_background() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        pause
        return
    fi
    echo ""
    read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi

    echo -e "${CYAN}>>> Creating cloudflared.service...${NC}"
    cat <<SERVICE_EOF > /etc/systemd/system/cloudflared.service
[Unit]
Description=Cloudflare Tunnel
After=network.target

[Service]
User=root
ExecStart=/usr/bin/cloudflared tunnel run --protocol http2 --token $cf_token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE_EOF

    systemctl daemon-reload
    systemctl enable --now cloudflared
    systemctl status cloudflared --no-pager

    echo ""
    echo -e "${CYAN}>>> Cloudflare tunnel running in background. Check logs anytime with:${NC}"
    echo -e "    ${YELLOW}journalctl -u cloudflared -f${NC}"
    pause
}

cloudflare_menu() {
    while true; do
        banner
        echo -e "${CYAN}${BOLD}--- Cloudflare ---${NC}"
        echo -e "  ${CYAN}1)${NC} Run in terminal (foreground)"
        echo -e "  ${CYAN}2)${NC} Run in background (systemd)"
        echo -e "  ${BRED}0)${NC} Exit"
        echo ""
        read -rp "$(echo -e ${CYAN}"Select an option: "${NC})" cf_choice

        case "$cf_choice" in
            1) run_cloudflare_foreground ;;
            2) run_cloudflare_background ;;
            0) return ;;
            *) echo -e "${BRED}Invalid option.${NC}"; sleep 1 ;;
        esac
    done
}

