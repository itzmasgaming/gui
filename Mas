    local detected_url=""
    if [ -f "$PTERODACTYL_DIR/.env" ]; then
        detected_url=$(grep -m1 '^APP_URL=' "$PTERODACTYL_DIR/.env" | cut -d'=' -f2- | tr -d '"' | tr -d "'")
    fi

    echo -e "${BCYAN}Detected Panel URL (used for the 'remote' / API callback address) from .env:${NC} ${YELLOW}${detected_url:-<none found>}${NC}"
    read -rp "$(echo -e ${YELLOW}"Press ENTER to use this, or type a different Panel URL: "${NC})" url_override
    local panel_url="${url_override:-$detected_url}"

    if [ -z "$panel_url" ]; then
        echo -e "${BRED}No Panel URL available (detected or entered). Aborting.${NC}"
        pause
        return
    fi

    echo ""
    read -rp "$(echo -e ${YELLOW}"Node link / FQDN (the address for this node, e.g. https://cold-rabbit-94.telebit.io): "${NC})" node_link
    node_link="${node_link:-$panel_url}"

    echo ""
    read -rp "$(echo -e ${YELLOW}"Daemon port (must match what you set in Cloudflare, e.g. 8443 or 443) [default: 8443]: "${NC})" node_port
    node_port="${node_port:-8443}"
