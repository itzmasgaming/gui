# ============================================================
# WINGS - install + docker + fix
# ============================================================
run_wings_install_docker_fix() {
    echo ""
    echo -e "${BGREEN}>>> Wings install + docker + fix - starting...${NC}"
    echo ""

    # --- Stop and purge any existing docker/containerd ---
    systemctl stop docker containerd 2>/dev/null
    apt-get purge -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker.io runc crun 2>/dev/null
    rm -rf /var/lib/docker /var/lib/containerd /etc/docker/daemon.json
    apt-mark unhold docker-ce docker-ce-cli containerd.io 2>/dev/null

    # --- Add Docker's official apt repo ---
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
    apt-get update

    # --- Initial daemon.json (vfs storage driver) ---
    mkdir -p /etc/docker
    cat <<'EOF' > /etc/docker/daemon.json
{
  "storage-driver": "vfs"
}
EOF

    # --- Install pinned safe versions ---
    SAFE_CONTAINERD=$(apt-cache madison containerd.io | grep -m 1 '1.6.' | awk '{print $3}')
    DOCKER_VER=$(apt-cache madison docker-ce | grep -m 1 '5:26.' | awk '{print $3}')
    CLI_VER=$(apt-cache madison docker-ce-cli | grep -m 1 '5:26.' | awk '{print $3}')
    apt-get install -y --allow-downgrades containerd.io="$SAFE_CONTAINERD" docker-ce="$DOCKER_VER" docker-ce-cli="$CLI_VER" docker-compose-plugin
    apt-mark hold containerd.io docker-ce docker-ce-cli

    systemctl enable --now containerd docker
    docker run hello-world

    # --- Final daemon.json (iptables + DNS) ---
    cat <<'EOF' > /etc/docker/daemon.json
{
  "storage-driver": "vfs",
  "iptables": true,
  "dns": [
    "1.1.1.1",
    "8.8.8.8"
  ]
}
EOF
    systemctl restart docker

    # --- Wings binary ---
    mkdir -p /etc/pterodactyl
    curl -L -o /usr/local/bin/wings "https://github.com/pterodactyl/wings/releases/latest/download/wings_linux_$([[ "$(uname -m)" == "x86_64" ]] && echo "amd64" || echo "arm64")"
    chmod u+x /usr/local/bin/wings

    # --- Self-signed cert ---
    mkdir -p /etc/certs && cd /etc/certs && openssl req -new -newkey rsa:4096 -days 3650 -nodes -x509 -subj "/C=NA/ST=NA/L=NA/O=NA/CN=Generic SSL Certificate" -keyout privkey.pem -out fullchain.pem

    # --- Docker network ---
    cd /etc/pterodactyl
    docker network create --driver=bridge pterodactyl0 2>/dev/null || true

    echo ""
    echo -e "${BGREEN}>>> Wings install + docker + fix complete.${NC}"
    pause
}

# ============================================================
# WINGS - config setup (config.yml generator)
# ============================================================
run_wings_config() {
    echo ""
    echo -e "${CYAN}>>> Wings Config Setup${NC}"
    echo "Get these values from your Panel: Admin -> Nodes -> your node -> Configuration tab"
    echo ""
    read -rp "$(echo -e ${YELLOW}"UUID: "${NC})" w_uuid
    read -rp "$(echo -e ${YELLOW}"Token ID: "${NC})" w_token_id
    read -rp "$(echo -e ${YELLOW}"Token: "${NC})" w_token
    read -rp "$(echo -e ${YELLOW}"Panel URL (remote link, e.g. https://cold-rabbit-94.telebit.io): "${NC})" w_remote

    if [ -z "$w_uuid" ] || [ -z "$w_token_id" ] || [ -z "$w_token" ] || [ -z "$w_remote" ]; then
        echo -e "${BRED}All four fields are required. Aborting.${NC}"
        pause
        return
    fi

    mkdir -p /etc/pterodactyl

    cat <<EOF > /etc/pterodactyl/config.yml
debug: false
uuid: $w_uuid
token_id: $w_token_id
token: $w_token
api:
  host: 0.0.0.0
  port: 8443
  ssl:
    enabled: true
    cert: /etc/certs/fullchain.pem
    key: /etc/certs/privkey.pem
  upload_limit: 100
system:
  data: /var/lib/pterodactyl/volumes
  sftp:
    bind_port: 2022
allowed_mounts: []
remote: '$w_remote'
docker:
  network:
    name: pterodactyl_nw
    interfaces:
      v4:
        subnet: 10.240.0.0/16
        gateway: 10.240.0.1
EOF

    echo ""
    echo -e "${BGREEN}>>> Config written to /etc/pterodactyl/config.yml${NC}"
    echo ""
    echo -e "${CYAN}>>> Creating wings.service (was missing - not auto-created by manual install)...${NC}"
    cat <<'SERVICE_EOF' > /etc/systemd/system/wings.service
[Unit]
Description=Pterodactyl Wings Daemon
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
User=root
WorkingDirectory=/etc/pterodactyl
LimitNOFILE=4096
PIDFile=/var/run/wings/daemon.pid
ExecStart=/usr/local/bin/wings
Restart=on-failure
StartLimitInterval=180
StartLimitBurst=30
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE_EOF

    systemctl daemon-reload

    echo ""
    echo -e "${BGREEN}>>> wings.service created. Go to Wings Setup -> Run Wings to start it.${NC}"
    pause
}

