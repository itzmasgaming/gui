run_wings_auto() {
    banner
    echo -e "${BCYAN}${BOLD}▸ Wings Auto (BETA)${NC}"
    echo -e "${BCYAN}────────────────────${NC}"
    echo ""
    echo -e "${BYELLOW}${BOLD}BETA:${NC} ${BYELLOW}this auto-creates a Node on the Panel found on this same${NC}"
