# ============================================================
# PANEL - user management (php artisan p:user:make / p:user:delete)
# ============================================================
require_panel_installed() {
    if [ ! -f "$PTERODACTYL_DIR/artisan" ]; then
        echo -e "${BRED}Pterodactyl Panel not found at ${PTERODACTYL_DIR}. Install it first.${NC}"
        pause
        return 1
    fi
    return 0
}

user_create() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}--- Create New User ---${NC}"
    echo ""
    read -rp "$(echo -e ${YELLOW}"Email: "${NC})" u_email
    read -rp "$(echo -e ${YELLOW}"Username: "${NC})" u_username
    read -rp "$(echo -e ${YELLOW}"First name: "${NC})" u_first
    read -rp "$(echo -e ${YELLOW}"Last name: "${NC})" u_last

    if [ -z "$u_email" ] || [ -z "$u_username" ] || [ -z "$u_first" ] || [ -z "$u_last" ]; then
        echo -e "${BRED}All fields are required. Aborting.${NC}"
        pause
        return
    fi

    read -rp "$(echo -e ${YELLOW}"Make this user an admin? (y/n): "${NC})" u_admin_ans
    local admin_flag="0"
    [[ "$u_admin_ans" =~ ^[Yy]$ ]] && admin_flag="1"

    echo ""
    echo -e "${YELLOW}Password: set one now, or leave the user without a password (Panel emails a set-password link, requires mail configured)?${NC}"
    read -rp "$(echo -e ${YELLOW}"Set password now? (y/n): "${NC})" u_setpass_ans

    cd "$PTERODACTYL_DIR" || return
    echo ""
    echo -e "${BCYAN}>>> Creating user...${NC}"
    if [[ "$u_setpass_ans" =~ ^[Yy]$ ]]; then
        read -srp "$(echo -e ${YELLOW}"Password: "${NC})" u_pass
        echo ""
        php artisan p:user:make --email="$u_email" --username="$u_username" --name-first="$u_first" --name-last="$u_last" --password="$u_pass" --admin="$admin_flag"
    else
        php artisan p:user:make --email="$u_email" --username="$u_username" --name-first="$u_first" --name-last="$u_last" --no-password --admin="$admin_flag"
    fi

    echo ""
    echo -e "${BGREEN}>>> User creation attempted - check output above for success/errors.${NC}"
    pause
}

user_delete() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}--- Delete User ---${NC}"
    echo ""
    read -rp "$(echo -e ${YELLOW}"Username / email / UUID of user to delete: "${NC})" u_target

    if [ -z "$u_target" ]; then
        echo -e "${BRED}A value is required. Aborting.${NC}"
        pause
        return
    fi

    confirm_destructive "User: $u_target" || return

    cd "$PTERODACTYL_DIR" || return
    php artisan p:user:delete --user="$u_target"

    echo ""
    echo -e "${BGREEN}>>> Delete attempted - check output above (a user with active servers cannot be deleted).${NC}"
    pause
}

# NOTE: Pterodactyl has no official "p:user:update" artisan command - only
# p:user:make (create) and p:user:delete exist. These two actions update the
# existing user record directly through Laravel's own Eloquent model via
# `artisan tinker`, which is the standard safe way to do this outside the
# admin web UI (passwords are still hashed by the framework, not stored raw).
user_toggle_admin() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}--- Toggle Admin Status ---${NC}"
    echo ""
    read -rp "$(echo -e ${YELLOW}"Username or email: "${NC})" u_target
    if [ -z "$u_target" ]; then
        echo -e "${BRED}A value is required. Aborting.${NC}"
        pause
        return
    fi

    cd "$PTERODACTYL_DIR" || return
    php artisan tinker --execute="\$u = \Pterodactyl\Models\User::where('email','$u_target')->orWhere('username','$u_target')->first(); if(\$u){ \$u->root_admin = !\$u->root_admin; \$u->save(); echo 'Admin status is now: '.(\$u->root_admin ? 'ADMIN' : 'NOT ADMIN'); } else { echo 'User not found'; }"

    echo ""
    pause
}

user_reset_password() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}--- Reset User Password ---${NC}"
    echo ""
    read -rp "$(echo -e ${YELLOW}"Username or email: "${NC})" u_target
    if [ -z "$u_target" ]; then
        echo -e "${BRED}A value is required. Aborting.${NC}"
        pause
        return
    fi
    read -srp "$(echo -e ${YELLOW}"New password: "${NC})" u_newpass
    echo ""
    if [ -z "$u_newpass" ]; then
        echo -e "${BRED}Password is required. Aborting.${NC}"
        pause
        return
    fi

    cd "$PTERODACTYL_DIR" || return
    php artisan tinker --execute="\$u = \Pterodactyl\Models\User::where('email','$u_target')->orWhere('username','$u_target')->first(); if(\$u){ \$u->password = Hash::make('$u_newpass'); \$u->save(); echo 'Password updated.'; } else { echo 'User not found'; }"

    echo ""
    pause
}

