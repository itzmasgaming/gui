# Injects/removes a single targeted CSS rule that hides the "pterodactyl.io"
# footer link + copyright text, tagged with a unique id so it can be found
# and cleanly removed again later (unlike a blind text-diff, this can't
# drift or double-inject). Only touches that one link/text - other footer
# content, buttons, etc. are left alone.
panel_copyright_toggle() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}▸ Panel Copyright / Footer Link${NC}"
    echo -e "${BCYAN}────────────────────────────────${NC}"
    echo ""
    cd "$PTERODACTYL_DIR" || { echo -e "${BRED}Path not found!${NC}"; pause; return; }

    local hidden_now=0
    grep -rl 'id="mas-copyright-hide"' resources/views/ >/dev/null 2>&1 && hidden_now=1

    if [ "$hidden_now" -eq 1 ]; then
        echo -e "${YELLOW}Currently: HIDDEN.${NC}"
        read -rp "$(echo -e ${YELLOW}"Restore the pterodactyl.io footer link/text? (y/n): "${NC})" ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            find resources/views/ -type f -name "*.blade.php" -exec sed -i '/id="mas-copyright-hide"/d' {} + 2>/dev/null
            php artisan view:clear
            php artisan cache:clear
            php artisan config:clear
            echo -e "${BGREEN}>>> Restored. Hard-refresh your browser to see it.${NC}"
        fi
    else
        echo -e "${YELLOW}Currently: SHOWN.${NC}"
        read -rp "$(echo -e ${YELLOW}"Hide the pterodactyl.io footer link/text? (y/n): "${NC})" ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            # Clean up any stray old copies first so re-running this never
            # injects the same rule twice.
            find resources/views/ -type f -name "*.blade.php" -exec sed -i '/id="mas-copyright-hide"/d' {} + 2>/dev/null
            find resources/views/ -type f -name "*.blade.php" -exec sed -i '/<\/head>/i\    <style id="mas-copyright-hide">p:has(a[href*="pterodactyl.io"]), font[size="1"], a[href*="pterodactyl.io"] { display: none !important; visibility: hidden !important; height: 0 !important; opacity: 0 !important; }</style>' {} + 2>/dev/null
            php artisan view:clear
            php artisan cache:clear
            php artisan config:clear
            echo -e "${BGREEN}>>> Hidden. Hard-refresh your browser to see it.${NC}"
        fi
    fi
    pause
}

