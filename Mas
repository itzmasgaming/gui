# Fixes "System locale encoding is not UTF-8" FATAL errors from Blueprint.
fix_locale() {
    if ! locale -a 2>/dev/null | grep -qi "en_US.utf8\|en_US.UTF-8"; then
        apt-get install -y locales >/dev/null 2>&1
        sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen 2>/dev/null
        grep -q "^en_US.UTF-8 UTF-8" /etc/locale.gen 2>/dev/null || echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
        locale-gen en_US.UTF-8 >/dev/null 2>&1
        update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 >/dev/null 2>&1
    fi
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
}

# Generates a random 6-char code and requires the user to type it back
# exactly before a destructive action proceeds. Returns 0 if confirmed.
confirm_destructive() {
    local label="$1"
    local code
    code=$(tr -dc 'A-Z0-9' </dev/urandom | head -c 6)
    echo ""
    echo -e "${BRED}${BOLD}!!! WARNING !!!${NC} This will uninstall: ${YELLOW}${label}${NC}"
    echo -e "${BRED}To confirm, type this exact code: ${YELLOW}${code}${NC}"
    read -rp "$(echo -e ${BCYAN}"Confirmation code: "${NC})" input_code
    if [ "$input_code" != "$code" ]; then
        echo -e "${BRED}Code did not match. Aborted.${NC}"
        sleep 2
        return 1
    fi
    return 0
}

# Runs a command, but kills it specifically if the LAST line it printed
# contains $pattern (e.g. "46", matching a "46%" progress line) AND that
# exact line hasn't changed for $timeout_secs seconds. Output that never
# shows the pattern, or that keeps changing, is left alone no matter how
# long it runs. Returns the command's exit code, or 124 if killed for
# being stuck.
run_with_stuck_watchdog() {
    local pattern="$1" timeout_secs="$2"; shift 2
    local out_file
    out_file=$(mktemp)

    # Run the real command, showing output live and also logging it so the
    # watchdog can inspect the last line.
    ("$@" 2>&1 | tee "$out_file") &
    local cmd_pid=$!

    (
        local prev_line="" stuck_secs=0
        while kill -0 "$cmd_pid" 2>/dev/null; do
            sleep 1
            local cur_line
            cur_line=$(tail -n1 "$out_file" 2>/dev/null)

            if [[ "$cur_line" == *"$pattern"* ]] && [ "$cur_line" = "$prev_line" ]; then
                stuck_secs=$(( stuck_secs + 1 ))
            else
                stuck_secs=0
            fi
            prev_line="$cur_line"

            if [ "$stuck_secs" -ge "$timeout_secs" ]; then
                echo -e "\n${BRED}>>> Stuck on '${pattern}' for ${timeout_secs}s - killing it...${NC}"
                kill -TERM "$cmd_pid" 2>/dev/null
                sleep 1
                kill -KILL "$cmd_pid" 2>/dev/null
                break
            fi
        done
    ) &
    local watchdog_pid=$!

    wait "$cmd_pid" 2>/dev/null
    local status=$?
    kill "$watchdog_pid" 2>/dev/null
    rm -f "$out_file"
    return $status
}

