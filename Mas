# A broken/half-installed extension can leave a core routes/*.php file with
# a PHP parse error - that's what shows up in the browser as a 500 page
# dumping raw route code. This is a snapshot of routes/ taken right after
# a clean Blueprint install, used to detect + auto-repair that.
ROUTES_BACKUP_DIR="/etc/pterodactyl-routes-backup"

# Snapshot routes/ as the "known good" baseline. Only ever taken once
# (right after Blueprint installs) so it doesn't overwrite a good backup
# with a state that might already be broken.
snapshot_routes_baseline() {
    if [ -d "$ROUTES_BACKUP_DIR" ] && [ -n "$(ls -A "$ROUTES_BACKUP_DIR" 2>/dev/null)" ]; then
        return
    fi
    mkdir -p "$ROUTES_BACKUP_DIR"
    cp -a "$PTERODACTYL_DIR/routes/." "$ROUTES_BACKUP_DIR/" 2>/dev/null
}

# Lints every routes/*.php file. Prints the path of any file with a syntax
# error, one per line. Empty output = all clean.
find_broken_route_files() {
    local f
    find "$PTERODACTYL_DIR/routes" -name '*.php' 2>/dev/null | while read -r f; do
        php -l "$f" >/dev/null 2>&1 || echo "$f"
    done
}

# After an extension install/removal, checks routes/*.php for syntax
# errors. If any are found, restores those specific files from the
# pristine baseline, uninstalls the extension that caused it (best
# effort), and re-runs the cache fix. Returns 0 if everything was clean,
# 1 if a repair was needed.
repair_broken_routes_if_needed() {
    local name="$1"
    local broken
    broken=$(find_broken_route_files)
    [ -z "$broken" ] && return 0

    echo ""
    echo -e "${BRED}${BOLD}!!! ${name} left a broken routes file (500 error cause) - repairing...${NC}"

    if [ ! -d "$ROUTES_BACKUP_DIR" ] || [ -z "$(ls -A "$ROUTES_BACKUP_DIR" 2>/dev/null)" ]; then
        echo -e "${BYELLOW}No pristine routes backup on disk yet - can't auto-restore. Run a Blueprint${NC}"
        echo -e "${BYELLOW}install once (option 6 -> 1) so future breaks like this can self-heal.${NC}"
        return 1
    fi

    local f rel
    echo "$broken" | while read -r f; do
        [ -z "$f" ] && continue
        rel="${f#$PTERODACTYL_DIR/routes/}"
        if [ -f "$ROUTES_BACKUP_DIR/$rel" ]; then
            cp -a "$ROUTES_BACKUP_DIR/$rel" "$f"
            echo -e "${BGREEN}>>> Restored: routes/${rel}${NC}"
        else
            echo -e "${BRED}>>> No backup for routes/${rel} - leaving as-is, may still 500.${NC}"
        fi
    done

    echo -e "${BYELLOW}>>> Removing the extension that caused it: ${name}${NC}"
    yes y | blueprint -r "$name" >/dev/null 2>&1

    blueprint_cache_fix
    return 1
}

# Official Pterodactyl repo - fallback source for a broken routes/*.php
# file when there's no local backup yet to restore from. Best-effort:
# gets you unbroken, not guaranteed to exactly match your installed
# Panel version.
PANEL_CORE_ROUTES_URL="https://raw.githubusercontent.com/pterodactyl/panel/develop/routes"

# Manual "fix my 500 error right now" command - checks every routes file,
# repairs from local backup if one exists, otherwise pulls a fresh copy
# from the official Pterodactyl repo. Safe to run any time; does nothing
# if nothing is broken.
repair_routes_now() {
    banner
    echo -e "${BCYAN}${BOLD}▸ Repair Routes${NC}"
    echo -e "${BCYAN}───────────────${NC}"
    echo ""
    echo -e "${BCYAN}>>> Checking routes/*.php for syntax errors...${NC}"

    local broken
    broken=$(find_broken_route_files)
    if [ -z "$broken" ]; then
        echo -e "${BGREEN}>>> Nothing broken - no 500-causing route files found.${NC}"
        snapshot_routes_baseline
        pause
        return
    fi

    local have_backup=1
    [ -d "$ROUTES_BACKUP_DIR" ] && [ -n "$(ls -A "$ROUTES_BACKUP_DIR" 2>/dev/null)" ] || have_backup=0

    local f rel restored=0
    while read -r f; do
        [ -z "$f" ] && continue
        rel="${f#$PTERODACTYL_DIR/routes/}"

        if [ "$have_backup" -eq 1 ] && [ -f "$ROUTES_BACKUP_DIR/$rel" ]; then
            cp -a "$ROUTES_BACKUP_DIR/$rel" "$f"
            echo -e "${BGREEN}>>> Restored from local backup: routes/${rel}${NC}"
            restored=1
        else
            echo -e "${BYELLOW}>>> No local backup for routes/${rel} - fetching a fresh copy from the official Pterodactyl repo...${NC}"
            if curl -fsSL -o "${f}.fresh" "${PANEL_CORE_ROUTES_URL}/${rel}" && php -l "${f}.fresh" >/dev/null 2>&1; then
                mv "${f}.fresh" "$f"
                echo -e "${BGREEN}>>> Replaced with upstream copy: routes/${rel}${NC}"
                restored=1
            else
                rm -f "${f}.fresh"
                echo -e "${BRED}>>> Could not fetch a working copy of routes/${rel} - leave this one to fix manually.${NC}"
            fi
        fi
    done <<< "$broken"

    if [ "$restored" -eq 1 ]; then
        blueprint_cache_fix
        snapshot_routes_baseline
        echo ""
        echo -e "${BGREEN}>>> Repair done. If a specific extension caused this, avoid reinstalling it.${NC}"
    fi
    pause
}

