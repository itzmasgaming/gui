# ---------------- UNINSTALL SYSTEM ----------------
detect_panel_env() {
    PANEL_DOMAIN=""
    PANEL_DB_NAME=""
    PANEL_DB_USER=""
    if [ -f "/var/www/pterodactyl/.env" ]; then
        PANEL_DOMAIN=$(grep -m1 '^APP_URL=' /var/www/pterodactyl/.env \vert{} cut -d'=' -f2- \vert{} tr -d '"' \vert{} tr -d "'" \vert{} sed -E 's#^https?://##; s#/$##')
        PANEL_DB_NAME=$(grep -m1 '^DB_DATABASE=' /var/www/pterodactyl/.env | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        PANEL_DB_USER=$(grep -m1 '^DB_USERNAME=' /var/www/pterodactyl/.env | cut -d'=' -f2- | tr -d '"' | tr -d "'")
    fi
}

cleanup_panel_residue() {
    if [ -n "$PANEL_DB_NAME" ]; then
        mysql -u root -e "DROP DATABASE IF EXISTS \`${PANEL_DB_NAME}\`;" 2>/dev/null
        [ -n "$PANEL_DB_USER" ] && mysql -u root -e "DROP USER IF EXISTS '${PANEL_DB_USER}'@'127.0.0.1'; DROP USER IF EXISTS '${PANEL_DB_USER}'@'localhost';" 2>/dev/null
    fi
    if [ -n "$PANEL_DOMAIN" ] && command -v certbot >/dev/null 2>&1; then
        certbot delete --cert-name "$PANEL_DOMAIN" --non-interactive 2>/dev/null
    fi
    rm -f /etc/php/*/fpm/pool.d/pteroq.conf 2>/dev/null
    systemctl restart php*-fpm 2>/dev/null
    systemctl restart nginx 2>/dev/null
}

uninstall_pterodactyl_panel() {
    confirm_destructive "Pterodactyl Panel (files, nginx site, queue worker, database, SSL cert)" || return
    echo -e "${BCYAN}>>> Uninstalling Pterodactyl Panel...${NC}"
    detect_panel_env
    systemctl stop pteroq 2>/dev/null
    systemctl disable pteroq 2>/dev/null
    rm -f /etc/systemd/system/pteroq.service
    rm -f /etc/nginx/sites-enabled/pterodactyl.conf /etc/nginx/sites-available/pterodactyl.conf
    systemctl reload nginx 2>/dev/null
    (crontab -l 2>/dev/null | grep -v "pterodactyl" | crontab -) 2>/dev/null
    rm -rf /var/www/pterodactyl /app
    cleanup_panel_residue
    systemctl daemon-reload
    echo -e "${BGREEN}>>> Pterodactyl Panel uninstalled.${NC}"
    sleep 2
}

uninstall_wings_docker() {
    confirm_destructive "Wings + Docker (binary, config, service, docker itself)" || return
    echo -e "${BCYAN}>>> Uninstalling Wings + Docker...${NC}"
    systemctl stop wings 2>/dev/null
    systemctl disable wings 2>/dev/null
    rm -f /etc/systemd/system/wings.service /usr/local/bin/wings
    rm -rf /etc/pterodactyl /etc/certs

    systemctl stop docker containerd 2>/dev/null
    apt-get purge -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker.io runc crun 2>/dev/null
    rm -rf /var/lib/docker /var/lib/containerd /etc/docker
    systemctl daemon-reload
    echo -e "${BGREEN}>>> Wings + Docker uninstalled.${NC}"
    sleep 2
}

uninstall_cloudflare() {
    confirm_destructive "Cloudflare tunnel (cloudflared binary + service)" || return
    echo -e "${BCYAN}>>> Uninstalling Cloudflare tunnel...${NC}"
    systemctl stop cloudflared 2>/dev/null
    systemctl disable cloudflared 2>/dev/null
    rm -f /etc/systemd/system/cloudflared.service /usr/local/bin/cloudflared /usr/bin/cloudflared
    systemctl daemon-reload
    echo -e "${BGREEN}>>> Cloudflare uninstalled.${NC}"
    sleep 2
}

uninstall_everything() {
    confirm_destructive "EVERYTHING (Panel, Wings, Docker, Cloudflare)" || return
    echo -e "${BCYAN}>>> Uninstalling EVERYTHING...${NC}"
    detect_panel_env
    systemctl stop pteroq wings cloudflared docker containerd 2>/dev/null
    systemctl disable pteroq wings cloudflared 2>/dev/null
    rm -f /etc/systemd/system/pteroq.service /etc/systemd/system/wings.service /etc/systemd/system/cloudflared.service
    rm -f /usr/local/bin/wings /usr/local/bin/cloudflared /usr/bin/cloudflared
    rm -rf /etc/pterodactyl /etc/certs /var/www/pterodactyl /app
    rm -f /etc/nginx/sites-enabled/pterodactyl.conf /etc/nginx/sites-available/pterodactyl.conf
    systemctl reload nginx 2>/dev/null
    apt-get purge -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker.io runc crun 2>/dev/null
    rm -rf /var/lib/docker /var/lib/containerd /etc/docker
    cleanup_panel_residue
    systemctl daemon-reload
    echo -e "${BGREEN}>>> Uninstall complete.${NC}"
    sleep 2
}

uninstall_menu() {
    while true; do
        banner
        echo -e "${BRED}${BOLD}▸ Uninstall Menu${NC}"
        echo -e "  ❯ ${BCYAN}1${NC} Uninstall Pterodactyl Panel"
        echo -e "  ❯ ${BCYAN}2${NC} Uninstall Wings + Docker"
        echo -e "  ❯ ${BCYAN}3${NC} Uninstall Cloudflare"
