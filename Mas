# ============================================================
# UNINSTALL
# (c) ItzMASGaming - unauthorized copies/reuploads of this script violate copyright.
# ============================================================
# Reads APP_URL / DB_DATABASE / DB_USERNAME out of the panel's .env before
# it gets deleted, so uninstall can clean up the things a plain `rm -rf`
# leaves behind (the DB, the Let's Encrypt cert). Sets PANEL_DOMAIN,
# PANEL_DB_NAME, PANEL_DB_USER (empty if not found / no .env).
detect_panel_env() {
    PANEL_DOMAIN=""
    PANEL_DB_NAME=""
    PANEL_DB_USER=""
    if [ -f "/var/www/pterodactyl/.env" ]; then
        PANEL_DOMAIN=$(grep -m1 '^APP_URL=' /var/www/pterodactyl/.env | cut -d'=' -f2- | tr -d '"' | tr -d "'" | sed -E 's#^https?://##; s#/$##')
        PANEL_DB_NAME=$(grep -m1 '^DB_DATABASE=' /var/www/pterodactyl/.env | cut -d'=' -f2- | tr -d '"' | tr -d "'")
        PANEL_DB_USER=$(grep -m1 '^DB_USERNAME=' /var/www/pterodactyl/.env | cut -d'=' -f2- | tr -d '"' | tr -d "'")
    fi
}

# Drops the panel's database/user (best-effort, ignores errors if mysql
# isn't reachable or nothing to drop) and removes its Let's Encrypt cert
# so a later fresh install doesn't collide with leftover state - a very
# common cause of "install worked before, now it's a 502" after a
# reinstall, since Cloudflare's tunnel itself connects fine but the
# origin (nginx/php-fpm) has nothing valid to serve.
cleanup_panel_residue() {
    if [ -n "$PANEL_DB_NAME" ]; then
        echo -e "${BCYAN}>>> Dropping leftover database '${PANEL_DB_NAME}'...${NC}"
        mysql -u root -e "DROP DATABASE IF EXISTS \`${PANEL_DB_NAME}\`;" 2>/dev/null
        [ -n "$PANEL_DB_USER" ] && mysql -u root -e "DROP USER IF EXISTS '${PANEL_DB_USER}'@'127.0.0.1'; DROP USER IF EXISTS '${PANEL_DB_USER}'@'localhost';" 2>/dev/null
    fi
    if [ -n "$PANEL_DOMAIN" ] && command -v certbot >/dev/null 2>&1; then
        echo -e "${BCYAN}>>> Removing Let's Encrypt cert for ${PANEL_DOMAIN}...${NC}"
        certbot delete --cert-name "$PANEL_DOMAIN" --non-interactive 2>/dev/null
    fi
    # Stale php-fpm pool for the old panel (name varies by PHP version/installer)
    rm -f /etc/php/*/fpm/pool.d/pteroq.conf 2>/dev/null
    systemctl restart php*-fpm 2>/dev/null
    systemctl restart nginx 2>/dev/null
}

uninstall_pterodactyl_panel() {
    confirm_destructive "Pterodactyl Panel (files, nginx site, queue worker, database, SSL cert)" || return
    echo -e "${BCYAN}>>> Uninstalling Pterodactyl Panel...${NC}"
    detect_panel_env
    systemctl stop pteroq 2>/dev/null
    systemctl disable pteroq 2>/dev/null
    rm -f /etc/systemd/system/pteroq.service
    rm -f /etc/nginx/sites-enabled/pterodactyl.conf /etc/nginx/sites-available/pterodactyl.conf
    systemctl reload nginx 2>/dev/null
    (crontab -l 2>/dev/null | grep -v "pterodactyl" | crontab -) 2>/dev/null
    rm -rf /var/www/pterodactyl
    rm -f /app
    cleanup_panel_residue
    systemctl daemon-reload
    echo -e "${BGREEN}>>> Pterodactyl Panel uninstalled (database + SSL cert cleaned up too).${NC}"
    sleep 2
}

