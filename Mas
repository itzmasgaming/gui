        echo -e "  ${RED}4)${NC} Exit"
        echo ""
        read -rp "$(echo -e ${RED}"Select an option: "${NC})" wings_choice

        case "$wings_choice" in
            1) run_wings_install_docker_fix ;;
            2) run_wings_config ;;
            3) run_wings_menu ;;
            4) return ;;
            *) echo -e "${BRED}Invalid option.${NC}"; sleep 1 ;;
        esac
    done
}

