    echo -e "  ${BCYAN}2)${NC} Cloudflare"
    echo -e "  ${BCYAN}3)${NC} Pterodactyl Panel Setup"
    echo -e "  ${BCYAN}4)${NC} Wings Setup"
    echo -e "  ${BCYAN}5)${NC} System Spec"
    echo -e "  ${BCYAN}6)${NC} Blueprint + Themes (Fixed)"
    echo -e "  ${BCYAN}7)${NC} Installed Apps"
    echo -e "  ${BCYAN}8)${NC} Credits"
    echo -e "  ${BCYAN}9)${NC} Uninstall"
    echo -e "  ${BRED}0)${NC} Exit"
    echo ""
    read -rp "$(echo -e ${BCYAN}${BOLD}"Select an option: "${NC})" choice

    case "$choice" in
        1) run_system_update ;;
        2) cloudflare_menu ;;
        3) panel_setup_menu ;;
        4) wings_setup_menu ;;
        5) run_system_spec ;;
        6) blueprint_menu ;;
        7) run_installed_apps ;;
        8) show_credits ;;
        9) uninstall_menu ;;
        0) exit 0 ;;
        *) echo -e "${BRED}Invalid option.${NC}"; sleep 1 ;;
    esac
}

check_root
fix_locale
while true; do
    show_menu
done
