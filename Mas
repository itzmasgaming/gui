#!/bin/bash
_p="x
" #
case "$_p" in *$'\r'*) _c=$(curl -fsSL "${MAS_SELF_URL:-https://itzmasgaming.github.io/gui/Mas}" | tr -d '\r'); [ -n "$_c" ] && exec bash -c "$_c" mas "$@"; echo "Windows line endings (CRLF) detected and the clean reload failed. Save the file with LF endings."; exit 1 ;; esac #
# NOTE: the 3 lines above are an auto-fix for CRLF (Windows) line endings. Keep them as the first lines.
# ============================================================
#  Main Menu (front layer)  ->  Hosting Setup / Coming Soon / Exit
#  This wrapper does NOT contain or modify the MAS GUI script.
#  It only launches it, exactly as published, when you pick Pterodactyl.
# ============================================================

# Where the existing MAS GUI (Pterodactyl) script is loaded from
PTERO_URL="https://raw.githubusercontent.com/itzmasgaming/gui/main/Mas_Ptero"

RED='\033[0;31m'; BRED='\033[1;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

pause() { echo; read -rp "  Press Enter to continue..." _; }

header() {
    clear
    echo -e "${CYAN}============================================${NC}"
    echo -e "${BOLD}   $1${NC}"
    echo -e "${CYAN}============================================${NC}"
    echo
}

invalid() { echo -e "\n  ${RED}Invalid option.${NC}"; sleep 1; }

# ------------------------------------------------------------
#  Panel launchers
# ------------------------------------------------------------
run_pterodactyl() {
    # Runs the existing MAS GUI as a separate process; when it exits
    # you land back in this menu.
    echo
    echo -e "  ${YELLOW}⏳ Loading Pterodactyl tools...${NC}"
    echo -e "  ${CYAN}This may take a few moments while the script is being decoded.${NC}"
    echo
    bash <(curl -fsSL "$PTERO_URL" | tr -d '\r') || {
        echo -e "\n  ${RED}Could not load the Pterodactyl script.${NC}"
        pause
    }
}

# Template for adding another panel. Copy this, rename it, and fill in
# the real actions for that panel (install, update, uninstall, etc.).
panel_template() {
    local name="$1"
    header "$name"
    echo -e "  ${YELLOW}$name tools are not wired up yet.${NC}"
    pause
}

run_pelican()   { panel_template "Pelican Panel"; }
run_jexactyl()  { panel_template "Jexactyl"; }
run_reviactyl() { panel_template "Reviactyl"; }
run_convoy()    { panel_template "Convoy"; }
run_ctrlpanel() { panel_template "CtrlPanel (billing)"; }

# ------------------------------------------------------------
#  Menus
# ------------------------------------------------------------
hosting_menu() {
    while true; do
        header "Hosting Setup - Choose a Panel"
        echo -e "  ❯ ${BRED}1${NC} Pterodactyl"
        echo -e "  ❯ ${BRED}2${NC} Pelican Panel      ${YELLOW}(soon)${NC}"
        echo -e "  ❯ ${BRED}3${NC} Jexactyl           ${YELLOW}(soon)${NC}"
        echo -e "  ❯ ${BRED}4${NC} Reviactyl          ${YELLOW}(soon)${NC}"
        echo -e "  ❯ ${BRED}5${NC} Convoy             ${YELLOW}(soon)${NC}"
        echo -e "  ❯ ${BRED}6${NC} CtrlPanel          ${YELLOW}(soon)${NC}"
        echo -e "  ❯ ${BRED}0${NC} Back"
        echo
        read -rp "  Select an option: " c
        case "$c" in
            1) run_pterodactyl ;;
            2) run_pelican ;;
            3) run_jexactyl ;;
            4) run_reviactyl ;;
            5) run_convoy ;;
            6) run_ctrlpanel ;;
            0) return ;;
            *) invalid ;;
        esac
    done
}

coming_soon() {
    header "Coming Soon"
    echo -e "  ${YELLOW}New tools are on the way. Stay tuned!${NC}"
    pause
}

main_menu() {
    while true; do
        header "MAS GUI - Main Menu"
        echo -e "  ❯ ${BRED}1${NC} Hosting Setup"
        echo -e "  ❯ ${BRED}2${NC} Coming Soon"
        echo -e "  ❯ ${BRED}0${NC} Exit"
        echo
        read -rp "  Select an option: " c
        case "$c" in
            1) hosting_menu ;;
            2) coming_soon ;;
            0) echo -e "\n  ${GREEN}Goodbye!${NC}\n"; exit 0 ;;
            *) invalid ;;
        esac
    done
}

main_menu
