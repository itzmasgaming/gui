mkdir -p "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/db"
mkdir -p "${PTERODACTYL_DIR}/.blueprint/tmp"

if [ ! -f "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/extensionfs.php" ]; then
    echo '<?php return [];' > "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/extensionfs.php"
fi

touch "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/db/installed_extensions"
touch "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/db/version"

echo -e "\e[34m[4/8] Aligning system symlinks...\e[0m"
ln -sf "${PTERODACTYL_DIR}" /app

echo -e "\e[34m[5/8] Running database migrations & bringing panel live...\e[0m"
cd "${PTERODACTYL_DIR}"
php artisan down || true
