#  MAS Gui - Pterodactyl Panel + Wings installer/manager
#  Run with: bash <(curl -s https://raw.githubusercontent.com/<you>/<repo>/main/mas-gui.sh)
# ============================================================

# ---------------- COLORS (bright variants) ----------------
RED='\033[0;31m'
BRED='\033[1;91m'
GREEN='\033[0;32m'
BGREEN='\033[1;92m'
YELLOW='\033[1;33m'
BYELLOW='\033[1;93m'
BLUE='\033[0;34m'
BBLUE='\033[1;94m'
CYAN='\033[0;36m'
BCYAN='\033[1;96m'
MAGENTA='\033[0;35m'
BMAGENTA='\033[1;95m'
BOLD='\033[1m'
HIDDEN='\033[8m'   # conceal - text present in output, invisible in most terminals
NC='\033[0m' # No Color

# Hidden watermark (present in every run's output, invisible unless selected/copied)
# Also hidden in source: stored base64-encoded, decoded at runtime.
_WM_B64="U3ViIEl0ek1BU0dhbWluZw=="
WATERMARK="${HIDDEN}$(echo "$_WM_B64" | base64 -d 2>/dev/null)${NC}"

# ============ CONFIG - EDIT THESE ============
# ---- Panel config ----
CFG_TIMEZONE="Asia/Kolkata"
CFG_EMAIL=""                              # LE / panel email - prompted at runtime
CFG_ADMIN_FIRSTNAME="Admin"
CFG_ADMIN_LASTNAME="User"
CFG_FQDN="cold-rabbit-94.telebit.io"

CFG_DB_NAME=""
CFG_DB_USER=""
CFG_DB_PASS=""
CFG_UFW="n"
CFG_LETSENCRYPT="y"
CFG_AGREE_HTTPS="y"
CFG_PROCEED_ANYWAY="y"
CFG_TELEMETRY="yes"
CFG_CONTINUE_INSTALL="y"
CFG_AGREE_TOS="y"
CFG_ASSUME_SSL="y"

PANEL_INSTALLER_URL="https://pterodactyl-installer.se/"
# ===============================================

# ---------------- HELPERS ----------------
banner() {
    clear
    echo -e "$WATERMARK"

    # small tag top-left: "ɪᴛᴢᴍᴀꜱɢᴀᴍɪɴɢ"
    tag="ɪᴛᴢᴍᴀꜱɢᴀᴍɪɴɢ"
    echo -e "${BRED}${tag}${NC}"

    echo -e "${RED}${BOLD}"
    echo "============================================"
    echo "                MAS Gui"
    echo "============================================"
    echo -e "${NC}"
}

pause() {
    echo ""
    read -rp "$(echo -e ${BYELLOW}"Press ENTER to return to the menu..."${NC})" _
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${BRED}This script must be run as root. Try: sudo bash $0${NC}"
        exit 1
    fi
}

