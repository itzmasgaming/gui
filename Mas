coming_soon() {
    banner "Coming Soon"
    echo -e "  ${YELLOW}\ud83d\udea7 New tools are on the way. Stay tuned!${NC}"
    pause
}

main_menu() {
    local c
    while true; do
        banner "Main Menu"
        opt 1 "\ud83d\udda5\ufe0f  Hosting Setup"
        opt 2 "\ud83d\udea7  Coming Soon"
        echo -e "  \u276f ${RED}0${NC} \u2716\ufe0f  Exit"
        echo
        ask c
        case "$c" in
            1) hosting_menu ;;
            2) coming_soon ;;
            0) echo -e "\n${GREEN}Goodbye!${NC}\n"; exit 0 ;;
            *) invalid ;;
        esac
    done
}

[ -z "$MAS_NO_RUN" ] && main_menu
