# ============================================================
# SYSTEM SPEC
# ============================================================
run_system_spec() {
    banner
    echo -e "${BRED}${BOLD}--- System Spec ---${NC}"
    echo ""

    # ---- CPU model ----
    cpu_model=$(grep -m1 "model name" /proc/cpuinfo | cut -d':' -f2 | sed 's/^ *//')
    [ -z "$cpu_model" ] && cpu_model="Unknown"

    # ---- Allowed core/thread range (container-aware) ----
    # Prefers cgroup v2, falls back to v1, falls back to /proc/self/status
    if [ -f /sys/fs/cgroup/cpuset.cpus.effective ]; then
        core_range=$(cat /sys/fs/cgroup/cpuset.cpus.effective)
    elif [ -f /sys/fs/cgroup/cpuset/cpuset.cpus ]; then
        core_range=$(cat /sys/fs/cgroup/cpuset/cpuset.cpus)
    else
        core_range=$(grep "Cpus_allowed_list" /proc/self/status | awk '{print $2}')
    fi
    [ -z "$core_range" ] && core_range="Unknown"

    thread_count=$(nproc)

    # ---- RAM (decimal GB, not GiB) ----
    mem_total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    mem_avail_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    mem_total_gb=$(awk "BEGIN {printf \"%.0f\", $mem_total_kb*1024/1000000000}")
    mem_avail_gb=$(awk "BEGIN {printf \"%.0f\", $mem_avail_kb*1024/1000000000}")
    mem_used_gb=$(awk "BEGIN {printf \"%.0f\", $mem_total_gb-$mem_avail_gb}")

    # ---- Storage (decimal GB, root filesystem) ----
    read -r _ total_b used_b avail_b _ < <(df -B1 / | tail -1)
    storage_total_gb=$(awk "BEGIN {printf \"%.0f\", $total_b/1000000000}")
    storage_used_gb=$(awk "BEGIN {printf \"%.0f\", $used_b/1000000000}")
    storage_avail_gb=$(awk "BEGIN {printf \"%.0f\", $avail_b/1000000000}")

    # ---- GPU ----
    if command -v nvidia-smi >/dev/null 2>&1; then
        gpu_info=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)
        [ -z "$gpu_info" ] && gpu_info="NVIDIA tools present but no GPU detected"
    else
        gpu_info="No GPU detected / nvidia-smi not installed"
    fi

    # ---- Runtime / uptime ----
    if command -v uptime >/dev/null 2>&1; then
        runtime_info=$(uptime -p 2>/dev/null)
    fi
    if [ -z "$runtime_info" ]; then
        up_seconds=$(awk '{print int($1)}' /proc/uptime)
        runtime_info="${up_seconds}s"
    fi

    echo -e "${CYAN}CPU Model:${NC}        $cpu_model"
    echo -e "${CYAN}Cores/Threads:${NC}    $thread_count"
    echo -e "${CYAN}Core/Thread Range:${NC} $core_range  ${YELLOW}(as allowed by Docker cgroup)${NC}"
    echo ""
    echo -e "${CYAN}RAM Total:${NC}        ${mem_total_gb} GB"
    echo -e "${CYAN}RAM Used:${NC}         ${mem_used_gb} GB"
    echo -e "${CYAN}RAM Available:${NC}    ${mem_avail_gb} GB"
    echo ""
    echo -e "${CYAN}Storage Total:${NC}    ${storage_total_gb} GB"
    echo -e "${CYAN}Storage Used:${NC}     ${storage_used_gb} GB"
    echo -e "${CYAN}Storage Available:${NC} ${storage_avail_gb} GB"
    echo ""
    echo -e "${CYAN}GPU:${NC}              $gpu_info"
    echo ""
    echo -e "${CYAN}Uptime:${NC}           $runtime_info"

    pause
}

# ============================================================
# BLUEPRINT
# ============================================================
run_blueprint_install() {
    banner
    echo -e "${CYAN}${BOLD}--- Blueprint Install ---${NC}"
    echo ""

    echo -e "${CYAN}>>> Running system update first (per script requirement)...${NC}"
    apt update
    apt upgrade -y

    export PTERODACTYL_DIRECTORY=/var/www/pterodactyl

    echo -e "${CYAN}>>> Installing curl wget unzip...${NC}"
    apt install -y curl wget unzip

    cd "$PTERODACTYL_DIRECTORY"

    echo -e "${CYAN}>>> Downloading Blueprint release...${NC}"
    wget "https://github.com/BlueprintFramework/framework/releases/latest/download/release.zip" -O "$PTERODACTYL_DIRECTORY/release.zip"
    unzip -o release.zip

    echo -e "${CYAN}>>> Installing base packages...${NC}"
    apt install -y ca-certificates curl git gnupg unzip wget zip

    echo -e "${CYAN}>>> Setting up NodeSource repo + Node 22...${NC}"
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list
    apt update
    apt install -y nodejs

    cd "$PTERODACTYL_DIRECTORY"
    echo -e "${CYAN}>>> Installing yarn + running yarn install...${NC}"
    npm i -g yarn
    yarn install

    touch "$PTERODACTYL_DIRECTORY/.blueprintrc"
    echo \
'WEBUSER="www-data";
OWNERSHIP="www-data:www-data";
USERSHELL="/bin/bash";' > "$PTERODACTYL_DIRECTORY/.blueprintrc"

    echo -e "${CYAN}>>> Writing and running master_fix.sh (as-is, no changes)...${NC}"

    # --- Rule 10 does not apply below: dropped in exactly as provided ---
    cat << 'EOF' > /var/www/pterodactyl/master_fix.sh
#!/bin/bash
# ==============================================================================
# PTERODACTYL & BLUEPRINT MASTER REPAIR SCRIPT
# ==============================================================================

set -e

PTERODACTYL_DIR="/var/www/pterodactyl"

echo -e "\e[34m[1/8] Setting UTF-8 Environment Locales...\e[0m"
export LC_ALL=C.UTF-8
export LANG=C.UTF-8

echo -e "\e[34m[2/8] Cleaning up Blueprint locks and stray files...\e[0m"
rm -f "${PTERODACTYL_DIR}/.blueprint/lock"
rm -f "${PTERODACTYL_DIR}/.blueprint/tmp"* -rf
rm -f "${PTERODACTYL_DIR}/^C"
rm -f "${PTERODACTYL_DIR}/nebula.blueprint"

echo -e "\e[34m[3/8] Restoring Blueprint tracking structure...\e[0m"
mkdir -p "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/db"
mkdir -p "${PTERODACTYL_DIR}/.blueprint/tmp"

if [ ! -f "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/extensionfs.php" ]; then
    echo '<?php return [];' > "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/extensionfs.php"
fi

touch "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/db/installed_extensions"
touch "${PTERODACTYL_DIR}/.blueprint/extensions/blueprint/private/db/version"

echo -e "\e[34m[4/8] Aligning system symlinks...\e[0m"
ln -sf "${PTERODACTYL_DIR}" /app

echo -e "\e[34m[5/8] Running database migrations & bringing panel live...\e[0m"
cd "${PTERODACTYL_DIR}"
php artisan down || true
php artisan migrate --step --force
php artisan up

echo -e "\e[34m[6/8] Compiling frontend assets with legacy OpenSSL engine...\e[0m"
export NODE_OPTIONS=--openssl-legacy-provider
yarn build:production

echo -e "\e[34m[7/8] Flushing application caches...\e[0m"
php artisan optimize:clear
php artisan config:clear
php artisan view:clear
php artisan route:clear

echo -e "\e[34m[8/8] Re-applying file permissions...\e[0m"
chown -R www-data:www-data "${PTERODACTYL_DIR}"
chmod -R 755 "${PTERODACTYL_DIR}/storage" "${PTERODACTYL_DIR}/bootstrap/cache"

echo -e "\e[32m========================================================\e[0m"
echo -e "\e[32m SUCCESS: System repaired, compiled, and ready for use! \e[0m"
echo -e "\e[32m========================================================\e[0m"
EOF

    chmod +x /var/www/pterodactyl/master_fix.sh
    /var/www/pterodactyl/master_fix.sh

    echo ""
    echo -e "${CYAN}>>> Running Blueprint's official installer (registers extension in DB)...${NC}"
    export NODE_OPTIONS=--openssl-legacy-provider

    # Pre-create debug log path so blueprint.sh doesn't spam "No such file" errors
    mkdir -p /var/www/pterodactyl/.blueprint/extensions/blueprint/private/debug
    touch /var/www/pterodactyl/.blueprint/extensions/blueprint/private/debug/logs.txt

    chmod +x /var/www/pterodactyl/blueprint.sh
    # Auto-answer the "put into maintenance mode?" prompt with y
    echo "y" | /var/www/pterodactyl/blueprint.sh

    echo ""
    echo -e "${CYAN}>>> Fixing blueprint CLI shortcut permissions...${NC}"
    chmod +x /usr/local/bin/blueprint 2>/dev/null

    echo -e "${CYAN}>>> Running blueprint -upgrade...${NC}"
    blueprint -upgrade

    echo ""
    echo -e "${CYAN}>>> Blueprint install + repair complete.${NC}"
    pause
}

