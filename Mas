        echo -e "${BRED}Memory must be a whole number of at least 1 (MB). Aborting.${NC}"
        pause
        return
    fi
    if ! [[ "$node_disk" =~ ^[0-9]+$ ]] || [ "$node_disk" -lt 1 ]; then
        echo -e "${BRED}Disk must be a whole number of at least 1 (MB). Aborting.${NC}"
        pause
        return
    fi
    if ! [[ "$node_memory_overallocate" =~ ^-?[0-9]+$ ]]; then
        echo -e "${BRED}Memory overallocate must be a whole number (or -1). Aborting.${NC}"
        pause
        return
    fi
    if ! [[ "$node_disk_overallocate" =~ ^-?[0-9]+$ ]]; then
        echo -e "${BRED}Disk overallocate must be a whole number (or -1). Aborting.${NC}"
        pause
        return
    fi

    if [ ! -f /usr/local/bin/wings ]; then
        echo ""
        echo -e "${BCYAN}>>> Wings binary not found - running install + docker + fix first...${NC}"
        run_wings_install_docker_fix
    fi

    echo ""
    echo -e "${BCYAN}>>> Creating a Node on the local Panel via internal service...${NC}"

    cd "$PTERODACTYL_DIR" || { echo -e "${BRED}Path not found!${NC}"; pause; return; }

    local node_name="AutoWingsNode-$(date +%s)"
    local tinker_output
    tinker_output=$(php artisan tinker --execute="
\$location = \Pterodactyl\Models\Location::first();
if (!\$location) {
    \$location = \Pterodactyl\Models\Location::create(['short' => 'auto', 'long' => 'Auto-created location']);
}
\$service = app(\Pterodactyl\Services\Nodes\NodeCreationService::class);
\$node = \$service->handle([
    'name' => '$node_name',
    'location_id' => \$location->id,
    'fqdn' => '$node_link',
    'scheme' => 'https',
    'memory' => $node_memory,
    'memory_overallocate' => $node_memory_overallocate,
    'disk' => $node_disk,
    'disk_overallocate' => $node_disk_overallocate,
    'upload_size' => 100,
    'daemonListen' => $node_port,
    'daemonSFTP' => 2022,
    'daemonBase' => '/var/lib/pterodactyl/volumes',
    'behind_proxy' => false,
    'maintenance_mode' => false,
]);
try {
    \$plainToken = \Illuminate\Support\Facades\Crypt::decryptString(\$node->daemon_token);
} catch (\Exception \$e) {
    \$plainToken = \$node->daemon_token;
}
echo 'AUTONODE_RESULT:'.\$node->uuid.'|'.\$node->daemon_token_id.'|'.\$plainToken.'|'.\$node->fqdn;
" 2>&1)

    local result_line
    result_line=$(echo "$tinker_output" | grep "AUTONODE_RESULT:" | tail -n1)

    if [ -z "$result_line" ]; then
