    echo -e "${BYELLOW}here fails, fall back to 'Wings config setup' (manual) instead.${NC}"
    echo ""

    if [ ! -f "$PTERODACTYL_DIR/artisan" ]; then
        echo -e "${BRED}No Pterodactyl Panel found at ${PTERODACTYL_DIR} on this machine.${NC}"
        echo -e "${BRED}Wings Auto only works when Panel + Wings are on the same node/VPS/PC.${NC}"
        pause
