# The actual runner - respects every AS_DO_* toggle, skipping (and saying
# so) whatever's turned off. Cloudflare token / theme choice are only
# asked if those steps are actually enabled.
run_auto_setup_execute() {
    banner
    echo -e "${BCYAN}${BOLD}▸ Auto Setup - Running${NC}"
    echo -e "${BCYAN}───────────────────────${NC}"
    echo ""
    echo -e "${BYELLOW}Steps for this run:${NC}"
    echo -e "  ${BCYAN}1)${NC} Panel install (FQDN: ${YELLOW}${AUTO_SETUP_FQDN}${NC}) - $(as_step_label "$AS_DO_PANEL")"
    echo -e "  ${BCYAN}2)${NC} System update - $(as_step_label "$AS_DO_UPDATE")"
    echo -e "  ${BCYAN}3)${NC} Cloudflare tunnel - $(as_step_label "$AS_DO_CLOUDFLARE")"
    echo -e "  ${BCYAN}4)${NC} Blueprint install - $(as_step_label "$AS_DO_BLUEPRINT")"
    echo -e "  ${BCYAN}5)${NC} Theme - $(as_step_label "$AS_DO_THEME")"
    echo -e "  ${BCYAN}6)${NC} Wings install + docker + fix - $(as_step_label "$AS_DO_WINGS")"
    echo ""

    local as_cf_token=""
    if [ "$AS_DO_CLOUDFLARE" = "y" ]; then
        read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" as_cf_token
        if [ -z "$as_cf_token" ]; then
            echo -e "${BRED}Token is required for the Cloudflare step. Aborting Auto Setup.${NC}"
            pause
            return
        fi
    fi

    local as_theme_choice="1" as_aric_email="" as_aric_license=""
    if [ "$AS_DO_THEME" = "y" ]; then
        echo ""
        echo -e "${BCYAN}Which theme?${NC}"
        echo -e "  ${BCYAN}1${NC} Nebula (free)"
        echo -e "  ${BCYAN}2${NC} Aric ${BYELLOW}(needs a LICENSE + email)${NC}"
        echo -e "  ${BCYAN}3${NC} None - skip theming"
        read -rp "$(echo -e ${YELLOW}"Choice [1]: "${NC})" as_theme_choice
        as_theme_choice="${as_theme_choice:-1}"

        if [ "$as_theme_choice" = "2" ]; then
            read -rp "$(echo -e ${YELLOW}"Aric Email: "${NC})" as_aric_email
            read -rp "$(echo -e ${YELLOW}"Aric LICENSE: "${NC})" as_aric_license
            if [ -z "$as_aric_email" ] || [ -z "$as_aric_license" ]; then
                echo -e "${BRED}Both Email and LICENSE are required for Aric. Aborting Auto Setup.${NC}"
                pause
                return
            fi
        fi
    fi

    if [ "$AS_DO_PANEL" = "y" ]; then
        echo ""
        echo -e "${BGREEN}${BOLD}>>> Panel install...${NC}"
        run_install_silent "$AUTO_SETUP_FQDN"
    else
        echo -e "${BYELLOW}>>> Panel install skipped.${NC}"
    fi

    if [ "$AS_DO_UPDATE" = "y" ]; then
        echo ""
        echo -e "${BGREEN}${BOLD}>>> System update...${NC}"
        apt update
        apt upgrade -y
    else
        echo -e "${BYELLOW}>>> System update skipped.${NC}"
    fi

    if [ "$AS_DO_CLOUDFLARE" = "y" ]; then
        echo ""
        echo -e "${BGREEN}${BOLD}>>> Cloudflare tunnel (background)...${NC}"
        cloudflare_background_core "$as_cf_token"
    else
        echo -e "${BYELLOW}>>> Cloudflare tunnel skipped.${NC}"
    fi

    if [ "$AS_DO_BLUEPRINT" = "y" ]; then
        echo ""
        echo -e "${BGREEN}${BOLD}>>> Blueprint install...${NC}"
        blueprint_install_core
    else
        echo -e "${BYELLOW}>>> Blueprint install skipped.${NC}"
    fi

    if [ "$AS_DO_THEME" = "y" ]; then
        echo ""
        case "$as_theme_choice" in
            2)
                echo -e "${BGREEN}${BOLD}>>> Aric theme...${NC}"
                theme_aric_install_core "$as_aric_email" "$as_aric_license"
                ;;
            3)
                echo -e "${BGREEN}${BOLD}>>> Theme skipped (chose None).${NC}"
                ;;
            *)
                echo -e "${BGREEN}${BOLD}>>> Nebula theme...${NC}"
                run_theme_nebula
                ;;
        esac
    else
        echo -e "${BYELLOW}>>> Theme step skipped.${NC}"
    fi

    if [ "$AS_DO_WINGS" = "y" ]; then
        echo ""
        echo -e "${BGREEN}${BOLD}>>> Wings install + docker + fix...${NC}"
        wings_install_docker_fix_core
    else
        echo -e "${BYELLOW}>>> Wings install + docker + fix skipped.${NC}"
    fi

    echo ""
    echo -e "${BGREEN}${BOLD}>>> Auto Setup complete!${NC}"
    pause
}

