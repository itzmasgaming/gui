# Single unified Extensions Library menu.
# Type a number      -> install that extension
# Type r<number>      -> remove that extension
# Type all            -> install every extension
# Type r all          -> remove every extension
# Type template       -> install the curated hosting bundle
# Type r template     -> remove the curated hosting bundle
extensions_library_menu() {
    local page_size=15
    local page=0
    local total=${#EXTENSIONS[@]}
    local total_pages=$(( (total + page_size - 1) / page_size ))

    while true; do
        banner
        echo -e "${BCYAN}${BOLD}▸ Extensions Library${NC}"
        echo -e "${BCYAN}─────────────────────${NC}"
        echo -e "${YELLOW}${total} extensions available${NC}"
        echo -e "${YELLOW}Stuck on '${EXT_STUCK_PATTERN}' for ${EXT_STUCK_TIMEOUT}s -> auto-skipped${NC}"
        echo ""

        local start=$(( page * page_size ))
        local end=$(( start + page_size - 1 ))
        (( end >= total )) && end=$(( total - 1 ))

        for (( i=start; i<=end; i++ )); do
            local ext_name="${EXTENSIONS[$i]}"
            local dot_color dot_char
            if is_extension_installed "$ext_name"; then
                dot_color="${BGREEN}"; dot_char="●"
            else
                dot_color="${BRED}"; dot_char="○"
            fi
            printf "  ${BCYAN}❯ %-3d${NC} " "$((i+1))"
            echo -e "${dot_color}${dot_char}${NC} ${ext_name}"
        done

        echo ""
        echo -e "  ${BGREEN}●${NC} installed   ${BRED}○${NC} not installed"
        echo -e "  Page $((page+1))/${total_pages}   ${YELLOW}n${NC})Next   ${YELLOW}p${NC})Prev   ${BRED}0${NC})Back"
        echo -e "  ${WHITE}Install:${NC} type a number (e.g. ${BCYAN}23${NC})   ${WHITE}Remove:${NC} r + number (e.g. ${BRED}r23${NC})"
        echo -e "  ${WHITE}Install several:${NC} comma-separate (e.g. ${BCYAN}1,2,4,7,9${NC})   ${WHITE}Remove several:${NC} ${BRED}r1,2,4,7,9${NC}"
        echo -e "  ${WHITE}Install ALL:${NC} ${BCYAN}all${NC}   ${WHITE}Remove ALL:${NC} ${BRED}r all${NC}"
        echo -e "  ${WHITE}Install best-for-hosting bundle:${NC} ${BCYAN}template${NC}   ${WHITE}Remove it:${NC} ${BRED}r template${NC}"
        echo -e "  ${WHITE}Install your curated \"best\" list (only what's actually available):${NC} ${BCYAN}best${NC}"
        echo -e "  ${WHITE}Keep only your keep-list, remove the rest installed:${NC} ${BRED}keep${NC}"
        echo -e "  ${WHITE}Fix a 500 error from a broken extension:${NC} ${BRED}repair${NC}"
        echo ""
        read -rp "$(echo -e ${BCYAN}${BOLD}"Select: "${NC})" raw_choice

        local choice
        choice=$(echo "$raw_choice" | tr '[:upper:]' '[:lower:]' | tr -d ' ')

        if [[ "$choice" == "n" ]]; then
            (( page < total_pages - 1 )) && page=$((page+1))
        elif [[ "$choice" == "p" ]]; then
            (( page > 0 )) && page=$((page-1))
        elif [[ "$choice" == "0" ]]; then
            return
        elif [[ "$choice" == "all" ]]; then
            install_all_extensions
        elif [[ "$choice" == "rall" ]]; then
            uninstall_all_extensions
        elif [[ "$choice" == "template" ]]; then
            install_template_extensions
        elif [[ "$choice" == "rtemplate" ]]; then
            uninstall_template_extensions
        elif [[ "$choice" == "best" ]]; then
            install_best_extensions
        elif [[ "$choice" == "keep" ]]; then
            prune_to_keep_list
        elif [[ "$choice" == "repair" ]]; then
            repair_routes_now
        elif [[ "$choice" =~ ^r[0-9]+(,[0-9]+)+$ ]]; then
            local nums_str="${choice#r}"
            local n valid=() invalid=()
            IFS=',' read -ra nums <<< "$nums_str"
            for n in "${nums[@]}"; do
                if (( n >= 1 && n <= total )); then
                    valid+=("$n")
                else
                    invalid+=("$n")
                fi
            done
            if [ "${#invalid[@]}" -gt 0 ]; then
                echo -e "${BRED}Skipping invalid number(s): ${invalid[*]}${NC}"; sleep 1
            fi
            for n in "${valid[@]}"; do
                uninstall_extension "${EXTENSIONS[$((n-1))]}"
            done
        elif [[ "$choice" =~ ^[0-9]+(,[0-9]+)+$ ]]; then
            local n valid=() invalid=()
            IFS=',' read -ra nums <<< "$choice"
            for n in "${nums[@]}"; do
                if (( n >= 1 && n <= total )); then
                    valid+=("$n")
                else
                    invalid+=("$n")
                fi
            done
            if [ "${#invalid[@]}" -gt 0 ]; then
                echo -e "${BRED}Skipping invalid number(s): ${invalid[*]}${NC}"; sleep 1
            fi
            for n in "${valid[@]}"; do
                install_extension "${EXTENSIONS[$((n-1))]}"
            done
        elif [[ "$choice" =~ ^r([0-9]+)$ ]]; then
            local num="${BASH_REMATCH[1]}"
            if (( num >= 1 && num <= total )); then
                uninstall_extension "${EXTENSIONS[$((num-1))]}"
            else
                echo -e "${BRED}Invalid number.${NC}"; sleep 1
            fi
        elif [[ "$choice" =~ ^[0-9]+$ ]]; then
            if (( choice >= 1 && choice <= total )); then
                install_extension "${EXTENSIONS[$((choice-1))]}"
            else
                echo -e "${BRED}Invalid number.${NC}"; sleep 1
            fi
        else
            echo -e "${BRED}Invalid option.${NC}"; sleep 1
        fi
    done
}

