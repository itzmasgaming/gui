# ---------------- HELPERS ----------------
banner() {
    clear
    echo -e "$WATERMARK"

    local width=48
    local line
    line=$(printf '━%.0s' $(seq 1 "$width"))

    center() {
        local text="$1"
        local left=$(( (width -${#text}) / 2 ))
        local right=$(( width -${#text} - left ))
        (( left < 0 )) && left=0
        (( right < 0 )) && right=0
        printf '%*s%s%*s' "$left" "" "$text" "$right" ""
    }

    echo -e "${BRED}${BOLD}┏${line}┓${NC}"
    echo -e "${BRED}${BOLD}┃${NC}$(center "" )${BRED}${BOLD}┃${NC}"
    echo -e "${BRED}${BOLD}┃${NC}${BOLD}${BBCYAN}$(center "◆ MAS GUI ◆")${NC}${BRED}${BOLD}┃${NC}"
    echo -e "${BRED}${BOLD}┃${NC}${BCYAN}$(center "Pterodactyl Panel Toolkit")${NC}${BRED}${BOLD}┃${NC}"
    echo -e "${BRED}${BOLD}┃${NC}${YELLOW}$(center "ɪᴛᴢᴍᴀꜱɢᴀᴍɪɴɢ")${NC}${BRED}${BOLD}┃${NC}"
    echo -e "${BRED}${BOLD}┃${NC}${WHITE}$(center "v${SCRIPT_VERSION}")${NC}${BRED}${BOLD}┃${NC}"
    echo -e "${BRED}${BOLD}┃${NC}$(center "" )${BRED}${BOLD}┃${NC}"
    echo -e "${BRED}${BOLD}┗${line}┛${NC}"
    echo ""
}

pause() {
    echo ""
    read -rp "$(echo -e${BYELLOW}"Press ENTER to return to the menu..."${NC})" _
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${BRED}This script must be run as root. Try: sudo bash $0${NC}"
        exit 1
    fi
}

fix_locale() {
    if ! locale -a 2>/dev/null | grep -qi "en_US.utf8\|en_US.UTF-8"; then
        apt-get install -y locales >/dev/null 2>&1
        sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen 2>/dev/null
        grep -q "^en_US.UTF-8 UTF-8" /etc/locale.gen 2>/dev/null || echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
        locale-gen en_US.UTF-8 >/dev/null 2>&1
        update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 >/dev/null 2>&1
    fi
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
}

confirm_destructive() {
    local label="$1"
    local code
    code=$(tr -dc 'A-Z0-9' </dev/urandom | head -c 6)
    echo ""
    echo -e "${BRED}${BOLD}!!! WARNING !!!${NC} This will uninstall:${YELLOW}${label}${NC}"
    echo -e "${BRED}To confirm, type this exact code:${YELLOW}${code}${NC}"
    read -rp "$(echo -e${BCYAN}"Confirmation code: "${NC})" input_code
    if [ "$input_code" != "$code" ]; then
        echo -e "${BRED}Code did not match. Aborted.${NC}"
        sleep 2
        return 1
    fi
    return 0
}

run_with_stuck_watchdog() {
    local pattern="$1" timeout_secs="$2"; shift 2
    local out_file
    out_file=$(mktemp)

    ("$@" 2>&1 \vert{} tee "$out_file") &
    local cmd_pid=$!

    (
        local prev_line="" stuck_secs=0
        while kill -0 "$cmd_pid" 2>/dev/null; do
            sleep 1
            local cur_line
            cur_line=$(tail -n1 "$out_file" 2>/dev/null)

            if [[ "$cur_line" == *"$pattern"* ]] && [ "$cur_line" = "$prev_line" ]; then
                stuck_secs=$(( stuck_secs + 1 ))
            else
                stuck_secs=0
            fi
            prev_line="$cur_line"

            if [ "$stuck_secs" -ge "$timeout_secs" ]; then
                echo -e "\n${BRED}>>> Stuck on '${pattern}' for ${timeout_secs}s - killing it...${NC}"
                kill -TERM "$cmd_pid" 2>/dev/null
                sleep 1
                kill -KILL "$cmd_pid" 2>/dev/null
                break
            fi
        done
    ) &
    local watchdog_pid=$!

    wait "$cmd_pid" 2>/dev/null
    local status=$?
    kill "$watchdog_pid" 2>/dev/null
    rm -f "$out_file"
    return $status
}

# ---------------- CLOUDFLARE ----------------
install_cloudflare() {
    banner
    echo -e "${BCYAN}${BOLD}▸ Install Cloudflare${NC}"
    echo -e "${BCYAN}────────────────────${NC}"
    echo ""

    if command -v cloudflared >/dev/null 2>&1; then
        echo -e "${YELLOW}cloudflared is already installed ($(cloudflared --version 2>/dev/null \vert{} head -n1)).${NC}"
        read -rp "$(echo -e${YELLOW}"Reinstall / redownload it anyway? (y/n): "${NC})" cf_reinstall_ans
        if [[ ! "$cf_reinstall_ans" =~ ^[Yy]$ ]]; then
            pause
            return
        fi
    fi

    echo -e "${BCYAN}>>> Installing dependencies (curl)...${NC}"
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl >/dev/null 2>&1

    local cf_arch
    case "$(uname -m)" in
        x86_64) cf_arch="amd64" ;;
        aarch64|arm64) cf_arch="arm64" ;;
        armv7l) cf_arch="arm" ;;
        *) cf_arch="amd64" ;;
    esac

    echo -e "${BCYAN}>>> Downloading cloudflared (${cf_arch})...${NC}"
    if ! curl -fsSL -o /usr/local/bin/cloudflared "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}"; then
        echo -e "${BRED}Download failed. Check your network/internet connection and try again.${NC}"
        pause
        return
    fi
    chmod +x /usr/local/bin/cloudflared
    ln -sf /usr/local/bin/cloudflared /usr/bin/cloudflared 2>/dev/null

    if command -v cloudflared >/dev/null 2>&1; then
        echo ""
        echo -e "${BGREEN}>>> cloudflared installed successfully: $(cloudflared --version 2>/dev/null \vert{} head -n1)${NC}"
    else
        echo -e "${BRED}Something went wrong - cloudflared is still not on PATH.${NC}"
    fi
    pause
}

run_cloudflare_foreground() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        read -rp "$(echo -e${YELLOW}"Install it now? (y/n): "${NC})" cf_install_ans
        if [[ "$cf_install_ans" =~ ^[Yy]$ ]]; then
            install_cloudflare
        fi
        if ! command -v cloudflared >/dev/null 2>&1; then
            pause
            return
        fi
    fi
    echo ""
    read -rp "$(echo -e${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi
    echo ""
    echo -e "${BCYAN}>>> Running Cloudflare tunnel in terminal (foreground)...${NC}"
    cloudflared tunnel run --protocol http2 --token "$cf_token"
    pause
}

install_cloudflare_silent() {
    if command -v cloudflared >/dev/null 2>&1; then
        return 0
    fi
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl >/dev/null 2>&1

    local cf_arch
    case "$(uname -m)" in
        x86_64) cf_arch="amd64" ;;
        aarch64|arm64) cf_arch="arm64" ;;
        armv7l) cf_arch="arm" ;;
        *) cf_arch="amd64" ;;
    esac

    if ! curl -fsSL -o /usr/local/bin/cloudflared "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}"; then
        return 1
    fi
    chmod +x /usr/local/bin/cloudflared
    ln -sf /usr/local/bin/cloudflared /usr/bin/cloudflared 2>/dev/null
    command -v cloudflared >/dev/null 2>&1
}

cloudflare_background_core() {
    local cf_token="$1"
    if ! command -v cloudflared >/dev/null 2>&1; then
        install_cloudflare_silent || return 1
    fi

    cat <<SERVICE_EOF > /etc/systemd/system/cloudflared.service
[Unit]
Description=Cloudflare Tunnel
After=network.target

[Service]
User=root
ExecStart=/usr/bin/cloudflared tunnel run --protocol http2 --token $cf_token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE_EOF

    systemctl daemon-reload
    systemctl enable --now cloudflared
}

run_cloudflare_background() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        install_cloudflare_silent
    fi
    echo ""
    read -rp "$(echo -e${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi
    cloudflare_background_core "$cf_token"
    pause
}

cloudflare_menu() {
    while true; do
        banner
        echo -e "${BCYAN}${BOLD}▸ Cloudflare Menu${NC}"
        echo -e "  ❯ ${BCYAN}1${NC} Install Cloudflare"
