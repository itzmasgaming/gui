        echo -e "${BYELLOW}Panel admin UI (Admin -> Nodes) instead.${NC}"
        pause
        return
    fi

    result_line="${result_line#AUTONODE_RESULT:}"
    IFS='|' read -r w_uuid w_token_id w_token w_fqdn <<< "$result_line"

    if [ -z "$w_uuid" ] || [ -z "$w_token_id" ] || [ -z "$w_token" ]; then
