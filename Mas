install_cloudflare() {
    banner
    echo -e "${BCYAN}${BOLD}▸ Install Cloudflare${NC}"
    echo -e "${BCYAN}────────────────────${NC}"
    echo ""

    if command -v cloudflared >/dev/null 2>&1; then
        echo -e "${YELLOW}cloudflared is already installed ($(cloudflared --version 2>/dev/null | head -n1)).${NC}"
        read -rp "$(echo -e ${YELLOW}"Reinstall / redownload it anyway? (y/n): "${NC})" cf_reinstall_ans
        if [[ ! "$cf_reinstall_ans" =~ ^[Yy]$ ]]; then
            pause
            return
        fi
    fi

    echo -e "${BCYAN}>>> Installing dependencies (curl)...${NC}"
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl >/dev/null 2>&1

    local cf_arch
    case "$(uname -m)" in
        x86_64) cf_arch="amd64" ;;
        aarch64|arm64) cf_arch="arm64" ;;
        armv7l) cf_arch="arm" ;;
        *) cf_arch="amd64" ;;
    esac

    echo -e "${BCYAN}>>> Downloading cloudflared (${cf_arch})...${NC}"
    if ! curl -fsSL -o /usr/local/bin/cloudflared "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}"; then
        echo -e "${BRED}Download failed. Check your network/internet connection and try again.${NC}"
        pause
        return
    fi
    chmod +x /usr/local/bin/cloudflared

    # Make sure it's on PATH even if /usr/local/bin isn't (also drop a copy at /usr/bin,
    # since uninstall_cloudflare cleans up both locations).
    ln -sf /usr/local/bin/cloudflared /usr/bin/cloudflared 2>/dev/null

    if command -v cloudflared >/dev/null 2>&1; then
        echo ""
        echo -e "${BGREEN}>>> cloudflared installed successfully: $(cloudflared --version 2>/dev/null | head -n1)${NC}"
        echo -e "${BGREEN}>>> You can now use 'Run in terminal' or 'Run in background' from the Cloudflare menu.${NC}"
    else
        echo -e "${BRED}Something went wrong - cloudflared is still not on PATH.${NC}"
    fi
    pause
}

run_cloudflare_foreground() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        read -rp "$(echo -e ${YELLOW}"Install it now? (y/n): "${NC})" cf_install_ans
        if [[ "$cf_install_ans" =~ ^[Yy]$ ]]; then
            install_cloudflare
        fi
        if ! command -v cloudflared >/dev/null 2>&1; then
            pause
            return
        fi
    fi
    echo ""
    read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi
    echo ""
    echo -e "${BCYAN}>>> Running Cloudflare tunnel in terminal (foreground)...${NC}"
    echo -e "${YELLOW}>>> Press Ctrl+C to stop. Closing this terminal will stop the tunnel.${NC}"
    echo ""
    sleep 1
    cloudflared tunnel run --protocol http2 --token "$cf_token"
    pause
}

# Installs cloudflared with no prompts (used by Auto Setup and as a
# fallback inside the interactive Cloudflare menu functions). Returns 0
# on success.
install_cloudflare_silent() {
    if command -v cloudflared >/dev/null 2>&1; then
        return 0
    fi

    echo -e "${BCYAN}>>> Installing cloudflared...${NC}"
    apt-get update -y >/dev/null 2>&1
    apt-get install -y curl >/dev/null 2>&1

    local cf_arch
    case "$(uname -m)" in
        x86_64) cf_arch="amd64" ;;
        aarch64|arm64) cf_arch="arm64" ;;
        armv7l) cf_arch="arm" ;;
        *) cf_arch="amd64" ;;
    esac

    if ! curl -fsSL -o /usr/local/bin/cloudflared "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}"; then
        echo -e "${BRED}cloudflared download failed. Check your network/internet connection.${NC}"
        return 1
    fi
    chmod +x /usr/local/bin/cloudflared
    ln -sf /usr/local/bin/cloudflared /usr/bin/cloudflared 2>/dev/null
    command -v cloudflared >/dev/null 2>&1
}

# Core of "run in background (systemd)" with the token passed in directly -
# no prompts, no pause(). Shared by the interactive menu and Auto Setup.
cloudflare_background_core() {
    local cf_token="$1"

    if ! command -v cloudflared >/dev/null 2>&1; then
        install_cloudflare_silent || return 1
    fi

    echo -e "${BCYAN}>>> Creating cloudflared.service...${NC}"
    cat <<SERVICE_EOF > /etc/systemd/system/cloudflared.service
[Unit]
Description=Cloudflare Tunnel
After=network.target

[Service]
User=root
ExecStart=/usr/bin/cloudflared tunnel run --protocol http2 --token $cf_token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE_EOF

    systemctl daemon-reload
    systemctl enable --now cloudflared
    systemctl status cloudflared --no-pager

    echo ""
    echo -e "${BCYAN}>>> Cloudflare tunnel running in background. Check logs anytime with:${NC}"
    echo -e "    ${YELLOW}journalctl -u cloudflared -f${NC}"
}

run_cloudflare_background() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        read -rp "$(echo -e ${YELLOW}"Install it now? (y/n): "${NC})" cf_install_ans
        if [[ "$cf_install_ans" =~ ^[Yy]$ ]]; then
            install_cloudflare
        fi
        if ! command -v cloudflared >/dev/null 2>&1; then
            pause
            return
        fi
    fi
    echo ""
    read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi

    cloudflare_background_core "$cf_token"
    pause
}

# ---- Cloudflare background service control (start/stop/restart/status) ----
cloudflare_service_start() {
    if [ ! -f /etc/systemd/system/cloudflared.service ]; then
        echo -e "${BRED}cloudflared.service not found. Run 'Run in background (systemd)' first to create it.${NC}"
        pause
        return
    fi
    echo -e "${BCYAN}>>> Starting Cloudflare background service...${NC}"
    systemctl enable --now cloudflared
    systemctl status cloudflared --no-pager
    pause
}

cloudflare_service_stop() {
    if [ ! -f /etc/systemd/system/cloudflared.service ]; then
        echo -e "${BRED}cloudflared.service not found. Nothing to stop.${NC}"
        pause
        return
    fi
    echo -e "${BCYAN}>>> Stopping Cloudflare background service...${NC}"
    systemctl stop cloudflared
    echo -e "${BGREEN}>>> Cloudflare background service stopped.${NC}"
    pause
}

cloudflare_service_restart() {
    if [ ! -f /etc/systemd/system/cloudflared.service ]; then
        echo -e "${BRED}cloudflared.service not found. Run 'Run in background (systemd)' first to create it.${NC}"
        pause
        return
    fi
    echo -e "${BCYAN}>>> Restarting Cloudflare background service...${NC}"
    systemctl restart cloudflared
    systemctl status cloudflared --no-pager
    pause
}

cloudflare_service_status() {
    banner
    echo -e "${BCYAN}${BOLD}▸ Cloudflare Service Status${NC}"
    echo -e "${BCYAN}───────────────────────────${NC}"
    echo ""
    if [ ! -f /etc/systemd/system/cloudflared.service ]; then
        echo -e "${BRED}cloudflared.service not found.${NC}"
    else
        systemctl status cloudflared --no-pager
    fi
    pause
}

