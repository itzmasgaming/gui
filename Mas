# ============================================================
run_system_spec() {
    banner
    echo -e "${BRED}${BOLD}▸ System Spec${NC}"
    echo -e "${BCYAN}─────────────${NC}"
    echo ""

    cpu_model=$(grep -m1 "model name" /proc/cpuinfo | cut -d':' -f2 | sed 's/^ *//')
    [ -z "$cpu_model" ] && cpu_model="Unknown"

    if [ -f /sys/fs/cgroup/cpuset.cpus.effective ]; then
        core_range=$(cat /sys/fs/cgroup/cpuset.cpus.effective)
    elif [ -f /sys/fs/cgroup/cpuset/cpuset.cpus ]; then
        core_range=$(cat /sys/fs/cgroup/cpuset/cpuset.cpus)
    else
        core_range=$(grep "Cpus_allowed_list" /proc/self/status | awk '{print $2}')
    fi
    [ -z "$core_range" ] && core_range="Unknown"

    thread_count=$(nproc)

    mem_total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    mem_avail_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    mem_total_gb=$(awk "BEGIN {printf \"%.0f\", $mem_total_kb*1024/1000000000}")
    mem_avail_gb=$(awk "BEGIN {printf \"%.0f\", $mem_avail_kb*1024/1000000000}")
    mem_used_gb=$(awk "BEGIN {printf \"%.0f\", $mem_total_gb-$mem_avail_gb}")

    read -r _ total_b used_b avail_b _ < <(df -B1 / | tail -1)
    storage_total_gb=$(awk "BEGIN {printf \"%.0f\", $total_b/1000000000}")
    storage_used_gb=$(awk "BEGIN {printf \"%.0f\", $used_b/1000000000}")
    storage_avail_gb=$(awk "BEGIN {printf \"%.0f\", $avail_b/1000000000}")

    if command -v nvidia-smi >/dev/null 2>&1; then
        gpu_info=$(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null)
        [ -z "$gpu_info" ] && gpu_info="NVIDIA tools present but no GPU detected"
    else
        gpu_info="No GPU detected / nvidia-smi not installed"
    fi

    if command -v uptime >/dev/null 2>&1; then
        runtime_info=$(uptime -p 2>/dev/null)
    fi
    if [ -z "$runtime_info" ]; then
        up_seconds=$(awk '{print int($1)}' /proc/uptime)
        runtime_info="${up_seconds}s"
    fi

    echo -e "${BCYAN}CPU Model:${NC}        $cpu_model"
    echo -e "${BCYAN}Cores/Threads:${NC}    $thread_count"
    echo -e "${BCYAN}Core/Thread Range:${NC} $core_range  ${YELLOW}(as allowed by Docker cgroup)${NC}"
    echo ""
    echo -e "${BCYAN}RAM Total:${NC}        ${mem_total_gb} GB"
    echo -e "${BCYAN}RAM Used:${NC}         ${mem_used_gb} GB"
    echo -e "${BCYAN}RAM Available:${NC}    ${mem_avail_gb} GB"
    echo ""
    echo -e "${BCYAN}Storage Total:${NC}    ${storage_total_gb} GB"
    echo -e "${BCYAN}Storage Used:${NC}     ${storage_used_gb} GB"
    echo -e "${BCYAN}Storage Available:${NC} ${storage_avail_gb} GB"
    echo ""
    echo -e "${BCYAN}GPU:${NC}              $gpu_info"
    echo ""
    echo -e "${BCYAN}Uptime:${NC}           $runtime_info"

    pause
}

