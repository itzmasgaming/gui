    fi

    echo -e "${BGREEN}>>> Node created: ${node_name} (UUID: ${w_uuid})${NC}"
    echo ""
    echo -e "${BCYAN}>>> Writing Wings config + service...${NC}"
    write_wings_config "$w_uuid" "$w_token_id" "$w_token" "$panel_url" "$node_port"

