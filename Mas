        read -rp "$(echo -e ${BCYAN}${BOLD}"Select an option: "${NC})" cf_choice
        case "$cf_choice" in
            1) install_cloudflare ;;
            2) run_cloudflare_foreground ;;
            3) run_cloudflare_background ;;
            0) return ;;
            *) echo -e "${BRED}Invalid option.${NC}"; sleep 1 ;;
        esac
    done
}

