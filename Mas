# ============================================================
# PANEL - maintenance mode + info
# ============================================================
panel_maintenance_toggle() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}--- Maintenance Mode ---${NC}"
    echo ""
    cd "$PTERODACTYL_DIR" || return
    if [ -f "$PTERODACTYL_DIR/storage/framework/down" ]; then
        echo -e "${YELLOW}Panel is currently DOWN (maintenance mode).${NC}"
        read -rp "$(echo -e ${YELLOW}"Bring it back UP? (y/n): "${NC})" ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            php artisan up
            echo -e "${BGREEN}>>> Panel is now UP.${NC}"
        fi
    else
        echo -e "${YELLOW}Panel is currently UP.${NC}"
        read -rp "$(echo -e ${YELLOW}"Put it into maintenance mode (DOWN)? (y/n): "${NC})" ans
        if [[ "$ans" =~ ^[Yy]$ ]]; then
            php artisan down
            echo -e "${BGREEN}>>> Panel is now DOWN (maintenance mode).${NC}"
        fi
    fi
    pause
}

panel_info() {
    require_panel_installed || return
    banner
    echo -e "${BCYAN}${BOLD}--- Panel Info ---${NC}"
    echo ""
    cd "$PTERODACTYL_DIR" || return
    php artisan p:info
    pause
}

panel_setup_menu() {
    while true; do
        banner
        echo -e "${BRED}${BOLD}--- Pterodactyl Panel Setup ---${NC}"
        echo -e "  ${BCYAN}1)${NC} Pterodactyl install"
        echo -e "  ${BCYAN}2)${NC} Pterodactyl reinstall"
        echo -e "  ${BCYAN}3)${NC} Setup Users"
        echo -e "  ${BCYAN}4)${NC} Maintenance Mode"
