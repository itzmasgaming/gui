# ============================================================
# ACCESS VERIFICATION - requires a valid mashosting.bond login
# ============================================================
# (c) ItzMASGaming - unauthorized copies/reuploads of this script violate copyright.
# Built against a standard Laravel/Pterodactyl login form (CSRF token +
# email/password fields). NOTE: not tested against the live site since it
# was returning a 502 at the time this was written - if the field names
# or response shape differ once the panel is back up, this may need
# adjusting (the csrf_token / authed_check patterns below are the parts
# most likely to need a tweak).
MAS_LOGIN_URL="https://mashosting.bond/auth/login"
MAS_HOME_URL="https://mashosting.bond/"

require_mas_login() {
    banner
    echo -e "${BCYAN}${BOLD}▸ MAS Gui Access Verification${NC}"
    echo -e "${BCYAN}──────────────────────────────${NC}"
    echo ""
    echo -e "${YELLOW}Sign in with your mashosting.bond account to continue.${NC}"
    echo ""

    local attempts=0
    local max_attempts=3

    while [ "$attempts" -lt "$max_attempts" ]; do
        read -rp "$(echo -e ${YELLOW}"Email: "${NC})" mas_login_email
        read -rsp "$(echo -e ${YELLOW}"Password: "${NC})" mas_login_pass
        echo ""

        local cookie_jar
        cookie_jar=$(mktemp)

        local login_page
        login_page=$(curl -sL -c "$cookie_jar" "$MAS_LOGIN_URL")

        if [ -z "$login_page" ]; then
            echo -e "${BRED}Could not reach ${MAS_LOGIN_URL} (site may be down). Cannot verify access right now.${NC}"
            rm -f "$cookie_jar"
            attempts=$((attempts+1))
            continue
        fi

        local csrf_token
        csrf_token=$(echo "$login_page" | grep -oE 'name="_token"[^>]*value="[^"]+"' | sed -E 's/.*value="([^"]+)".*/\1/' | head -1)

        if [ -z "$csrf_token" ]; then
            echo -e "${BRED}Could not read a login form from the site. Cannot verify access right now.${NC}"
            rm -f "$cookie_jar"
            attempts=$((attempts+1))
            continue
        fi

        curl -s -o /dev/null -c "$cookie_jar" -b "$cookie_jar" \
            --data-urlencode "_token=$csrf_token" \
            --data-urlencode "email=$mas_login_email" \
            --data-urlencode "password=$mas_login_pass" \
            "$MAS_LOGIN_URL"

        local authed_check
        authed_check=$(curl -s -b "$cookie_jar" -L "$MAS_HOME_URL")
        rm -f "$cookie_jar"
        unset mas_login_pass

        if echo "$authed_check" | grep -qi "logout\|dashboard\|Server List"; then
            echo -e "${BGREEN}>>> Access verified. Welcome.${NC}"
            sleep 1
            return 0
        fi

        attempts=$((attempts+1))
        echo -e "${BRED}Login failed. (${attempts}/${max_attempts})${NC}"
    done

    echo ""
    echo -e "${BRED}${BOLD}Access denied - could not verify your mashosting.bond account.${NC}"
    exit 1
}

