# ============================================================
# INSTALLED APPS
# ============================================================
run_installed_apps() {
    banner
    echo -e "${CYAN}${BOLD}--- Installed Apps ---${NC}"
    echo ""

    # ---- Cloudflare ----
    if command -v cloudflared >/dev/null 2>&1; then
        cf_status="Not running"
        if [ -f /etc/systemd/system/cloudflared.service ] && [ "$(systemctl is-active cloudflared 2>/dev/null)" = "active" ]; then
            cf_status="Running"
        elif pgrep -f "cloudflared tunnel" >/dev/null 2>&1; then
            cf_status="Running"
        fi
        echo -e "${WHITE}Cloudflare:${NC} ${YELLOW}Installed${NC} - ${YELLOW}${cf_status}${NC}"
    else
        echo -e "${WHITE}Cloudflare:${NC} ${BRED}Not installed${NC}"
    fi

    # ---- Pterodactyl Panel ----
    if [ -f /var/www/pterodactyl/artisan ]; then
        echo -e "${WHITE}Pterodactyl Panel:${NC} ${YELLOW}Installed${NC}"
    else
        echo -e "${WHITE}Pterodactyl Panel:${NC} ${BRED}Not installed${NC}"
    fi

    # ---- Docker ----
    if command -v docker >/dev/null 2>&1; then
        docker_status=$(systemctl is-active docker 2>/dev/null)
        echo -e "${WHITE}Docker:${NC} ${YELLOW}Installed${NC} - ${YELLOW}${docker_status:-Not running}${NC}"
    else
        echo -e "${WHITE}Docker:${NC} ${BRED}Not installed${NC}"
    fi

    # ---- Wings ----
    if [ -f /usr/local/bin/wings ]; then
        wings_status="Not running"
        if [ -f /etc/systemd/system/wings.service ] && [ "$(systemctl is-active wings 2>/dev/null)" = "active" ]; then
            wings_status="Running"
        elif pgrep -x "wings" >/dev/null 2>&1; then
            wings_status="Running"
        fi
        echo -e "${WHITE}Wings:${NC} ${YELLOW}Installed${NC} - ${YELLOW}${wings_status}${NC}"
    else
        echo -e "${WHITE}Wings:${NC} ${BRED}Not installed${NC}"
    fi

    # ---- Wings config ----
    if [ -f /etc/pterodactyl/config.yml ]; then
        echo -e "${WHITE}Wings config:${NC} ${YELLOW}Present${NC}"
    else
        echo -e "${WHITE}Wings config:${NC} ${BRED}Not found${NC}"
    fi

    # ---- Blueprint ----
    if [ -d /var/www/pterodactyl/.blueprint ]; then
        echo -e "${WHITE}Blueprint:${NC} ${YELLOW}Installed${NC}"
    else
        echo -e "${WHITE}Blueprint:${NC} ${BRED}Not installed${NC}"
    fi

    pause
}

