# True (0) if $1 is present in the array named $2.
is_in_array() {
    local needle="$1" name="$2[@]"
    local hay
    for hay in "${!name}"; do
        [ "$hay" = "$needle" ] && return 0
    done
    return 1
}

# Uninstalls every currently-installed extension that is NOT in
# KEEP_EXTENSIONS. One confirmation code total, no per-item prompts.
prune_to_keep_list() {
    local to_remove=()
    local name
    for name in "${EXTENSIONS[@]}"; do
        if is_extension_installed "$name" && ! is_in_array "$name" "KEEP_EXTENSIONS"; then
            to_remove+=("$name")
        fi
    done

    if [ "${#to_remove[@]}" -eq 0 ]; then
        echo ""
        echo -e "${BGREEN}>>> Nothing to remove - every installed extension is already on the keep list.${NC}"
        pause
        return
    fi

    echo ""
    echo -e "${BCYAN}${BOLD}Keeping:${NC}"
    for name in "${KEEP_EXTENSIONS[@]}"; do
        is_extension_installed "$name" && echo -e "  ${BGREEN}❯${NC} ${name}"
    done
    echo ""
    echo -e "${BRED}${BOLD}Will remove (installed but not on the keep list):${NC}"
    for name in "${to_remove[@]}"; do
        echo -e "  ${BRED}❯${NC} ${name}"
    done

    confirm_destructive "${#to_remove[@]} installed extension(s) not on your keep list" || return

    for name in "${to_remove[@]}"; do
        uninstall_extension "$name"
    done

    echo -e "${BGREEN}>>> Pruned. Only your keep-list extensions remain installed.${NC}"
    pause
}

# True (0) if <repo>/<name>.blueprint actually exists (HTTP HEAD check),
# without downloading it.
extension_exists_upstream() {
    local name="$1"
    wget -q --spider "${EXTENSION_REPO_BASE}/${name}.blueprint" 2>/dev/null
}

# Installs every extension in KEEP_EXTENSIONS ("best" bundle) that is
# currently NOT installed. Anything whose .blueprint file isn't found at
# the source repo is skipped silently - no error, it's just left out.
install_best_extensions() {
    echo ""
    echo -e "${BCYAN}>>> Checking which of the ${#KEEP_EXTENSIONS[@]} best extensions are available...${NC}"

    local to_install=()
    local name
    for name in "${KEEP_EXTENSIONS[@]}"; do
        is_extension_installed "$name" && continue
        extension_exists_upstream "$name" && to_install+=("$name")
    done

    if [ "${#to_install[@]}" -eq 0 ]; then
        echo -e "${BGREEN}>>> Nothing to install - already up to date (or nothing available right now).${NC}"
        pause
        return
    fi

    echo ""
    echo -e "${BCYAN}${BOLD}Will install:${NC}"
    for name in "${to_install[@]}"; do
        echo -e "  ${BCYAN}❯${NC} ${name}"
    done
    echo ""
    read -rp "$(echo -e ${YELLOW}"Install these ${#to_install[@]} extensions? (y/n): "${NC})" confirm_ans
    if [[ ! "$confirm_ans" =~ ^[Yy]$ ]]; then
        return
    fi

    for name in "${to_install[@]}"; do
        install_extension "$name"
    done

    echo -e "${BGREEN}>>> Best extensions installed.${NC}"
    pause
}

# Blueprint Framework installs each extension into its own folder under
# .blueprint/extensions/<name>/ - use that to detect install status.
is_extension_installed() {
    local name="$1"
    [ -d "$PTERODACTYL_DIR/.blueprint/extensions/$name" ]
}

# Extensions add new routes/views that Laravel may still be serving from
# stale cache -> that's what causes a 500 error right after installing or
# removing one. Clear the caches + fix ownership every time, same steps
# master_fix.sh already does during the initial Blueprint install.
blueprint_cache_fix() {
    cd "$PTERODACTYL_DIR" || return
    php artisan optimize:clear >/dev/null 2>&1
    php artisan config:clear >/dev/null 2>&1
    php artisan view:clear >/dev/null 2>&1
    php artisan route:clear >/dev/null 2>&1
    chown -R www-data:www-data "$PTERODACTYL_DIR" 2>/dev/null
    chmod -R 755 "$PTERODACTYL_DIR/storage" "$PTERODACTYL_DIR/bootstrap/cache" 2>/dev/null
}

install_extension() {
    local name="$1"
    echo ""
    echo -e "${BCYAN}>>> Installing extension: ${name}...${NC}"
    cd "$PTERODACTYL_DIR" || { echo -e "${BRED}Path not found!${NC}"; sleep 2; return; }

    if ! wget -q "${EXTENSION_REPO_BASE}/${name}.blueprint"; then
        echo -e "${BRED}Download failed for ${name}.blueprint - check your network/the source repo.${NC}"
        sleep 2
        return
    fi

    clear_blueprint_lock

    # Watchdog: if `blueprint -i` freezes on a line containing
    # EXT_STUCK_PATTERN (e.g. "46%") for EXT_STUCK_TIMEOUT seconds
    # straight, kill it and move on instead of hanging the whole run.
    run_with_stuck_watchdog "$EXT_STUCK_PATTERN" "$EXT_STUCK_TIMEOUT" blueprint -i "$name"
    local install_status=$?

    rm -f "${name}.blueprint"
    clear_blueprint_lock
    blueprint_cache_fix

    if [ "$install_status" -eq 124 ]; then
        echo -e "${BRED}>>> ${name} timed out (stuck) and was skipped.${NC}"
    elif [ "$install_status" -ne 0 ]; then
        echo -e "${BYELLOW}>>> ${name} exited with status ${install_status} - check output above.${NC}"
    else
        if repair_broken_routes_if_needed "$name"; then
            echo -e "${BGREEN}>>> ${name} installed!${NC}"
        else
            echo -e "${BRED}>>> ${name} was uninstalled again after breaking a routes file.${NC}"
        fi
    fi
    sleep 1
}

uninstall_extension() {
    local name="$1"
    echo ""
    echo -e "${BCYAN}>>> Removing extension: ${name}...${NC}"
    cd "$PTERODACTYL_DIR" || { echo -e "${BRED}Path not found!${NC}"; sleep 2; return; }

    # blueprint -r asks its own "are you sure? (y/n)" per extension - feed it
    # an endless stream of "y" so a bulk removal doesn't stop and wait on
    # every single one.
    yes y | blueprint -r "$name"
    blueprint_cache_fix

    local broken
    broken=$(find_broken_route_files)
    if [ -n "$broken" ]; then
        echo -e "${BRED}${BOLD}!!! Removing ${name} left a broken routes file - restoring from backup...${NC}"
        local f rel
        echo "$broken" | while read -r f; do
            [ -z "$f" ] && continue
            rel="${f#$PTERODACTYL_DIR/routes/}"
            if [ -f "$ROUTES_BACKUP_DIR/$rel" ]; then
                cp -a "$ROUTES_BACKUP_DIR/$rel" "$f"
                echo -e "${BGREEN}>>> Restored: routes/${rel}${NC}"
            fi
        done
        blueprint_cache_fix
    fi

    echo -e "${BGREEN}>>> ${name} removed!${NC}"
    sleep 2
}

