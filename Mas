#!/bin/bash
#
# ============================================================
#  MAS Gui - Pterodactyl Panel + Wings installer/manager
#  Run with: bash <(curl -s https://raw.githubusercontent.com/<you>/<repo>/main/mas-gui.sh)
# ============================================================

# ---------------- COLORS ----------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ============ CONFIG - EDIT THESE ============
# ---- Panel config ----
CFG_TIMEZONE="Asia/Kolkata"
CFG_EMAIL="ItzMASGaming@gmail.com"        # LE / panel email
CFG_ADMIN_EMAIL="itzmasgaming@gmail.com"
CFG_ADMIN_USERNAME="Itzmasgaming"
CFG_ADMIN_FIRSTNAME="itzmas"
CFG_ADMIN_LASTNAME="gaming"
CFG_ADMIN_PASSWORD="000000"
CFG_FQDN="cold-rabbit-94.telebit.io"

CFG_DB_NAME=""
CFG_DB_USER=""
CFG_DB_PASS=""
CFG_UFW="n"
CFG_LETSENCRYPT="y"
CFG_AGREE_HTTPS="y"
CFG_PROCEED_ANYWAY="y"
CFG_TELEMETRY="yes"
CFG_CONTINUE_INSTALL="y"
CFG_AGREE_TOS="y"
CFG_ASSUME_SSL="y"

PANEL_INSTALLER_URL="https://pterodactyl-installer.se/"
# ===============================================

# ---------------- HELPERS ----------------
banner() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "============================================"
    echo "                MAS Gui"
    echo "============================================"
    echo -e "${NC}"
}

pause() {
    echo ""
    read -rp "$(echo -e ${YELLOW}"Press ENTER to return to the menu..."${NC})" _
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${RED}This script must be run as root. Try: sudo bash $0${NC}"
        exit 1
    fi
}

# ============================================================
# PANEL - build answer sequences
# ============================================================
build_answers_fresh_install() {
    cat <<EOF
0
$CFG_DB_NAME
$CFG_DB_USER
$CFG_DB_PASS
$CFG_TIMEZONE
$CFG_EMAIL
$CFG_ADMIN_EMAIL
$CFG_ADMIN_USERNAME
$CFG_ADMIN_FIRSTNAME
$CFG_ADMIN_LASTNAME
$CFG_ADMIN_PASSWORD
$CFG_FQDN
$CFG_UFW
$CFG_LETSENCRYPT
$CFG_AGREE_HTTPS
$CFG_PROCEED_ANYWAY
$CFG_TELEMETRY
$CFG_CONTINUE_INSTALL
$CFG_AGREE_TOS
$CFG_ASSUME_SSL
EOF
}

build_answers_reinstall() {
    # Extra "y" right after mode select (0) to confirm overwrite.
    # Placement is UNVERIFIED against a live "existing install found" prompt -
    # test once and adjust if the real prompt lands elsewhere.
    cat <<EOF
0
