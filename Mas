blueprint_theme_menu() {
    while true; do
        banner
        echo -e "${CYAN}${BOLD}--- Blueprint Theme (cracked) ---${NC}"
        echo -e "  ${CYAN}1)${NC} Theme 1"
        echo -e "  ${CYAN}2)${NC} Theme 2"
        echo -e "  ${BRED}0)${NC} Exit"
        echo ""
        read -rp "$(echo -e ${CYAN}"Select an option: "${NC})" theme_choice

        case "$theme_choice" in
            1) run_blueprint_theme_1 ;;
            2) run_blueprint_theme_2 ;;
            0) return ;;
