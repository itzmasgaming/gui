}

pause() {
    echo ""
    read -rp "$(echo -e ${BYELLOW}"Press ENTER to return to the menu..."${NC})" _
}

check_root() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${BRED}This script must be run as root. Try: sudo bash $0${NC}"
        exit 1
    fi
}

# Fixes "System locale encoding is not UTF-8" FATAL errors from Blueprint.
fix_locale() {
    if ! locale -a 2>/dev/null | grep -qi "en_US.utf8\|en_US.UTF-8"; then
        apt-get install -y locales >/dev/null 2>&1
        sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen 2>/dev/null
        grep -q "^en_US.UTF-8 UTF-8" /etc/locale.gen 2>/dev/null || echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
        locale-gen en_US.UTF-8 >/dev/null 2>&1
        update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 >/dev/null 2>&1
    fi
    export LANG=en_US.UTF-8
    export LC_ALL=en_US.UTF-8
}

# Generates a random 6-char code and requires the user to type it back
# exactly before a destructive action proceeds. Returns 0 if confirmed.
confirm_destructive() {
    local label="$1"
    local code
    code=$(tr -dc 'A-Z0-9' </dev/urandom | head -c 6)
    echo ""
    echo -e "${BRED}${BOLD}!!! WARNING !!!${NC} This will uninstall: ${YELLOW}${label}${NC}"
    echo -e "${BRED}To confirm, type this exact code: ${YELLOW}${code}${NC}"
    read -rp "$(echo -e ${BCYAN}"Confirmation code: "${NC})" input_code
    if [ "$input_code" != "$code" ]; then
        echo -e "${BRED}Code did not match. Aborted.${NC}"
        sleep 2
        return 1
    fi
    return 0
}

# ============================================================
# CLOUDFLARE
# ============================================================
run_cloudflare_foreground() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        pause
        return
    fi
    echo ""
    read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi
    echo ""
    echo -e "${BCYAN}>>> Running Cloudflare tunnel in terminal (foreground)...${NC}"
    echo -e "${YELLOW}>>> Press Ctrl+C to stop. Closing this terminal will stop the tunnel.${NC}"
    echo ""
    sleep 1
    cloudflared tunnel run --protocol http2 --token "$cf_token"
    pause
}

run_cloudflare_background() {
    if ! command -v cloudflared >/dev/null 2>&1; then
        echo -e "${BRED}cloudflared is not installed on this system.${NC}"
        pause
        return
    fi
    echo ""
    read -rp "$(echo -e ${YELLOW}"Cloudflare tunnel token: "${NC})" cf_token
    if [ -z "$cf_token" ]; then
        echo -e "${BRED}Token is required. Aborting.${NC}"
        pause
        return
    fi

    echo -e "${BCYAN}>>> Creating cloudflared.service...${NC}"
    cat <<SERVICE_EOF > /etc/systemd/system/cloudflared.service
[Unit]
Description=Cloudflare Tunnel
After=network.target

[Service]
User=root
ExecStart=/usr/bin/cloudflared tunnel run --protocol http2 --token $cf_token
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SERVICE_EOF

    systemctl daemon-reload
    systemctl enable --now cloudflared
    systemctl status cloudflared --no-pager

    echo ""
    echo -e "${BCYAN}>>> Cloudflare tunnel running in background. Check logs anytime with:${NC}"
    echo -e "    ${YELLOW}journalctl -u cloudflared -f${NC}"
    pause
}

cloudflare_menu() {
    while true; do
        banner
        echo -e "${BCYAN}${BOLD}--- Cloudflare ---${NC}"
        echo -e "  ${BCYAN}1)${NC} Run in terminal (foreground)"
        echo -e "  ${BCYAN}2)${NC} Run in background (systemd)"
        echo -e "  ${BRED}0)${NC} Exit"
        echo ""
        read -rp "$(echo -e ${BCYAN}${BOLD}"Select an option: "${NC})" cf_choice

        case "$cf_choice" in
            1) run_cloudflare_foreground ;;
            2) run_cloudflare_background ;;
            0) return ;;
            *) echo -e "${BRED}Invalid option.${NC}"; sleep 1 ;;
        esac
    done
}

