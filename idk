function getGuildServerFolder(guildId) {
    const serverFolderPath = path.join(SERVERS_DIR, guildId);
    if (!fs.existsSync(serverFolderPath)) {
        fs.mkdirSync(serverFolderPath, { recursive: true });
    }
    return serverFolderPath;
}

function getGuildConfigFile(guildId) {
    return path.join(getGuildServerFolder(guildId), 'config.json');
}

function getGuildSettings(guildId) {
    if (!guildSettings.has(guildId)) {
        const configFile = getGuildConfigFile(guildId);
        if (fs.existsSync(configFile)) {
            try {
                const savedData = JSON.parse(fs.readFileSync(configFile, 'utf8'));
                guildSettings.set(guildId, Object.assign({}, defaultGuildConfig, savedData));
            } catch (e) {
                guildSettings.set(guildId, JSON.parse(JSON.stringify(defaultGuildConfig)));
            }
        } else {
            guildSettings.set(guildId, JSON.parse(JSON.stringify(defaultGuildConfig)));
            saveGuildSettings(guildId);
        }
    }
    return guildSettings.get(guildId);
}

function saveGuildSettings(guildId) {
    try {
        const configFile = getGuildConfigFile(guildId);
        const configToSave = guildSettings.get(guildId) || defaultGuildConfig;
        fs.writeFileSync(configFile, JSON.stringify(configToSave, null, 2));
    } catch (err) {
        console.error(`${clr.red}❌ Error saving config for server ${guildId}: ${err.message}${clr.reset}`);
    }
}

function savePersistentConfig() {
    for (const [gId] of guildSettings.entries()) {
        saveGuildSettings(gId);
    }
}

function loadPersistentConfig() {
    try {
        if (fs.existsSync(SERVERS_DIR)) {
            const serverFolders = fs.readdirSync(SERVERS_DIR);
            for (const gId of serverFolders) {
                const configFile = path.join(SERVERS_DIR, gId, 'config.json');
                if (fs.existsSync(configFile)) {
                    const savedData = JSON.parse(fs.readFileSync(configFile, 'utf8'));
                    guildSettings.set(gId, Object.assign({}, defaultGuildConfig, savedData));
                }
            }
            console.log(`${clr.green}✅ Per-server persistent configuration loaded successfully from ./servers/${clr.reset}`);
        }
    } catch (err) {
        console.error(`${clr.red}❌ Error loading persistent configs: ${err.message}${clr.reset}`);
    }
}

