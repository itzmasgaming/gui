// --- UPDATED & FIXED OLLAMA AI ENGINE WITH TIMEOUT, RAM CONTROL & EXCEPTION HANDLING ---
async function askOllama(promptText, systemPrompt = PUBLIC_AI_PROMPT) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000); // 15-second timeout safeguard

    try {
        const response = await fetch('http://127.0.0.1:11434/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            signal: controller.signal,
            body: JSON.stringify({
                model: AI_MODEL_NAME,
                messages: [
                    { role: 'system', content: systemPrompt },
                    { role: 'user', content: promptText }
                ],
                stream: false,
                options: {
                    num_ctx: 1024 // Restricts context memory usage for low-RAM setups
                }
            })
        });

        clearTimeout(timeout);

        if (!response.ok) {
            console.error(`${clr.red}[AI ERROR] HTTP ${response.status} - ${response.statusText}${clr.reset}`);
            return '⚠️ The local AI service returned an error. Please try again.';
        }

        const data = await response.json();
        return data.message?.content || '⚠️ Received empty response from AI.';
    } catch (err) {
        clearTimeout(timeout);
        if (err.name === 'AbortError') {
            console.error(`${clr.red}[AI ERROR] Request timed out after 15s.${clr.reset}`);
            return '⏱️ AI request timed out. The server is under heavy load.';
        }
        console.error(`${clr.red}[AI ERROR] Connection failed: ${err.message}${clr.reset}`);
        return '❌ Unable to connect to local AI service. Ensure Ollama is running.';
    }
}

function startDynamicProfilePresence(client) {
    setInterval(async () => {
        let foundMember = null;
        for (const [guildId, guild] of client.guilds.cache) {
            try {
                const member = await guild.members.fetch({ user: TARGET_USER_ID, force: true }).catch(() => null);
                if (member) {
                    foundMember = member;
                    break;
                }
            } catch (e) {}
        }

        if (foundMember && foundMember.presence) {
            const presence = foundMember.presence;
            const currentStatus = presence.status || 'offline';
            let mappedActivities = presence.activities.map(act => ({
                name: act.name,
                type: act.type,
                url: act.url,
                state: act.state,
                details: act.details
            }));

            try {
                client.user.setPresence({
                    activities: mappedActivities,
                    status: currentStatus === 'offline' ? 'invisible' : currentStatus
                });
            } catch (e) {}
        } else {
            try {
                client.user.setPresence({ activities: [], status: 'invisible' });
            } catch (e) {}
        }
    }, 5000);
}

async function syncUserBannerToBot(client, userId) {
    try {
        const targetUser = await client.users.fetch(userId, { force: true });
        const bannerUrl = targetUser.bannerURL({ size: 1024, extension: 'png' });

        if (bannerUrl) {
            await client.user.setBanner(bannerUrl);
            console.log(`${clr.green}✅ Bot banner synced with user ${targetUser.tag}!${clr.reset}`);
        }
    } catch (err) {
        console.error(`${clr.red}❌ Failed to sync banner: ${err.message}${clr.reset}`);
    }
}

function buildInviteResponsePayload(guild, user) {
    const stats = getGuildInviteStats(guild.id);
    const netInvites = Math.max(0, stats.joins - stats.left - stats.fake - stats.rejoins);
    const botInviteLink = `https://discord.com/oauth2/authorize?client_id=${masterBot.user.id}&permissions=8&scope=bot%20applications.commands`;

    const embed = new EmbedBuilder()
        .setTitle('📊 Server Invite Statistics')
        .setThumbnail(user.displayAvatarURL({ dynamic: true, size: 512 }))
        .setDescription(
            `>>> **${user.username}** Net Invites: **${netInvites}**\n\n` +
            `📥 **Joins :** ${stats.joins}\n` +
            `📤 **Left :** ${stats.left}\n` +
            `⚠️ **Fake :** ${stats.fake}\n` +
            `🔄 **Rejoins :** ${stats.rejoins} **(14d)**`
        )
        .setColor('#00FFFF') // Aqua
        .setFooter({ 
            text: `Requested by ${user.username}`, 
            iconURL: user.displayAvatarURL({ dynamic: true }) 
        })
        .setTimestamp();

    const row = new ActionRowBuilder().addComponents(
        new ButtonBuilder()
            .setLabel('Bot Invite')
            .setStyle(ButtonStyle.Link)
            .setURL(botInviteLink)
    );

    return { embeds: [embed], components: [row] };
}

