const snipeCache = new Map();
const editSnipeCache = new Map();

masterBot.on('messageDelete', (message) => {
    if (!message.guild || message.author?.bot) return;
    snipeCache.set(message.channel.id, {
        content: message.content || '[Embed or Attachment]',
        author: message.author,
        timestamp: Date.now()
    });
});

masterBot.on('messageUpdate', (oldMessage, newMessage) => {
    if (!newMessage.guild || newMessage.author?.bot || oldMessage.content === newMessage.content) return;
    editSnipeCache.set(newMessage.channel.id, {
        oldContent: oldMessage.content || '[Content]',
        newContent: newMessage.content || '[Content]',
        author: newMessage.author,
        timestamp: Date.now()
    });
});

masterBot.on('messageCreate', async (message) => {
    if (message.author.bot || !message.guild) return;

    const safetyCfg = getGuildSafetyConfig(message.guild.id);
    if (safetyCfg.antispam) {
        const now = Date.now();
        const spamKey = `${message.guild.id}-${message.author.id}`;
        let history = messageSpamTracker.get(spamKey) || [];
        history = history.filter(t => now - t < 5000);
        history.push(now);
        messageSpamTracker.set(spamKey, history);

        if (history.length >= 5) {
            const member = message.member;
            if (member && member.moderatable) {
                try {
                    await member.timeout(5 * 60 * 1000, 'Anti-Spam: Sending messages too quickly.');
                    message.channel.send(`🔇 **${message.author}** has been automatically muted for 5 minutes due to spamming.`).then(m => setTimeout(() => m.delete().catch(() => {}), 5000));

                    const reportChan = message.guild.channels.cache.get(safetyCfg.reportChannelId);
                    if (reportChan) {
                        reportChan.send(`🛡️ **Anti-Spam Report:** Muted **${message.author.tag}** for spamming in ${message.channel}.`).catch(() => {});
                    }
                } catch (e) {}
            }
        }
    }

    const isTargetedByPing = message.content.includes(TARGET_USER_ID) || message.mentions.has(masterBot.user);

    if (isTargetedByPing) {
        let cleanPrompt = message.content
            .replace(/<@!?\d+>/g, '')
            .replace(TARGET_USER_ID, '')
            .trim();

        if (!cleanPrompt) cleanPrompt = "Hello!";

        await message.channel.sendTyping();

        try {
            const userIsAdmin = isAIAdmin(message);
            const systemPrompt = userIsAdmin ? ADMIN_AI_PROMPT : PUBLIC_AI_PROMPT;
            const aiReply = await askOllama(cleanPrompt, systemPrompt);

            if (userIsAdmin) {
                const bashMatch = aiReply.match(/```bash\n([\s\S]*?)\n```/);
                if (bashMatch) {
                    const commandToRun = bashMatch[1].trim();
                    await message.channel.send(`⚙️ **Executing Admin Command:** \`${commandToRun}\``);

                    exec(commandToRun, { timeout: 10000 }, (error, stdout, stderr) => {
                        let output = stdout || stderr || "Command completed with no output.";
                        if (error && !stdout && !stderr) output = error.message;
                        message.channel.send(`\`\`\`\n${output.slice(0, 1900)}\n\`\`\``);
                    });
                    return;
                }
            }

            return message.channel.send(aiReply);

        } catch (err) {
            console.error(`${clr.red}Ollama AI Error: ${err.message}${clr.reset}`);
            return message.channel.send("❌ Internal Local AI engine error.");
        }
    }

    if (afkUsers.has(message.author.id)) {
        afkUsers.delete(message.author.id);
        message.reply('👋 Welcome back! Your AFK status has been removed.').then(m => setTimeout(() => m.delete().catch(() => {}), 5000));
    }

    for (const [mentionedUser, afkData] of afkUsers.entries()) {
        if (message.mentions.users.has(mentionedUser)) {
            message.reply(`💤 <@${mentionedUser}> is currently AFK: **${afkData.reasonNote}** (${afkData.time})`);
            break;
        }
    }

    if (stickyMessages.has(message.channel.id)) {
        const sticky = stickyMessages.get(message.channel.id);
        if (sticky.lastMessage) {
            try { await sticky.lastMessage.delete(); } catch (e) {}
        }
        const sent = await message.channel.send({ content: `📌 **Sticky Message:**\n${sticky.text}` });
        sticky.lastMessage = sent;
    }

    const contentTrimmed = message.content.trim().toLowerCase();
    if (['data-i', 'invite', 'invites', '-invite', '-i'].includes(contentTrimmed)) {
        const payload = buildInviteResponsePayload(message.guild, message.author);
        return message.reply(payload);
    }
    if (['-m', '-message', '/message', '/m'].includes(contentTrimmed)) {
        const payload = buildMessageResponsePayload(message.guild, message.author);
        return message.reply(payload);
    }

    const contentLower = message.content.toLowerCase();
    if (autoResponders.has(contentLower)) {
        message.channel.send(autoResponders.get(contentLower));
    }
});

