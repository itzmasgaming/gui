        if (!autoResponders.has(trigger)) return interaction.reply({ content: '❌ Trigger not found.', ephemeral: true });
        autoResponders.set(trigger, newResp);
        return interaction.reply({ content: `✅ Updated response for \`${trigger}\``, ephemeral: true });
    }

    if (commandName === 'ticket-setup') {
        const row = new ActionRowBuilder().addComponents(
            new ButtonBuilder()
                .setCustomId('open_ticket_node')
                .setLabel(config.ticketButtonLabel)
                .setStyle(ButtonStyle.Primary)
        );
        const emb = new EmbedBuilder()
            .setTitle('🎫 Support Desk')
            .setDescription('Click below to open a private support ticket channel.')
            .setColor('#00FFFF');

        await channel.send({ embeds: [emb], components: [row] });
        return interaction.reply({ content: '✅ Support ticket panel created.', ephemeral: true });
    }

    if (commandName === 'server-poll') {
        const question = options.getString('question');
        const row = new ActionRowBuilder().addComponents(
            new ButtonBuilder().setCustomId('poll_yes').setLabel('👍 Yes').setStyle(ButtonStyle.Success),
            new ButtonBuilder().setCustomId('poll_no').setLabel('👎 No').setStyle(ButtonStyle.Danger)
        );
        const emb = new EmbedBuilder()
            .setTitle('📊 Community Poll')
            .setDescription(question)
            .setColor('#FFAA00');

        return interaction.reply({ embeds: [emb], components: [row] });
    }

    if (commandName === 'say') {
        const text = options.getString('text');
        const targetChan = options.getChannel('channel') || channel;
        await targetChan.send(text);
        return interaction.reply({ content: '✅ Message delivered.', ephemeral: true });
    }

    if (commandName === 'dm') {
        const targetUser = options.getUser('user');
        const msgText = options.getString('message');
        try {
            await targetUser.send(`📩 **Direct Message:** ${msgText}`);
            return interaction.reply({ content: `✅ Sent DM to ${targetUser.tag}`, ephemeral: true });
        } catch (e) {
            return interaction.reply({ content: `❌ Cannot DM ${targetUser.tag} (DMs closed).`, ephemeral: true });
        }
    }

    if (commandName === 'edit') {
        const sub = options.getSubcommand();
        if (sub === 'ticket_button') {
            const label = options.getString('label');
            config.ticketButtonLabel = label;
            saveGuildSettings(guild.id);
            return interaction.reply({ content: `✅ Updated support ticket button label to: **${label}**`, ephemeral: true });
        }
        if (sub === 'auto_role') {
            const role = options.getRole('role');
            config.autoRoleId = role.id;
            saveGuildSettings(guild.id);
            return interaction.reply({ content: `✅ Set auto-role to ${role}`, ephemeral: true });
        }
    }

    if (commandName === 'masterprofile') {
        const sub = options.getSubcommand();
        if (sub === 'banner') {
            const url = options.getString('url');
            await masterBot.user.setBanner(url);
            return interaction.reply({ content: '✅ Bot banner updated successfully!', ephemeral: true });
        }
        if (sub === 'avatar') {
            const url = options.getString('url');
            await masterBot.user.setAvatar(url);
            return interaction.reply({ content: '✅ Bot avatar updated successfully!', ephemeral: true });
        }
        if (sub === 'name') {
            const newName = options.getString('new_name');
            await masterBot.user.setUsername(newName);
            return interaction.reply({ content: `✅ Bot username updated to **${newName}**!`, ephemeral: true });
        }
    }

    if (commandName === 'createbot') {
        const botName = options.getString('name');
        const token = options.getString('token');

        if (masterBot.subBots.has(botName)) {
            return interaction.reply({ content: `❌ A child bot named \`${botName}\` is already active.`, ephemeral: true });
        }

        await interaction.deferReply({ ephemeral: true });
        try {
            const childClient = new Client({ intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages] });
            await childClient.login(token);
            masterBot.subBots.set(botName, { client: childClient, token });
            return interaction.editReply({ content: `✅ **Child Bot Deployed:** Logged in as \`${childClient.user.tag}\`.` });
        } catch (e) {
            return interaction.editReply({ content: `❌ Failed to boot child bot: ${e.message}` });
        }
    }

    if (commandName === 'statusbots') {
        if (masterBot.subBots.size === 0) return interaction.reply({ content: 'ℹ️ Info: No active child sub-bots currently running.', ephemeral: true });
        let list = [];
        for (let [name, data] of masterBot.subBots.entries()) {
            list.push(`• **${name}**: ${data.client.user.tag} (ID: ${data.client.user.id})`);
        }
        return interaction.reply({ content: `🤖 **Active Child Bots:**\n${list.join('\n')}`, ephemeral: true });
    }

    if (commandName === 'stopbot') {
        const name = options.getString('name');
        if (!masterBot.subBots.has(name)) return interaction.reply({ content: `❌ No active child bot found with label \`${name}\`.`, ephemeral: true });
        const subBotData = masterBot.subBots.get(name);
        await subBotData.client.destroy();
        masterBot.subBots.delete(name);
        return interaction.reply({ content: `🛑 Child bot \`${name}\` has been stopped and unloaded.`, ephemeral: true });
    }

    if (commandName === 'invitetracker') {
        const logChannel = options.getChannel('channel');
        config.inviteTrackerChannel = logChannel.id;
        saveGuildSettings(guild.id);
        return interaction.reply({ content: `✅ Invite tracker logs directed to ${logChannel}.`, ephemeral: true });
    }

    if (commandName === 'dmeveryone') {
        const msg = options.getString('message');
        await interaction.deferReply({ ephemeral: true });
        let sentCount = 0;
        for (const [id, mem] of guild.members.cache) {
            if (!mem.user.bot) {
                try {
                    await mem.send(`📢 **Server Broadcast from ${guild.name}:**\n${msg}`);
                    sentCount++;
                } catch (e) {}
            }
        }
        return interaction.editReply({ content: `✅ Broadcast sent to **${sentCount}** members.` });
    }

    // --- HANDLERS FOR UTILITY COMMANDS ---
    if (commandName === 'calculator') {
        const expr = options.getString('expression');
        try {
            const sanitized = expr.replace(/[^0-9+\-*/().%]/g, '');
            const result = Function(`'use strict'; return (${sanitized})`)();
            return interaction.reply({ content: `🔢 Result: \`${expr} = ${result}\`` });
        } catch (e) {
            return interaction.reply({ content: `❌ Invalid mathematical expression.`, ephemeral: true });
        }
    }

    if (commandName === 'roll') {
        const sides = options.getInteger('sides') || 6;
        const rolled = Math.floor(Math.random() * sides) + 1;
        return interaction.reply({ content: `🎲 You rolled a **${rolled}** (1-${sides}).` });
    }

    if (commandName === 'coinflip') {
        const outcome = Math.random() < 0.5 ? 'Heads 🪙' : 'Tails 🪙';
        return interaction.reply({ content: `🪙 Coin Flip Outcome: **${outcome}**` });
    }

    if (commandName === '8ball') {
        const q = options.getString('question');
        const answers = [
            'Yes, definitely.', 'It is certain.', 'Without a doubt.', 'Reply hazy, try again.',
            'Ask again later.', 'Better not tell you now.', 'My sources say no.', 'Outlook not so good.'
        ];
        const ans = answers[Math.floor(Math.random() * answers.length)];
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle('🎱 Magic 8-Ball').addFields({ name: 'Question', value: q }, { name: 'Answer', value: ans }).setColor('#00FFFF')] });
    }

    if (commandName === 'ascii') {
        const txt = options.getString('text');
        return interaction.reply({ content: `\`\`\`text\n[ASCII] >>> ${txt}\n\`\`\`` });
    }

    if (commandName === 'reverse') {
        const txt = options.getString('text');
        const rev = txt.split('').reverse().join('');
        return interaction.reply({ content: `🔄 Reversed: \`${rev}\`` });
    }

    if (commandName === 'base64-encode') {
        const txt = options.getString('text');
        const encoded = Buffer.from(txt).toString('base64');
        return interaction.reply({ content: `🔒 Encoded: \`${encoded}\``, ephemeral: true });
    }

    if (commandName === 'base64-decode') {
        const txt = options.getString('text');
        try {
            const decoded = Buffer.from(txt, 'base64').toString('utf8');
            return interaction.reply({ content: `🔓 Decoded: \`${decoded}\``, ephemeral: true });
        } catch (e) {
            return interaction.reply({ content: `❌ Invalid Base64 string.`, ephemeral: true });
        }
    }

    if (commandName === 'password-gen') {
        const len = options.getInteger('length') || 12;
        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$!';
        let pass = '';
        for (let i = 0; i < len; i++) pass += chars.charAt(Math.floor(Math.random() * chars.length));
        return interaction.reply({ content: `🔑 Generated Password: \`${pass}\``, ephemeral: true });
    }

    if (commandName === 'qr') {
        const txt = options.getString('text');
        const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(txt)}`;
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle('📱 QR Code Generator').setImage(qrUrl).setColor('#00FFFF')] });
    }

    if (commandName === 'colorinfo') {
        const hex = options.getString('color') || options.getString('hex');
        return interaction.reply({ content: `🎨 Color details for \`${hex}\``, ephemeral: true });
    }

    if (commandName === 'reminder') {
        const mins = options.getInteger('minutes');
        const task = options.getString('task');
        const remId = Math.random().toString(36).substring(2, 7);
        
        let rems = userReminders.get(user.id) || [];
        
        const timer = setTimeout(() => {
            user.send(`⏰ **Reminder Alert:** ${task}`).catch(() => {});
            let current = userReminders.get(user.id) || [];
            userReminders.set(user.id, current.filter(r => r.id !== remId));
        }, mins * 60 * 1000);

        const remObj = { id: remId, task, time: Date.now() + mins * 60000, timer };
        rems.push(remObj);
        userReminders.set(user.id, rems);

        return interaction.reply({ content: `⏰ Reminder set for **${mins} minutes** from now: "${task}" (ID: \`${remId}\`)`, ephemeral: true });
    }

    if (commandName === 'servericon') {
        const icon = guild.iconURL({ dynamic: true, size: 1024 });
        if (!icon) return interaction.reply({ content: '❌ Server has no icon.', ephemeral: true });
        return interaction.reply({ content: icon });
    }

    if (commandName === 'serverbanner') {
        const banner = guild.bannerURL({ size: 1024 });
        if (!banner) return interaction.reply({ content: '❌ Server has no banner.', ephemeral: true });
        return interaction.reply({ content: banner });
    }

    if (commandName === 'roleinfo') {
        const r = options.getRole('role');
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle(`🏷️ Role Info: ${r.name}`).addFields({ name: 'ID', value: r.id }, { name: 'Color', value: r.hexColor }, { name: 'Members', value: `${r.members.size}` }).setColor(r.color)] });
    }

    if (commandName === 'channelinfo') {
        const c = options.getChannel('channel') || channel;
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle(`📺 Channel Info: ${c.name}`).addFields({ name: 'ID', value: c.id }, { name: 'Type', value: `${c.type}` }, { name: 'Created', value: `<t:${Math.floor(c.createdTimestamp / 1000)}:R>` }).setColor('#00FFFF')] });
    }

    if (commandName === 'membercount') {
        return interaction.reply({ content: `👥 **Total Members:** ${guild.memberCount} | **Bots:** ${guild.members.cache.filter(m => m.user.bot).size}` });
    }

    if (commandName === 'emojis') {
        const ems = guild.emojis.cache.map(e => e.toString()).join(' ') || 'No custom emojis.';
        return interaction.reply({ content: `😃 **Server Emojis:**\n${ems.slice(0, 1900)}`, ephemeral: true });
    }

    if (commandName === 'boosters') {
        const boosters = guild.premiumSubscriberRole ? guild.premiumSubscriberRole.members.map(m => m.user.tag).join(', ') : 'None';
        return interaction.reply({ content: `🚀 **Server Boosters:** ${boosters}` });
    }

    if (commandName === 'snipe') {
        const sniped = snipeCache.get(channel.id);
        if (!sniped) return interaction.reply({ content: '❌ No recently deleted messages found.', ephemeral: true });
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle(`🗑️ Sniped Message by ${sniped.author.tag}`).setDescription(sniped.content).setTimestamp(sniped.timestamp).setColor('#FF0000')] });
    }

    if (commandName === 'editsnipe') {
        const sniped = editSnipeCache.get(channel.id);
        if (!sniped) return interaction.reply({ content: '❌ No recently edited messages found.', ephemeral: true });
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle(`✏️ Edit Snipe by ${sniped.author.tag}`).addFields({ name: 'Before', value: sniped.oldContent }, { name: 'After', value: sniped.newContent }).setTimestamp(sniped.timestamp).setColor('#FFAA00')] });
    }

    if (commandName === 'poll-multi') {
        const question = options.getString('question');
        const opts = options.getString('options').split(',').map(o => o.trim()).slice(0, 4);
        const emojis = ['1️⃣', '2️⃣', '3️⃣', '4️⃣'];
        let desc = opts.map((o, i) => `${emojis[i]} ${o}`).join('\n\n');
        
        await interaction.deferReply();
        const msg = await interaction.followUp({ embeds: [new EmbedBuilder().setTitle(`📊 ${question}`).setDescription(desc).setColor('#00FFFF')] });
        for (let i = 0; i < opts.length; i++) await msg.react(emojis[i]);
        return;
    }

    if (commandName === 'giveaway-start') {
        const prize = options.getString('prize');
        const mins = options.getInteger('minutes');
        
        await interaction.deferReply();
        const msg = await interaction.followUp({ embeds: [new EmbedBuilder().setTitle(`🎉 GIVEAWAY: ${prize}`).setDescription(`React with 🎉 to enter!\nDuration: **${mins} minutes**`).setColor('#00FFFF')] });
        await msg.react('🎉');
        return;
    }

    if (commandName === 'weather') {
        const city = options.getString('city');
        return interaction.reply({ content: `🌤️ Simulated Weather for **${city}**: 22°C, Sunny with gentle breeze.` });
    }

    if (commandName === 'fact') {
        const facts = ['Honey never spoils.', 'Bananas are berries, but strawberries are not.', 'Octopuses have three hearts.'];
        return interaction.reply({ content: `💡 **Did you know?** ${facts[Math.floor(Math.random() * facts.length)]}` });
    }

    if (commandName === 'joke') {
        const jokes = ['Why don’t skeletons fight each other? They don’t have the guts.', 'What do you call fake spaghetti? An impasta!'];
        return interaction.reply({ content: `😂 ${jokes[Math.floor(Math.random() * jokes.length)]}` });
    }

    if (commandName === 'quote') {
        const quotes = ['"The best way to get started is to quit talking and begin doing." - Walt Disney', '"Life is what happens when you\'re busy making other plans." - John Lennon'];
        return interaction.reply({ content: `📜 ${quotes[Math.floor(Math.random() * quotes.length)]}` });
    }

    if (commandName === 'coinprice') {
        return interaction.reply({ content: `🪙 **Simulated Crypto Tickers:**\n• Bitcoin (BTC): $94,500 (+2.4%)\n• Ethereum (ETH): $3,100 (+1.8%)` });
    }

    if (commandName === 'embed-json') {
        const json = options.getString('json');
        try {
            const parsed = JSON.parse(json);
            return interaction.reply({ embeds: [parsed] });
        } catch (e) {
            return interaction.reply({ content: '❌ Invalid JSON provided.', ephemeral: true });
        }
    }

    if (commandName === 'embed-color') {
        const messageId = options.getString('message_id');
        const color = options.getString('color');
        try {
            const msg = await channel.messages.fetch(messageId);
            const emb = EmbedBuilder.from(msg.embeds[0]).setColor(color);
            await msg.edit({ embeds: [emb] });
            return interaction.reply({ content: '✅ Embed color updated successfully!', ephemeral: true });
        } catch (e) {
            return interaction.reply({ content: '❌ Could not find message ID in this channel.', ephemeral: true });
        }
    }

    if (commandName === 'rolecolor') {
        const role = options.getRole('role');
        const color = options.getString('color');
        await role.setColor(color);
        return interaction.reply({ content: `✅ Changed ${role.name} color to \`${color}\`.` });
    }

    if (commandName === 'rolename') {
        const role = options.getRole('role');
        const name = options.getString('name');
        await role.setName(name);
        return interaction.reply({ content: `✅ Renamed role to \`${name}\`.` });
    }

    if (commandName === 'roleicon') {
        const role = options.getRole('role');
        const url = options.getString('url');
        try {
            await role.setIcon(url);
            return interaction.reply({ content: `✅ Updated icon for ${role.name}.` });
        } catch (e) {
            return interaction.reply({ content: '❌ Failed to update role icon (requires Boost Level 2).', ephemeral: true });
        }
    }

    if (commandName === 'createrole') {
        const name = options.getString('name');
        const color = options.getString('color') || '#FFFFFF';
        const newRole = await guild.roles.create({ name, color });
        return interaction.reply({ content: `✅ Created role ${newRole}.` });
    }

    if (commandName === 'deleterole') {
        const role = options.getRole('role');
        const name = role.name;
        await role.delete();
        return interaction.reply({ content: `🗑️ Deleted role \`${name}\`.` });
    }

    if (commandName === 'createchannel') {
        const name = options.getString('name');
        const newChan = await guild.channels.create({ name, type: ChannelType.GuildText });
        return interaction.reply({ content: `✅ Created text channel ${newChan}.` });
    }

    if (commandName === 'deletechannel') {
        const targetChan = options.getChannel('channel') || channel;
        const name = targetChan.name;
        if (targetChan.id === channel.id) {
            await interaction.reply({ content: `🗑️ Deleting current channel...` });
            await targetChan.delete();
            return;
        }
        await targetChan.delete();
        return interaction.reply({ content: `🗑️ Deleted channel \`${name}\`.` });
    }

    if (commandName === 'channelname') {
        const name = options.getString('name');
        await channel.setName(name);
        return interaction.reply({ content: `✅ Renamed current channel to \`${name}\`.` });
    }

    if (commandName === 'channeltopic') {
        const topic = options.getString('topic');
        await channel.setTopic(topic);
        return interaction.reply({ content: `✅ Updated channel topic.` });
    }

    if (commandName === 'invites-check') {
        const targetUser = options.getUser('user');
        const stats = getGuildInviteStats(guild.id);
        return interaction.reply({ content: `📊 Invite stats check for ${targetUser.tag}: Joins: ${stats.joins}` });
    }

    if (commandName === 'invites-clear') {
        inviteStats.delete(guild.id);
        return interaction.reply({ content: `🗑️ Invite stats cache cleared for this server.` });
    }

    if (commandName === 'member-search') {
        const q = options.getString('query').toLowerCase();
        const found = guild.members.cache.filter(m => m.user.tag.toLowerCase().includes(q)).map(m => m.user.tag).slice(0, 10).join(', ');
        return interaction.reply({ content: `🔍 **Search Results:** ${found || 'No matching members found.'}`, ephemeral: true });
    }

    if (commandName === 'deafen') {
        const targetMember = options.getMember('user');
        if (!targetMember.voice.channel) return interaction.reply({ content: '❌ User is not in a voice channel.', ephemeral: true });
        await targetMember.voice.setDeaf(true);
        return interaction.reply({ content: `🔇 Deafened ${targetMember.user.tag}.` });
    }

    if (commandName === 'undeafen') {
        const targetMember = options.getMember('user');
        if (!targetMember.voice.channel) return interaction.reply({ content: '❌ User is not in a voice channel.', ephemeral: true });
        await targetMember.voice.setDeaf(false);
        return interaction.reply({ content: `🔊 Undeafened ${targetMember.user.tag}.` });
    }

    if (commandName === 'movemember') {
        const targetMember = options.getMember('user');
        const chanId = options.getString('channel_id');
        if (!targetMember.voice.channel) return interaction.reply({ content: '❌ User is not in a voice channel.', ephemeral: true });
        try {
            await targetMember.voice.setChannel(chanId);
            return interaction.reply({ content: `✈️ Moved ${targetMember.user.tag} to new voice channel.` });
        } catch (e) {
            return interaction.reply({ content: '❌ Failed to move user (invalid channel ID).', ephemeral: true });
        }
    }

    if (commandName === 'voicekick') {
        const targetMember = options.getMember('user');
        if (!targetMember.voice.channel) return interaction.reply({ content: '❌ User is not in a voice channel.', ephemeral: true });
        await targetMember.voice.disconnect();
        return interaction.reply({ content: `👢 Disconnected ${targetMember.user.tag} from voice.` });
    }

    if (commandName === 'embed-banner') {
        const messageId = options.getString('message_id');
        const url = options.getString('url');
        try {
            const msg = await channel.messages.fetch(messageId);
            const emb = EmbedBuilder.from(msg.embeds[0]).setImage(url);
            await msg.edit({ embeds: [emb] });
            return interaction.reply({ content: '✅ Embed banner updated successfully!', ephemeral: true });
        } catch (e) {
            return interaction.reply({ content: '❌ Could not find message ID in this channel.', ephemeral: true });
        }
    }

    if (commandName === 'say-embed') {
        const text = options.getString('text');
        return interaction.reply({ embeds: [new EmbedBuilder().setDescription(text).setColor('#00FFFF')] });
    }

    if (commandName === 'ping-check') {
        return interaction.reply({ content: `📡 Network diagnostic link operational. WebSocket: ${masterBot.ws.ping}ms` });
    }

    if (commandName === 'bot-stats') {
        const memUsage = process.memoryUsage();
        return interaction.reply({ embeds: [new EmbedBuilder().setTitle('📊 VPS Bot Diagnostics').addFields({ name: 'RSS Memory', value: `\`${Math.round(memUsage.rss / 1024 / 1024)} MB\``, inline: true }, { name: 'Heap Total', value: `\`${Math.round(memUsage.heapTotal / 1024 / 1024)} MB\``, inline: true }).setColor('#00FFFF')], ephemeral: true });
    }

    // --- HANDLERS FOR 20 NEW NON-ADMIN PUBLIC COMMANDS ---
    if (commandName === 'poll-close') {
        const messageId = options.getString('message_id');
        if (!pollVotes.has(messageId)) return interaction.reply({ content: '❌ Active poll record not found.', ephemeral: true });
        const poll = pollVotes.get(messageId);
        pollVotes.delete(messageId);
        return interaction.reply({ content: `📊 **Poll Closed!** Final Results — 👍 Yes: **${poll.yes}** | 👎 No: **${poll.no}** (Total Voters: ${poll.voters.size})` });
    }

    if (commandName === 'giveaway-end') {
        const messageId = options.getString('message_id');
        try {
            const msg = await channel.messages.fetch(messageId);
            const reaction = msg.reactions.cache.get('🎉');
            if (!reaction) return interaction.reply({ content: '❌ Giveaway reaction data not found on message.', ephemeral: true });
            const users = await reaction.users.fetch();
            const validUsers = users.filter(u => !u.bot);
            if (validUsers.size === 0) return interaction.reply({ content: '🎉 No valid human entrants joined the giveaway.' });
            const winner = validUsers.random();
            return interaction.reply({ content: `🎉 **Giveaway Ended!** Winner: ${winner}` });
        } catch (e) {
            return interaction.reply({ content: '❌ Failed to fetch giveaway message.', ephemeral: true });
        }
    }
});

masterBot.login(process.env.DISCORD_TOKEN);
