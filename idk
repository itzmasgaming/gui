// --- CHANNEL DELETION MONITOR (ANTI-NUKE & AUTO-BAN / AUTO-LEAVE) ---
masterBot.on('channelDelete', async (channel) => {
    if (!channel.guild) return;
    const guild = channel.guild;
    const config = getGuildSafetyConfig(guild.id);
    if (!config.antinuke) return;

    const whitelistedChannels = getGuildWhitelist(guild.id);
    if (whitelistedChannels.has(channel.id)) return;

    try {
        const fetchedLogs = await guild.fetchAuditLogs({
            limit: 1,
            type: 12
        });
        const deletionLog = fetchedLogs.entries.first();
        if (!deletionLog) return;

        const { executor } = deletionLog;
        if (!executor) return;

        if (executor.id === masterBot.user.id) {
            const now = Date.now();
            const key = `${guild.id}-${executor.id}`;
            let history = channelDeleteTracker.get(key) || [];
            history = history.filter(t => now - t < 15000);
            history.push(now);
            channelDeleteTracker.set(key, history);

            if (history.length >= 2) {
                const reportChan = guild.channels.cache.get(config.reportChannelId);
                if (reportChan) {
                    await reportChan.send(`🚨 **EMERGENCY SAFETY TRIGGER:** I detected myself deleting multiple channels under 15 seconds. Auto-leaving server **${guild.name}** for safety.`).catch(() => {});
                }
                return await guild.leave();
            }
            return;
        }

        const trusted = trustedBots.get(guild.id);
        if (trusted && trusted.has(executor.id)) return;

        const now = Date.now();
        const key = `${guild.id}-${executor.id}`;
        let history = channelDeleteTracker.get(key) || [];
        history = history.filter(t => now - t < 10000);
        history.push(now);
        channelDeleteTracker.set(key, history);

        if (history.length >= 2) {
            const member = await guild.members.fetch(executor.id).catch(() => null);
            const reportChan = guild.channels.cache.get(config.reportChannelId);

            if (executor.bot) {
                if (member && member.bannable) {
                    await guild.members.ban(executor.id, { reason: 'Anti-Nuke: Deleted 2+ channels in under 10 seconds.' });
                }
                if (reportChan) {
                    await reportChan.send({
                        embeds: [
                            new EmbedBuilder()
                                .setTitle('🛡️ Anti-Nuke Triggered: Bot Banned')
                                .setDescription(`The rogue bot **${executor.tag}** (\`${executor.id}\`) deleted **${history.length} channels** in under 10 seconds and has been **banned** automatically.`)
                                .setColor('#FF0000')
                                .setTimestamp()
                        ]
                    }).catch(() => {});
                }
            } else {
                if (reportChan) {
                    await reportChan.send({
                        embeds: [
                            new EmbedBuilder()
                                .setTitle('🛡️ Anti-Nuke Triggered: User Alert')
                                .setDescription(`User **${executor.tag}** (\`${executor.id}\`) deleted **${history.length} channels** rapidly.`)
                                .setColor('#FFAA00')
                                .setTimestamp()
                        ]
                    }).catch(() => {});
                }
            }
        }
    } catch (err) {
        console.error(`Error in channelDelete anti-nuke handler:`, err);
    }
});

// --- MEMBER JOIN (STAT CALCULATOR & TRACKER) ---
masterBot.on('guildMemberAdd', async (member) => {
    const stats = getGuildInviteStats(member.guild.id);
    const now = Date.now();
    const config = getGuildSettings(member.guild.id);

    const ninetyDaysMs = 90 * 24 * 60 * 60 * 1000;
    const accountAgeMs = now - member.user.createdTimestamp;
    if (accountAgeMs < ninetyDaysMs) {
        stats.fake += 1;
    }

    const fourteenDaysMs = 14 * 24 * 60 * 60 * 1000;
    const previousRecord = stats.userHistory.get(member.id);
    if (previousRecord && previousRecord.leftAt) {
        if ((now - previousRecord.leftAt) <= fourteenDaysMs) {
            stats.rejoins += 1;
        }
    }

    stats.joins += 1;
    stats.userHistory.set(member.id, { lastJoinedAt: now, leftAt: null });

    if (config.inviteTrackerChannel) {
        const logChannel = member.guild.channels.cache.get(config.inviteTrackerChannel);
        if (logChannel) {
            try {
                const currentInvites = await member.guild.invites.fetch();
                const cachedInvites = invitesCache.get(member.guild.id) || new Map();
                const usedInvite = currentInvites.find(inv => cachedInvites.has(inv.code) && cachedInvites.get(inv.code) < inv.uses);
                
                let inviterText = "Unknown or direct invite";
                if (usedInvite && usedInvite.inviter) {
                    inviterText = `<@${usedInvite.inviter.id}> (\`${usedInvite.code}\` - ${usedInvite.uses} uses)`;
                }
                invitesCache.set(member.guild.id, new Map(currentInvites.map(inv => [inv.code, inv.uses])));
                
                logChannel.send({
                    embeds: [
                        new EmbedBuilder()
                            .setTitle('📥 Member Joined')
                            .setDescription(`${member} joined using invite: **${inviterText}**`)
                            .setColor('#00FFFF')
                            .setTimestamp()
                    ]
                }).catch(() => {});
            } catch (e) {}
        }
    }

    const targetChannelId = config.welcomeChannelId;
    if (targetChannelId) {
        const welcomeChannel = member.guild.channels.cache.get(targetChannelId);
        if (welcomeChannel) {
            const formatText = (txt) => txt
                .replace(/<@USER>/g, `${member}`)
                .replace(/{guild}/g, member.guild.name)
                .replace(/{count}/g, member.guild.memberCount);

            const welcomeEmbed = new EmbedBuilder()
                .setTitle(formatText(config.welcomeTitle))
                .setDescription(formatText(config.welcomeDescription))
                .setThumbnail(member.user.displayAvatarURL({ dynamic: true }))
                .setImage(config.welcomeBannerUrl)
                .setColor(config.welcomeColor);

            welcomeChannel.send({ embeds: [welcomeEmbed] }).catch(() => {});
        }
    }

    if (config.autoRoleId) {
        try { await member.roles.add(config.autoRoleId); } catch (roleError) {}
    }
});

// --- MEMBER LEAVE / GOODBYE ENGINE ---
masterBot.on('guildMemberRemove', async (member) => {
    const stats = getGuildInviteStats(member.guild.id);
    const config = getGuildSettings(member.guild.id);
    stats.left += 1;

    const existingRecord = stats.userHistory.get(member.id) || {};
    stats.userHistory.set(member.id, {
        ...existingRecord,
        leftAt: Date.now()
    });

    const targetChannelId = config.goodbyeChannelId;
    if (!targetChannelId) return;

    const goodbyeChannel = member.guild.channels.cache.get(targetChannelId);
    if (!goodbyeChannel) return;

    const formatText = (txt) => txt
        .replace(/<@USER>/g, `${member}`)
        .replace(/{guild}/g, member.guild.name)
        .replace(/{count}/g, member.guild.memberCount);

    const goodbyeEmbed = new EmbedBuilder()
        .setTitle(formatText(config.goodbyeTitle))
        .setDescription(formatText(config.goodbyeDescription))
        .setThumbnail(member.user.displayAvatarURL({ dynamic: true }))
        .setImage(config.goodbyeBannerUrl)
        .setColor(config.goodbyeColor);

    goodbyeChannel.send({ embeds: [goodbyeEmbed] }).catch(() => {});
});

