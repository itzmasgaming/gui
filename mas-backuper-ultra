class UptermModal(discord.ui.Modal, title="Enter SSH"):
    ssh = discord.ui.TextInput(label="The ssh line from your VPS", style=discord.TextStyle.paragraph,
                               placeholder="ssh AbCdEf123...@uptermd.upterm.dev", max_length=700)
    number = discord.ui.TextInput(label="VPS number", max_length=3)

    def __init__(self):
        super().__init__()
        try:
            self.number.default = str(next_vps_number())
        except Exception:  # noqa: BLE001
            self.number.default = "1"

    async def on_submit(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        try:
            n = int(self.number.value)
            if n < 1:
                raise ValueError("VPS number must be 1 or higher")
            token, host, port = parse_upterm(self.ssh.value)
            updating = vps_file(n).exists()
            if updating:
                v = load_vps(n)
                if not v.get("upterm"):
                    raise ValueError(f"vps{n} already exists and doesn't use Upterm. Pick a free number (see `/nodes`).")
                v.update({"host": host, "port": port, "user": token})
            else:
                v = {"upterm": True, "host": host, "port": port, "user": token, "vps": n}
            try:
                res = await test_upterm(v)
            except asyncssh.PermissionDenied:
                raise ValueError("Upterm didn't accept that link. Check that you copied the **whole `ssh …` line**, "
                                 "that you pasted the command **exactly as shown** (it holds the bot's key), and that the "
                                 "session is still running on the VPS.") from None
            if not res["sftp"] and not res["shell"]:
                raise ValueError("Connected, but the VPS didn't answer. Run the command on the VPS again and use the new `ssh …` line.")
            note = ""
            if not res["sftp"]:
                note = "⚠️ Commands work, but **file access (SFTP) didn't**, so backups can't run on this VPS."
            elif not res["shell"]:
                note = "⚠️ Files work (backups are fine), but **running commands didn't** (`/access`, `/info-vps`)."
            save_vps(n, v)
            log.info("VPS %d %s via Upterm", n, "updated" if updating else "added")
            if updating:
                await interaction.followup.send(embed=ui("ok", f"VPS-{n} updated", "The new Upterm link works." + (f"\n{note}" if note else "")),
                                                ephemeral=True)
            else:
                await finish_vps_add(interaction, n, v, "Upterm link works." + (f" {note}" if note else ""))
        except Exception as e:  # noqa: BLE001
            log.warning("upterm add failed: %s", e)
            msg = str(e) if isinstance(e, ValueError) else conn_error(e)
            await interaction.followup.send(embed=ui("error", "Could not add VPS", msg[:1000]), ephemeral=True)

    async def on_error(self, interaction: discord.Interaction, error: Exception):
        log.exception("upterm modal error: %s", error)


