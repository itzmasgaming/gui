        await reply(interaction, ui("error", f"vps-{vps} isn't added", "Use `/nodes` to see your VPS list."), ephemeral=True)
        return
    await interaction.response.defer(ephemeral=True, thinking=True)
    v = load_vps(vps)
    await interaction.edit_original_response(embed=ui(
        "wait", f"Creating an sshx session on vps-{vps}…",
        "🔌 Connecting\n⬇️ Installing sshx (only the first time)\n🚀 Starting the session\n🔗 Getting your private link\n\n"
        "This can take up to a minute.", footer=f"{FOOTER} • sshx"))
    try:
        out = _ANSI_RE.sub("", await run_script(v, SSHX_SCRIPT, 100))
    except Exception as e:  # noqa: BLE001
        log.warning("sshx on vps%d failed: %s", vps, e)
        await interaction.edit_original_response(embed=ui("error", f"Could not reach vps-{vps}", conn_error(e)))
        return
    kv = {}
    for ln in out.splitlines():
        if "=" in ln:
            k, val = ln.split("=", 1)
            kv.setdefault(k.strip(), val.strip())
    m = _SSHX_URL.search(kv.get("URL", "")) or _SSHX_URL.search(out)
    if not m:
        if kv.get("NO_FETCH"):
            why = "The VPS has neither `curl` nor `wget`, so sshx can't be installed."
        elif kv.get("NO_SSHX"):
            why = "sshx could not be installed.\n```" + (kv.get("LOG", "")[:400] or "no log") + "```"
        else:
            why = "sshx started but did not print a link.\n```" + (kv.get("LOG", "")[:400] or "no output") + "```"
        await interaction.edit_original_response(embed=ui("error", f"sshx failed on vps-{vps}", why))
        return
    url, pid = m.group(0), kv.get("PID", "")
    await interaction.edit_original_response(
        embed=ui("ok", f"sshx ready • vps-{vps}", "Your private terminal link is ready. Press the button to open it.",
                 [("🖥️ VPS", f"`{where_of(v)}`", True),
                  ("🔒 Private", "Only you can see this message.", True),
                  ("⚠️ Keep it secret", "Anyone with the link controls this VPS. Don't share it."),
                  ("🛑 Stop", "The session keeps running on the VPS until you press **Stop session**.")],
                 footer=f"{FOOTER} • sshx"),
        view=SshxView(interaction.user.id, vps, v, pid, url))


