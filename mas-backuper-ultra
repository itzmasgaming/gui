def allowed_ids(guild: discord.Guild) -> set[int]:
    cfg = load_cfg()
    return {guild.owner_id, guild.me.id, *[int(x) for x in cfg.get("allowed_user_ids", [])]}


def backup_findings(guild: discord.Guild) -> list[str]:
    """Everything in this server that shows backup data exists (empty list = nothing to lose)."""
    found = []
    if discord.utils.get(guild.text_channels, name=MARKER):
        found.append(f"#{MARKER}")
    if discord.utils.get(guild.text_channels, name=RECORDS):
        found.append(f"#{RECORDS}")
    for c in guild.categories:
        if c.name == SYSTEM_CAT or re.fullmatch(r"vps-\d+(-\d+)?", c.name):
            found.append(f"category {c.name}")
    return found


def backups_exist(guild: discord.Guild) -> bool:
    return bool(backup_findings(guild))


def vps_categories(guild: discord.Guild, vps: int) -> list[discord.CategoryChannel]:
    pat = re.compile(rf"vps-{vps}(-\d+)?")
    cats = [c for c in guild.categories if pat.fullmatch(c.name)]
    return sorted(cats, key=lambda c: (len(c.name), c.name))


def vps_has_data(guild: discord.Guild, vps: int) -> bool:
    """True if vps-N holds backed-up files (a category with only the empty index channel doesn't count)."""
    return any(ch.name != RECORDS for cat in vps_categories(guild, vps) for ch in cat.channels)


async def delete_many(items, reason: str, batch: int = 5) -> None:
    """Delete channels/kick members a few at a time (much faster than one by one)."""
    for i in range(0, len(items), batch):
        chunk = items[i:i + batch]
        res = await asyncio.gather(*(it.delete(reason=reason) for it in chunk), return_exceptions=True)
        for it, r in zip(chunk, res):
            if isinstance(r, Exception):
                log.error("could not delete %s: %s (Community servers must disable Community first)", it, r)


async def ensure_talk(guild: discord.Guild) -> discord.TextChannel:
    ch = discord.utils.get(guild.text_channels, name=TALK)
    if ch:
        return ch
    return await guild.create_text_channel(
        TALK, topic="Use bot commands and talk here. Backups never touch this channel.")


async def wipe_guild(guild: discord.Guild, keep: discord.abc.GuildChannel | None = None) -> None:
    found = backup_findings(guild)
    if found:
        raise RuntimeError("Refusing to wipe: this server contains backup data (" + ", ".join(found[:6]) +
                           "). Nothing was deleted. Use /focusbackup to delete backups on purpose.")
    allowed = allowed_ids(guild)
    log.info("Wiping %s (%s)", guild.name, guild.id)
    victims = []
    async for m in guild.fetch_members(limit=None):
        if m.id not in allowed:
            victims.append(m)
    for i in range(0, len(victims), 5):
        chunk = victims[i:i + 5]
        res = await asyncio.gather(*(m.kick(reason="MAS backup server wipe") for m in chunk),
                                   return_exceptions=True)
        for m, r in zip(chunk, res):
            if isinstance(r, Exception):
                log.error("could not kick %s: %s (move the bot role higher)", m, r)
            else:
                log.info("kicked %s", m)
    keep_ids = {c.id for c in guild.text_channels if c.name in (TALK, WARN)}
    if keep is not None:
        keep_ids.add(keep.id)
    await delete_many([c for c in guild.channels if c.id not in keep_ids], "MAS backup server wipe")
    try:
        for inv in await guild.invites():
            await inv.delete(reason="MAS backup server is private")
    except Exception as e:  # noqa: BLE001
        log.error("could not clear invites: %s", e)
    try:
        await guild.default_role.edit(permissions=discord.Permissions.none(), reason="MAS private server")
    except Exception as e:  # noqa: BLE001
        log.error("could not make @everyone private: %s", e)
    log.info("Wipe finished.")


async def ensure_marker(guild: discord.Guild):
    ch = discord.utils.get(guild.text_channels, name=MARKER)
    if ch:
        return ch, False
    cat = discord.utils.get(guild.categories, name=SYSTEM_CAT) or await guild.create_category(SYSTEM_CAT)
    ch = await guild.create_text_channel(MARKER, category=cat, topic=f"Backup marker. DO NOT DELETE. {WARNING}")
    return ch, True


async def ensure_category(guild: discord.Guild, vps: int, k: int = 1) -> discord.CategoryChannel:
    name = f"vps-{vps}" if k == 1 else f"vps-{vps}-{k}"
    return discord.utils.get(guild.categories, name=name) or await guild.create_category(name)


async def records_channel(guild: discord.Guild, vps: int) -> discord.TextChannel:
    cat = await ensure_category(guild, vps)
    ch = discord.utils.get(cat.text_channels, name=RECORDS)
    return ch or await guild.create_text_channel(RECORDS, category=cat, topic=f"path index for vps-{vps}")


async def delete_vps_data(guild: discord.Guild, n: int) -> None:
    """Delete all data of vps-N: its channels first, then its category."""
    for cat in vps_categories(guild, n):
        await delete_many(list(cat.channels), f"focusbackup vps-{n}")
        try:
            await cat.delete(reason=f"focusbackup vps-{n}")
        except Exception as e:  # noqa: BLE001
            log.error("could not delete category %s: %s", cat.name, e)


async def bucket_channel(guild, vps, bucket, cache):
    key = (vps, bucket)
    if key in cache:
        return cache[key]
    cats = vps_categories(guild, vps) or [await ensure_category(guild, vps)]
    for cat in cats:
        for ch in cat.text_channels:
            if ch.topic == bucket:
                cache[key] = ch
                return ch
    for cat in cats:
        if len(cat.channels) < MAX_PER_CATEGORY:
            break
    else:
        cat = await ensure_category(guild, vps, len(cats) + 1)
    ch = await guild.create_text_channel(chan_name(bucket), category=cat, topic=bucket)
    cache[key] = ch
    return ch


async def send_file(ch, data: bytes, fname: str, content: str | None = None, tries: int = 5):
    for i in range(tries):
        try:
            return await ch.send(content=content, file=discord.File(io.BytesIO(data), filename=fname),
                                 allowed_mentions=NO_MENTIONS)
        except discord.HTTPException as e:
            if e.status in (400, 403, 404, 413):
                raise
            log.warning("upload of %s failed (%s), retry %d/%d", fname, e, i + 1, tries)
        except (asyncio.TimeoutError, OSError) as e:
            log.warning("upload of %s failed (%s), retry %d/%d", fname, e, i + 1, tries)
        await asyncio.sleep(3 * (i + 1))
    raise RuntimeError(f"upload failed after {tries} tries: {fname}")


async def parse_records(msg: discord.Message) -> list[dict]:
    """Index batches are .jsonl attachments: one JSON record per line."""
    out = []
    for a in msg.attachments:
        if not a.filename.endswith(".jsonl"):
            continue
        text = (await a.read()).decode("utf-8", "replace")
        for ln in text.splitlines():
            try:
                d = json.loads(ln)
            except ValueError:
                continue
            if isinstance(d, dict) and "path" in d and "ch" in d and "msgs" in d:
                out.append(d)
    return out


async def read_exact(f, n: int) -> bytes:
    buf = bytearray()
    while len(buf) < n:
        chunk = await f.read(n - len(buf))
        if not chunk:
            break
        buf += chunk
    return bytes(buf)


# ------------------------------------------------------------------ GUI helpers (every message is an embed)
FOOTER = "MAS GUI v6.5"
_KIND = {"info": ("ℹ️", 0x00E5FF), "ok": ("✅", 0x2ECC71), "warn": ("⚠️", 0xF1C40F),
         "error": ("❌", 0xE74C3C), "wait": ("⏳", 0x3498DB)}


def ui(kind: str, title: str, desc: str | None = None, fields=None, footer: str | None = None) -> discord.Embed:
    """One look for every message the bot sends. fields = [(name, value[, inline]), ...]"""
    icon, color = _KIND[kind]
    e = discord.Embed(title=f"{icon}  {title}"[:256], description=(desc or "")[:4000] or None,
                      color=discord.Color(color), timestamp=discord.utils.utcnow())
    for f in fields or []:
        e.add_field(name=str(f[0])[:256], value=str(f[1])[:1024] or "\u200b", inline=(f[2] if len(f) > 2 else False))
    e.set_footer(text=footer or FOOTER)
    return e


async def reply(inter: discord.Interaction, embed: discord.Embed, ephemeral: bool = False, view=None) -> None:
    kw: dict = {"embed": embed, "ephemeral": ephemeral}
    if view is not None:
        kw["view"] = view
    if inter.response.is_done():
        await inter.followup.send(**kw)
    else:
        await inter.response.send_message(**kw)


class Status:
    """Live progress card: one embed that is edited while a backup/restore runs."""

    def __init__(self, channel, title: str):
        self.channel, self.title, self.msg, self.last = channel, title, None, 0.0

    async def update(self, text: str, force: bool = False, pct: float | None = None, fields=None,
                     state: str = "wait") -> None:
        now = time.monotonic()
        if not (force or self.msg is None or now - self.last > 10):
            return                                      # throttled: don't even build the embed
        desc = str(text)[:1500]
        if pct is not None:
            desc += f"\n`{bar(pct, 20)}` **{pct:.0f}%**"
        e = ui(state, self.title, desc, fields() if callable(fields) else fields,
               footer=f"{FOOTER} • live progress")
        try:
            if self.msg is None:
                self.msg = await self.channel.send(embed=e, allowed_mentions=NO_MENTIONS)
            else:
                await self.msg.edit(embed=e)
            self.last = now
        except discord.HTTPException:
            pass

# ------------------------------------------------------------------ fast backup engine
class Bundle:
    """Many small files packed into one compressed tar -> one Discord upload instead of hundreds."""

    def __init__(self):
        self.buf = io.BytesIO()
        self.tf = tarfile.open(fileobj=self.buf, mode="w:gz", compresslevel=1, format=tarfile.PAX_FORMAT)
        self.items: list[tuple] = []

    def add(self, path, attrs, data: bytes, key: str) -> None:
        member = path.lstrip("/")
        ti = tarfile.TarInfo(member)
        ti.size, ti.mtime = len(data), attrs.mtime or 0
        ti.mode = (attrs.permissions or 0o644) & 0o7777
        self.tf.addfile(ti, io.BytesIO(data))
        self.items.append((path, ti.mode, len(data), attrs.mtime or 0,
                           hashlib.sha256(data).hexdigest(), member, key))

    def size(self) -> int:
        return self.buf.tell()

    def finish(self) -> bytes:
        self.tf.close()
        return self.buf.getvalue()


class Backup:
    """Parallel uploader: reads files concurrently, bundles small ones, uploads several at once,
    and writes the path index in big batches."""

    def __init__(self, guild, v, cfg, rp, state):
        self.guild, self.v, self.cfg, self.rp, self.state = guild, v, cfg, rp, state
        self.sftp = None
        self.limit = part_limit(guild, cfg)
        self.small = min(int(float(cfg.get("small_file_mb", 1)) * 1048576), self.limit // 8)
        self.depth = int(cfg.get("bucket_depth", 2))
        self.slots = asyncio.Semaphore(int(cfg.get("upload_concurrency", 6)))   # uploads in flight
        self.read_sem = asyncio.Semaphore(int(cfg.get("read_concurrency", 16)))  # small-file reads
        self.big_sem = asyncio.Semaphore(3)                                      # big files at once
        self.inflight = asyncio.Semaphore(64)                                    # queued files
        self.tasks: set[asyncio.Task] = set()
        self.bundles: dict[str, tuple[Bundle, discord.TextChannel]] = {}
        self.open_bytes = 0
        self.records: list[dict] = []
        self.rec_lock = asyncio.Lock()
        self.last_flush = time.monotonic()
        self.counter = itertools.count(1)
        self.cache: dict = {}
        self.stats = {"ok": 0, "skipped": 0, "failed": 0, "bytes": 0}

    # ---- bookkeeping
    def spawn(self, coro) -> None:
        t = asyncio.create_task(coro)
        self.tasks.add(t)
        t.add_done_callback(self.tasks.discard)

    def fail(self, path: str, err: Exception) -> None:
        self.stats["failed"] += 1
        log.error("backup failed for %s: %s", path, err)

    def add_record(self, path, perm, size, mtime, sha, ch, msgs, key, member=None) -> None:
        r = {
            "link": f"https://discord.com/channels/{self.guild.id}/{ch.id}/{msgs[0]}" if msgs else "",
            "vps": self.v["vps"], "path": path, "size": size, "mode": perm & 0o7777, "mtime": mtime,
            "sha256": sha, "ch": ch.id, "msgs": msgs,
        }
        if member:
            r["member"] = member
        self.records.append(r)
        self.state[path] = key
        self.stats["ok"] += 1
        self.stats["bytes"] += size

    async def flush_records(self, force: bool = False) -> None:
        async with self.rec_lock:
            if not self.records:
                return
            if not force and len(self.records) < 1500 and time.monotonic() - self.last_flush < 45:
                return
            recs, self.records = self.records, []
            self.last_flush = time.monotonic()
            maxb = self.limit - 8192
            chunk: list[str] = []
            size = 0
            lines = [json.dumps(r, separators=(",", ":"), ensure_ascii=False) for r in recs]
            for ln in lines + [None]:
                if chunk and (ln is None or size + len(ln.encode()) + 1 > maxb):
                    name = f"paths{SEP}{int(time.time())}{SEP}{next(self.counter)}.jsonl"
                    await send_file(self.rp, "\n".join(chunk).encode(), name)
                    chunk, size = [], 0
                if ln is not None:
                    chunk.append(ln)
                    size += len(ln.encode()) + 1
            save_state(self.v["vps"], self.state)

    # ---- per-file entry point (called one file at a time by the walker)
    async def handle(self, path: str, attrs) -> None:
        size = attrs.size or 0
        key = f"{size}|{attrs.mtime}"
        if self.state.get(path) == key:
            self.stats["skipped"] += 1
            return
        ch = await bucket_channel(self.guild, self.v["vps"], bucket_of(path, self.depth), self.cache)
        if size == 0:
            self.add_record(path, attrs.permissions or 0o644, 0, attrs.mtime or 0,
                            hashlib.sha256(b"").hexdigest(), ch, [], key)
            return
        await self.inflight.acquire()
        if size <= self.small:
            self.spawn(self.small_task(path, attrs, key, bucket_of(path, self.depth), ch))
        else:
            self.spawn(self.big_task(path, attrs, key, ch))

    # ---- small files -> bundles
    async def small_task(self, path, attrs, key, bucket, ch) -> None:
        try:
            async with self.read_sem:
                async with self.sftp.open(path, "rb") as f:
                    data = await read_exact(f, attrs.size or 0)
            self.add_small(path, attrs, key, bucket, ch, data)
        except Exception as e:  # noqa: BLE001
            self.fail(path, e)
        finally:
            self.inflight.release()

    def add_small(self, path, attrs, key, bucket, ch, data: bytes) -> None:
        ent = self.bundles.get(bucket)
        if ent is None:
            ent = (Bundle(), ch)
            self.bundles[bucket] = ent
        b = ent[0]
        before = b.size()
        b.add(path, attrs, data, key)
        self.open_bytes += b.size() - before
        if b.size() >= self.limit * 3 // 4:
            self.flush_bundle(bucket)
        elif self.open_bytes > 256 * 1048576:        # keep memory bounded
            for k in list(self.bundles):
                self.flush_bundle(k)

    def flush_bundle(self, bucket: str) -> None:
        ent = self.bundles.pop(bucket, None)
        if ent is None:
            return
        b, ch = ent
        self.open_bytes -= b.size()
        self.spawn(self.bundle_task(b, ch))

    async def bundle_task(self, b: Bundle, ch) -> None:
        try:
            data = await asyncio.to_thread(b.finish)
            name = f"bundle{SEP}{int(time.time())}{SEP}{next(self.counter)}.tar.gz"
            async with self.slots:
                msg = await send_file(ch, data, name)
            for path, perm, size, mtime, sha, member, key in b.items:
                self.add_record(path, perm, size, mtime, sha, ch, [msg.id], key, member=member)
        except Exception as e:  # noqa: BLE001
            for it in b.items:
                self.fail(it[0], e)
        await self.maybe_flush()

    async def maybe_flush(self) -> None:
        try:
            await self.flush_records()
        except Exception as e:  # noqa: BLE001
            log.error("could not write index batch: %s", e)

    # ---- big files -> parts uploaded in parallel
    async def _part(self, ch, data: bytes, fname: str) -> int:
        try:
            return (await send_file(ch, data, fname)).id
        finally:
            self.slots.release()

    async def big_task(self, path, attrs, key, ch) -> None:
        size = attrs.size or 0
        name = posixpath.basename(path)
        h = hashlib.sha256()
        parts: list[asyncio.Task] = []
        try:
            async with self.big_sem:
                async with self.sftp.open(path, "rb") as f:
                    n = 0
                    while True:
                        await self.slots.acquire()          # backpressure: bounds memory in flight
                        try:
                            data = await read_exact(f, self.limit)
                        except BaseException:
                            self.slots.release()
                            raise
                        if not data:
                            self.slots.release()
                            break
                        n += 1
                        h.update(data)
                        parts.append(asyncio.create_task(
                            self._part(ch, data, file_label(name, n if size > self.limit else None))))
                ids = list(await asyncio.gather(*parts))
            self.add_record(path, attrs.permissions or 0o644, size, attrs.mtime or 0,
                            h.hexdigest(), ch, ids, key)
        except Exception as e:  # noqa: BLE001
            await asyncio.gather(*parts, return_exceptions=True)
            self.fail(path, e)
        finally:
            self.inflight.release()
        await self.maybe_flush()

    # ---- wait for everything
    async def finish(self) -> None:
        while True:
            if self.tasks:
                await asyncio.gather(*list(self.tasks), return_exceptions=True)
                continue
            if self.bundles:
                for k in list(self.bundles):
                    self.flush_bundle(k)
                continue
            break
        await self.flush_records(force=True)


def fmt_bytes(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def fmt_time(sec: float) -> str:
    sec = int(sec)
    h, r = divmod(sec, 3600)
    m, s = divmod(r, 60)
    return f"{h}h {m}m {s}s" if h else (f"{m}m {s}s" if m else f"{s}s")


def backup_embed(vps_n: int, v: dict, s: dict, elapsed: float, channels: int) -> discord.Embed:
    clean = s["failed"] == 0
    e = discord.Embed(
        title=f"{'✅' if clean else '⚠️'}  VPS-{vps_n} backup {'complete' if clean else 'finished with errors'}",
        description=(f"Everything from **vps-{vps_n}** is now safely stored in this server."
                     if clean else
                     f"**vps-{vps_n}** was backed up, but some files failed. Details are in the bot console/log."),
        color=discord.Color(0x00E5FF if clean else 0xF1C40F),
        timestamp=discord.utils.utcnow(),
    )
    where = "this machine" if v.get("local") else remote_label(v)
    speed = s["bytes"] / elapsed if elapsed > 0 else 0
    e.add_field(name="📁 Files saved", value=f"{s['ok']:,}", inline=True)
    e.add_field(name="⏭️ Unchanged", value=f"{s['skipped']:,}", inline=True)
    e.add_field(name="❌ Failed", value=f"{s['failed']:,}", inline=True)
    e.add_field(name="💾 Data", value=fmt_bytes(s["bytes"]), inline=True)
    e.add_field(name="⏱️ Time", value=fmt_time(elapsed), inline=True)
    e.add_field(name="🚀 Speed", value=f"{fmt_bytes(speed)}/s", inline=True)
    e.add_field(name="📂 Channels used", value=f"{channels:,}", inline=True)
    e.add_field(name="🖥️ Source", value=where, inline=True)
    e.set_footer(text="MAS GUI v6.5 • Auto Backup")
    return e


async def announce(guild: discord.Guild, channel, embed: discord.Embed, ping: bool = False) -> None:
    """Post the embed in #talk-cmds-here (the only channel the bot talks in) and DM it to the owner.
    ping=True also @mentions the owner in the channel."""
    origin = channel if getattr(getattr(channel, "guild", None), "id", guild.id) != guild.id else None   # started from the main server
    channel = discord.utils.get(guild.text_channels, name=TALK) or channel
    owner = None
    try:
        owner = guild.get_member(guild.owner_id) or await guild.fetch_member(guild.owner_id)
    except Exception as e:  # noqa: BLE001
        log.warning("could not find the owner: %s", e)
    try:
        if ping and owner is not None:
            await channel.send(content=owner.mention, embed=embed,
                               allowed_mentions=discord.AllowedMentions(users=[owner]))
        else:
            await channel.send(embed=embed)
    except discord.HTTPException as e:
        log.error("could not post the result message: %s", e)
    if origin is not None:
        try:
            await origin.send(embed=embed)
        except discord.HTTPException as e:
            log.warning("could not mirror the result into the main server: %s", e)
    if owner is None:
        return
    try:
        dm = embed.copy()
        dm.add_field(name="🔗 Open", value=f"[Go to #{channel.name}]({channel.jump_url})", inline=False)
        await owner.send(embed=dm)
        log.info("DM sent to the owner")
    except discord.Forbidden:
        log.warning("Could not DM the owner (their DMs are closed for server members).")
    except Exception as e:  # noqa: BLE001
        log.warning("could not DM the owner: %s", e)


def restore_embed(vps_n: int, v: dict, prog: dict, nbytes: int, elapsed: float, total: int,
                  src: int | None = None, skipped: int = 0) -> discord.Embed:
    """vps_n = the VPS that received the files. src = set when the files came from another VPS's backup."""
    clean = prog["failed"] == 0
    if src is not None:
        name = f"VPS-{src} backup copied into VPS-{vps_n}" if clean else f"VPS-{src} → VPS-{vps_n} copy finished with errors"
        desc = (f"Every file of the **vps-{src}** backup was pasted into **vps-{vps_n}**." if clean else
                f"The **vps-{src}** backup was pasted into **vps-{vps_n}**, but some files failed. See the bot console/log.")
    else:
        name = f"VPS-{vps_n} fully imported" if clean else f"VPS-{vps_n} import finished with errors"
        desc = (f"Every backed-up file of **vps-{vps_n}** was restored to its old path." if clean else
                f"**vps-{vps_n}** was restored, but some files failed. Details are in the bot console/log.")
    e = discord.Embed(title=f"{'✅' if clean else '⚠️'}  {name}", description=desc,
                      color=discord.Color(0x2ECC71 if clean else 0xF1C40F), timestamp=discord.utils.utcnow())
    where = "this machine" if v.get("local") else remote_label(v)
    speed = nbytes / elapsed if elapsed > 0 else 0
    e.add_field(name="📁 Restored", value=f"{prog['ok']:,} / {total:,}", inline=True)
    e.add_field(name="❌ Failed", value=f"{prog['failed']:,}", inline=True)
    e.add_field(name="💾 Data", value=fmt_bytes(nbytes), inline=True)
    e.add_field(name="⏱️ Time", value=fmt_time(elapsed), inline=True)
    e.add_field(name="🚀 Speed", value=f"{fmt_bytes(speed)}/s", inline=True)
    e.add_field(name="🖥️ Target", value=where, inline=True)
    if skipped:
        e.add_field(name="🛡️ Skipped (protected)", value=f"{skipped:,} connection/system files (sshx, SSH, IP/port & network configs) were left untouched", inline=False)
    e.set_footer(text=f"{FOOTER} • {'Copy' if src is not None else 'Import'}")
    return e


async def run_backup(guild: discord.Guild, vps_n: int, status: Status) -> None:
    v, cfg = load_vps(vps_n), load_cfg()
    excl = cfg.get("exclude", DEFAULT_EXCLUDE)
    _, fresh = await ensure_marker(guild)
    state = {} if fresh else load_state(vps_n)
    rp = await records_channel(guild, vps_n)
    bk = Backup(guild, v, cfg, rp, state)
    t0 = time.monotonic()
    log.info("backup of vps%d started", vps_n)
    await status.update(f"Starting backup of **vps-{vps_n}**…", force=True)
    try:
        async with open_fs(v) as sftp:
            bk.sftp = sftp
            async for path, attrs in walk(sftp, "/", excl):
                try:
                    await bk.handle(path, attrs)
                except Exception as e:  # noqa: BLE001
                    bk.fail(path, e)
                s = bk.stats
                await status.update(f"Reading and uploading files from **vps-{vps_n}**…", fields=lambda: [
                    ("📁 Saved", f"{s['ok']:,}", True), ("⏭️ Unchanged", f"{s['skipped']:,}", True),
                    ("❌ Failed", f"{s['failed']:,}", True), ("💾 Data", fmt_bytes(s["bytes"]), True),
                    ("📄 Now", f"`{path[-70:]}`", False)])
            await bk.finish()
    finally:
        save_state(vps_n, state)
    v["synced"] = True
    v["last_backup"] = int(time.time())
    save_vps(vps_n, v)
    s = bk.stats
    log.info("backup of vps%d finished: %s", vps_n, s)
    await status.update(f"Backup of **vps-{vps_n}** finished in {fmt_time(time.monotonic() - t0)}", force=True,
                        pct=100, state="ok" if s["failed"] == 0 else "warn")
    await announce(guild, status.channel,
                   backup_embed(vps_n, v, s, time.monotonic() - t0, len(bk.cache)))


# ------------------------------------------------------------------ restore
async def finalize_remote(sftp, path: str, mode, mtime) -> None:
    await sftp.chmod(path, int(mode))
    if mtime:
        try:
            await sftp.utime(path, (int(mtime), int(mtime)))
        except Exception as e:  # noqa: BLE001
            log.debug("could not restore mtime of %s: %s", path, e)


async def write_remote(sftp, path: str, data: bytes, mode, mtime) -> None:
    await sftp.makedirs(posixpath.dirname(path) or "/", exist_ok=True)
    tmp = path + ".mas-restore"
    try:
        async with sftp.open(tmp, "wb") as f:
            await f.write(data)
        await sftp.posix_rename(tmp, path)
        await finalize_remote(sftp, path, mode, mtime)
    except Exception:
        try:
            await sftp.remove(tmp)
        except Exception:  # noqa: BLE001
            pass
        raise


async def restore_big(guild, sftp, rec) -> None:
    ch = guild.get_channel(int(rec["ch"]))
    if ch is None:
        raise ValueError(f"channel {rec['ch']} no longer exists")
    path = rec["path"]
    await sftp.makedirs(posixpath.dirname(path) or "/", exist_ok=True)
    tmp = path + ".mas-restore"
    h = hashlib.sha256()
    try:
        async with sftp.open(tmp, "wb") as f:
            for mid in rec["msgs"]:
                m = await ch.fetch_message(int(mid))
                if m.channel.id != int(rec["ch"]) or not m.attachments:
                    raise ValueError(f"message {mid} is not in the expected channel / has no data")
                data = await m.attachments[0].read()   # fresh CDN url, fetched by message id
                h.update(data)
                await f.write(data)
        if h.hexdigest() != rec["sha256"]:
            raise ValueError("checksum mismatch")
        await sftp.posix_rename(tmp, path)
        await finalize_remote(sftp, path, rec.get("mode", 0o644), rec.get("mtime"))
    except Exception:
        try:
            await sftp.remove(tmp)
        except Exception:  # noqa: BLE001
            pass
        raise


async def restore_bundle(guild, sftp, ch_id: int, msg_id: int, recs: list[dict]):
    """Download one bundle once and unpack every file that lives in it. Returns (ok_recs, failed)."""
    ch = guild.get_channel(ch_id)
    if ch is None:
        raise ValueError(f"channel {ch_id} no longer exists")
    m = await ch.fetch_message(msg_id)
    if m.channel.id != ch_id or not m.attachments:
        raise ValueError(f"message {msg_id} is not in the expected channel / has no data")
    data = await m.attachments[0].read()
    tf = tarfile.open(fileobj=io.BytesIO(data), mode="r:gz")
    done, failed = [], 0
    for rec in recs:
        try:
            f = tf.extractfile(rec["member"])
            content = f.read()
            if hashlib.sha256(content).hexdigest() != rec["sha256"]:
                raise ValueError("checksum mismatch")
            await write_remote(sftp, rec["path"], content, rec.get("mode", 0o644), rec.get("mtime"))
            done.append(rec)
        except Exception as e:  # noqa: BLE001
            failed += 1
            log.error("restore failed for %s: %s", rec.get("path"), e)
    return done, failed


async def run_import(guild: discord.Guild, vps_n: int, status: Status, target_n: int | None = None) -> None:
    """Restore the backup of vps_n. With target_n set, paste that backup into ANOTHER vps (/copybackup)."""
    tn = target_n or vps_n
    v = load_vps(tn)
    cats = vps_categories(guild, vps_n)
    rp = discord.utils.get(cats[0].text_channels, name=RECORDS) if cats else None
    if rp is None:
        raise ValueError(f"no `{RECORDS}` channel found for vps-{vps_n}")
    await status.update(f"Reading the path index of **vps-{vps_n}**…", force=True)
    records: dict[str, dict] = {}
    async for msg in rp.history(limit=None, oldest_first=True):
        for rec in await parse_records(msg):
            if int(rec.get("vps", vps_n)) == vps_n:
                records[rec["path"]] = rec            # newest record for a path wins
    # never restore sshx / ssh / ip-port / network files: they would break the way you connect to the VPS
    rules = load_cfg().get("import_skip", IMPORT_SKIP)
    keep = {p: r for p, r in records.items() if not import_skipped(p, rules)}
    skipped, records = len(records) - len(keep), keep
    if target_n is not None:                         # copy to another VPS: keep that VPS reachable and itself
        skip = load_cfg().get("copy_skip", COPY_SKIP)
        keep = {p: r for p, r in records.items() if not excluded(p, skip)}
        skipped, records = skipped + len(records) - len(keep), keep
    log.info("import vps%d -> vps%d: %d files in index (%d skipped)", vps_n, tn, len(records), skipped)
    singles = [r for r in records.values() if not r.get("member")]
    bundles: dict[tuple, list] = defaultdict(list)
    for r in records.values():
        if r.get("member"):
            bundles[(int(r["ch"]), int(r["msgs"][0]))].append(r)
    total = len(records)
    prog = {"ok": 0, "failed": 0}
    restored: list[dict] = []
    sem = asyncio.Semaphore(4)

    async def do_single(rec):
        async with sem:
            try:
                await restore_big(guild, sftp, rec)
                prog["ok"] += 1
                restored.append(rec)
            except Exception as e:  # noqa: BLE001
                prog["failed"] += 1
                log.error("restore failed for %s: %s", rec.get("path"), e)
            await status.update(f"Restoring files to **vps-{tn}**…", pct=(prog["ok"] + prog["failed"]) * 100 / max(1, total),
                                fields=lambda: [("📁 Restored", f"{prog['ok']:,} / {total:,}", True),
                                                ("❌ Failed", f"{prog['failed']:,}", True)])

    async def do_bundle(key, recs):
        async with sem:
            try:
                done, failed = await restore_bundle(guild, sftp, key[0], key[1], recs)
                prog["ok"] += len(done)
                prog["failed"] += failed
                restored.extend(done)
            except Exception as e:  # noqa: BLE001
                prog["failed"] += len(recs)
                log.error("bundle %s restore failed: %s", key, e)
            await status.update(f"Restoring files to **vps-{tn}**…", pct=(prog["ok"] + prog["failed"]) * 100 / max(1, total),
                                fields=lambda: [("📁 Restored", f"{prog['ok']:,} / {total:,}", True),
                                                ("❌ Failed", f"{prog['failed']:,}", True)])

    t0 = time.monotonic()
    async with open_fs(v) as sftp:
        await asyncio.gather(*[do_single(r) for r in singles],
                             *[do_bundle(k, rs) for k, rs in bundles.items()])
    if target_n is None:        # plain restore: the next /backup must not re-upload everything
        st = load_state(vps_n)
        for r in restored:
            st[r["path"]] = f"{r['size']}|{r.get('mtime', 0)}"
        save_state(vps_n, st)
        v["synced"] = True
        save_vps(vps_n, v)
    elapsed = time.monotonic() - t0
    nbytes = sum(int(r.get("size", 0)) for r in restored)
    await status.update(f"{'Copy into' if target_n else 'Restore of'} **vps-{tn}** finished in {fmt_time(elapsed)}", force=True, pct=100,
                        state="ok" if prog["failed"] == 0 else "warn")
    # DM + @ping the owner (the bot only ever speaks in #talk-cmds-here)
    await announce(guild, status.channel, restore_embed(tn, v, prog, nbytes, elapsed, total, src=vps_n if target_n else None, skipped=skipped), ping=True)


async def backup_job(bot, channel, guild, nums: list[int]) -> None:
    talk = await ensure_talk(guild)
    # normally the bot writes in #talk-cmds-here; a job started from the main server reports there too
    channel = channel if getattr(getattr(channel, "guild", None), "id", guild.id) != guild.id else talk
    if backups_locked():
        await channel.send(embed=lock_embed())
        return
    if bot.lock.locked():
        await channel.send(embed=ui("warn", "Already busy", "Another backup/restore is running. Wait until it finishes."))
        return
    async with bot.lock:
        for n in nums:
            try:
                v = load_vps(n)
                if not v.get("synced") and vps_has_data(guild, n):
                    await channel.send(embed=ui(
                        "warn", f"VPS-{n} already has backup data",
                        "This server already holds a backup of this VPS. Choose first:",
                        [("🛟 Restore it onto this VPS", f"`/importbackup vps:{n}`", True),
                         ("🗑️ Delete it and start fresh", f"`/focusbackup vps:{n}`", True)]))
                    continue
                await run_backup(guild, n, Status(channel, f"VPS-{n} backup"))
            except Exception as e:  # noqa: BLE001
                log.exception("backup of vps%d crashed: %s", n, e)
                err = discord.Embed(
                    title=f"❌  VPS-{n} backup failed",
                    description=f"```{str(e)[:500]}```\nSee the bot console/log for details.",
                    color=discord.Color(0xE74C3C), timestamp=discord.utils.utcnow())
                err.set_footer(text="MAS GUI v6.5 • Auto Backup")
                await announce(guild, channel, err)


