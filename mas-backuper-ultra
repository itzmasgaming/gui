class Identity:
    """Gives the database server its name + logo, and guards them: checked every 10 s, put back when changed."""

    def __init__(self, bot):
        self.bot = bot
        self.cycling = False
        self.expected_name: str | None = None
        self.logo: bytes | None = None
        self.last_entry = 0
        self.handled = None
        self.audit_warned = False

    @property
    def guild(self):
        return self.bot.get_guild(self.bot.gid)

    async def fetch_logo(self) -> bytes | None:
        if self.logo:
            return self.logo
        try:
            import aiohttp
            async with aiohttp.ClientSession() as sess:
                async with sess.get(LOGO_URL, timeout=aiohttp.ClientTimeout(total=20)) as r:
                    if r.status == 200:
                        self.logo = await r.read()
                        return self.logo
                    log.warning("logo download answered HTTP %s", r.status)
        except Exception as e:  # noqa: BLE001
            log.warning("could not download the server logo: %s", e)
        return None

    async def _edit(self, **kw):
        g = self.guild
        if g is None:
            return None
        try:
            return await g.edit(reason="MAS server identity", **kw)
        except discord.Forbidden:
            log.error("I need the Manage Server permission to change the server name/logo.")
        except discord.HTTPException as e:
            log.warning("could not change the server name/logo: %s", e)
        return None

    async def cycle(self) -> None:
        """Bot added / bot started: name -> (5 s) 'Sub to ItzMASGaming' -> (5 s) name again, and the logo."""
        g = self.guild
        if g is None or self.cycling:
            return
        self.cycling = True
        try:
            main = brand_name()
            st = load_ident()
            logo = await self.fetch_logo()
            kw: dict = {"name": main}
            if logo and (g.icon is None or g.icon.key != st.get("icon")):
                kw["icon"] = logo
            self.expected_name = main
            ng = await self._edit(**kw) or g
            st["icon_managed"] = bool(logo)
            st["icon"] = ng.icon.key if ng.icon else None
            save_ident(st)
            await asyncio.sleep(5)
            self.expected_name = BRAND_SUB
            await self._edit(name=BRAND_SUB)
            await asyncio.sleep(5)
            self.expected_name = main
            await self._edit(name=main)
            for _ in range(40):                      # wait until the change has arrived before watching again
                if self.guild is not None and self.guild.name == main:
                    break
                await asyncio.sleep(0.25)
            log.info("server identity set: %s", main)
        except Exception as e:  # noqa: BLE001
            log.exception("server identity cycle failed: %s", e)
        finally:
            self.cycling = False
            self.handled = None

    async def find_culprit(self, g):
        try:
            async for e in g.audit_logs(limit=6, action=discord.AuditLogAction.guild_update):
                if e.id <= self.last_entry:
                    break
                self.last_entry = max(self.last_entry, e.id)
                if e.user is not None and e.user.id != self.bot.user.id:
                    return e.user
        except discord.Forbidden:
            if not self.audit_warned:
                self.audit_warned = True
                log.warning("I can't read the audit log, so I can't tell WHO changed the server. Give the bot 'View Audit Log'.")
        except Exception as e:  # noqa: BLE001
            log.warning("audit log lookup failed: %s", e)
        return None

    async def watch(self) -> None:
        await self.bot.wait_until_ready()
        while not self.bot.is_closed():
            await asyncio.sleep(10)
            try:
                await self.check()
            except Exception as e:  # noqa: BLE001
                log.exception("identity check failed: %s", e)

    def _bad(self, g, st) -> tuple[bool, bool]:
        icon = g.icon.key if g.icon else None
        return g.name != self.expected_name, bool(st.get("icon_managed")) and icon != st.get("icon")

    async def check(self) -> None:
        g = self.guild
        if g is None or self.cycling or self.expected_name is None:
            return
        st = load_ident()
        name_bad, icon_bad = self._bad(g, st)
        if not (name_bad or icon_bad):
            self.handled = None
            return
        seen = (g.name, g.icon.key if g.icon else None)
        if self.handled == seen:                     # already warned about exactly this, and couldn't fix it
            return
        await asyncio.sleep(2)                       # not just our own edit still arriving?
        g = self.guild
        st = load_ident()
        name_bad, icon_bad = self._bad(g, st)
        if not (name_bad or icon_bad) or self.cycling:
            return
        self.handled = seen
        who = await self.find_culprit(g)
        key = str(who.id) if who else "unknown"
        st["counts"][key] = int(st["counts"].get(key, 0)) + 1
        n = st["counts"][key]
        save_ident(st)
        lines = []
        if name_bad:
            lines.append(f"**Name:** `{g.name}` (it must be `{self.expected_name}`)")
        if icon_bad:
            lines.append("**Logo:** it was changed")
        fixed = False
        self.cycling = True                          # don't count our own repair
        try:
            kw: dict = {}
            if name_bad:
                kw["name"] = self.expected_name
            if icon_bad:
                logo = await self.fetch_logo()
                if logo:
                    kw["icon"] = logo
            if kw:
                ng = await self._edit(**kw)
                fixed = ng is not None
                if fixed and "icon" in kw:
                    st = load_ident()
                    st["icon"] = ng.icon.key if ng.icon else None
                    save_ident(st)
        finally:
            self.cycling = False
        if fixed:
            self.handled = None
        who_txt = f"<@{who.id}> (`{who.id}`)" if who else "unknown (give the bot **View Audit Log** to see who)"
        await post_warning(self.bot, ui(
            "warn", "Server name/logo was changed", "\n".join(lines),
            [("👤 Changed by", who_txt, True), ("🔢 Their changes", f"{n}/{MAX_CHANGES}", True),
             ("🛠️ Fixed", "✅ I put it back" if fixed else "❌ I couldn't (needs Manage Server)", True)]))
        st = load_ident()
        if n > MAX_CHANGES and not st.get("locked"):
            st["locked"], st["offender"], st["locked_at"] = True, (who.id if who else None), int(time.time())
            save_ident(st)
            log.warning("backups paused: server name/logo changed %d times by %s", n, key)
            await post_warning(self.bot, lock_embed(st))


@app_commands.command(name="confirm", description="Resume backups after they were paused for changing the server name/logo")
@app_commands.describe(user="ID of the user the pause is about (shown in the warning)")
async def cmd_confirm(interaction: discord.Interaction, user: str):
    cfg = load_cfg()
    if interaction.guild_id not in ({int(cfg.get("guild_id", 0)), main_gid()} - {0}):
        await reply(interaction, ui("error", "Wrong server", "Use this in the backup server or the main server."), ephemeral=True)
        return
    st = load_ident()
    ok, text, uid = confirm_check(st, interaction.user.id, user)
    if not ok:
        await reply(interaction, ui("error", "Not confirmed", text), ephemeral=True)
        return
    st["locked"], st["offender"] = False, None
    st["counts"][str(uid)] = 0
    save_ident(st)
    log.info("backups resumed, confirmed by %s", interaction.user.id)
    await reply(interaction, ui("ok", "Backups resumed", text), ephemeral=True)
    await post_warning(interaction.client, ui("ok", "Backups resumed", f"<@{interaction.user.id}> confirmed. Backups run again."))


