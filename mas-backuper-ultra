def write_private(path: Path, obj: dict) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, indent=2)
    os.chmod(path, 0o600)


def load_cfg() -> dict:
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {}


def save_cfg(cfg: dict) -> None:
    write_private(CONFIG, cfg)


def load_env() -> dict:
    out: dict = {}
    if ENV_FILE.exists():
        for ln in ENV_FILE.read_text().splitlines():
            ln = ln.strip()
            if not ln or ln.startswith("#") or "=" not in ln:
                continue
            k, v = ln.split("=", 1)
            out[k.strip()] = v.strip().strip('"').strip("'")
    return out


def save_env(env: dict) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(ENV_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        for k, v in env.items():
            f.write(f"{k}={v}\n")
    os.chmod(ENV_FILE, 0o600)


def get_token() -> str | None:
    return os.environ.get("DISCORD_TOKEN") or load_env().get("DISCORD_TOKEN") or load_cfg().get("token")


def migrate_token() -> str:
    """Move a token stored in config.json into .env. Returns a short status word."""
    cfg, env = load_cfg(), load_env()
    old = cfg.pop("token", None)
    if old and not env.get("DISCORD_TOKEN"):
        env["DISCORD_TOKEN"] = old
        save_env(env)
        save_cfg(cfg)
        return "moved"
    if old:                                  # already in .env: just drop the duplicate secret
        save_cfg(cfg)
        return "already-in-env"
    return "ok" if env.get("DISCORD_TOKEN") else "none"


