# ------------------------------------------------------------------ storage
def setup_logging() -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
        handlers=[logging.StreamHandler(sys.stdout), logging.FileHandler(LOGFILE)],
    )


def write_private(path: Path, obj: dict) -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(obj, f, indent=2)
    os.chmod(path, 0o600)


def load_cfg() -> dict:
    return json.loads(CONFIG.read_text()) if CONFIG.exists() else {}


def save_cfg(cfg: dict) -> None:
    write_private(CONFIG, cfg)


def vps_file(n: int) -> Path:
    return DATA_DIR / f"vps{n}.itzmasgaming"


def vps_numbers() -> list[int]:
    nums = []
    for p in DATA_DIR.glob("vps*.itzmasgaming"):
        m = re.fullmatch(r"vps(\d+)\.itzmasgaming", p.name)
        if m:
            nums.append(int(m.group(1)))
    return sorted(nums)


def next_vps_number() -> int:
    used = set(vps_numbers())
    n = 1
    while n in used:
        n += 1
    return n


def load_vps(n: int) -> dict:
    p = vps_file(n)
    if not p.exists():
        raise FileNotFoundError(f"vps{n}.itzmasgaming does not exist (use /vps add)")
    return json.loads(p.read_text())


def save_vps(n: int, data: dict) -> None:
    data = dict(data)
    data["vps"] = n
    data.setdefault("created", int(time.time()))
    write_private(vps_file(n), data)


def state_file(n: int) -> Path:
    return DATA_DIR / f"vps{n}.state.json"


def load_state(n: int) -> dict:
    p = state_file(n)
    return json.loads(p.read_text()) if p.exists() else {}


def save_state(n: int, st: dict) -> None:
    write_private(state_file(n), st)


# ------------------------------------------------------------------ ssh
async def ssh_connect(v: dict):
    # known_hosts=None disables host-key checking (simple, but open to MITM).
    return await asyncssh.connect(
        v["host"], port=int(v.get("port", 22)), username=v.get("user", "root"),
        password=v.get("password") or None, known_hosts=None, keepalive_interval=30,
    )


async def test_ssh(v: dict) -> None:
    conn = await ssh_connect(v)
    conn.close()
    await conn.wait_closed()


class _Attrs:
    def __init__(self, st):
        self.permissions, self.size, self.mtime = st.st_mode, st.st_size, int(st.st_mtime)


class _Entry:
    def __init__(self, name, st):
        self.filename, self.attrs = name, _Attrs(st)


class _LocalFile:
    def __init__(self, path, mode):
        self.path, self.mode, self.f = path, mode, None

    async def __aenter__(self):
        self.f = await asyncio.to_thread(open, self.path, self.mode)
        return self

    async def __aexit__(self, *a):
        await asyncio.to_thread(self.f.close)

    async def read(self, n):
        return await asyncio.to_thread(self.f.read, n)

    async def write(self, b):
        return await asyncio.to_thread(self.f.write, b)


class LocalSFTP:
    """Same interface as the SFTP client, but for the machine the bot runs on (no SSH needed)."""

    async def readdir(self, p):
        def _r():
            out = []
            with os.scandir(p) as it:
                for e in it:
                    try:
                        out.append(_Entry(e.name, e.stat(follow_symlinks=False)))
                    except OSError:
                        pass
            return out
        return await asyncio.to_thread(_r)

    def open(self, path, mode):
        return _LocalFile(path, mode)

    async def makedirs(self, p, exist_ok=True):
        await asyncio.to_thread(os.makedirs, p, exist_ok=exist_ok)

    async def posix_rename(self, a, b):
        await asyncio.to_thread(os.replace, a, b)

    async def chmod(self, p, mode):
        await asyncio.to_thread(os.chmod, p, mode)

    async def remove(self, p):
        await asyncio.to_thread(os.remove, p)


@contextlib.asynccontextmanager
async def open_fs(v: dict):
    """vps flagged local -> this machine; otherwise SFTP over SSH."""
    if v.get("local"):
        yield LocalSFTP()
        return
    conn = await ssh_connect(v)
    try:
        async with conn.start_sftp_client() as sftp:
            yield sftp
    finally:
        conn.close()
        await conn.wait_closed()


def excluded(path: str, excl: list[str]) -> bool:
    for e in excl:
        e = e.rstrip("/")
        if path == e or path.startswith(e + "/"):
            return True
    # never back up the bot's own data (token!) if the VPS is the bot host
    return any(p in (".mas-backup", "mas-backup") for p in path.split("/"))


async def walk(sftp, root: str, excl: list[str]):
    stack = [root]
    while stack:
        d = stack.pop()
        if excluded(d, excl):
            continue
        try:
            entries = await sftp.readdir(d)
        except Exception as e:  # noqa: BLE001
            log.error("cannot list %s: %s", d, e)
            continue
        for e in entries:
            name = e.filename.decode(errors="replace") if isinstance(e.filename, bytes) else e.filename
            if name in (".", ".."):
                continue
            full = d.rstrip("/") + "/" + name
            perm = e.attrs.permissions or 0
            if stat.S_ISDIR(perm):
                stack.append(full)
            elif stat.S_ISREG(perm):      # symlinks/devices/sockets are skipped
                yield full, e.attrs


# ------------------------------------------------------------------ naming
def safe_name(name: str) -> str:
    return name.replace(" ", SEP)


def file_label(name: str, part: int | None) -> str:
    base = safe_name(name)[:150]
    return base if part is None else f"{base}{SEP}part{part}"


def chan_name(bucket: str) -> str:
    s = re.sub(r"[^a-z0-9_-]+", "-", bucket.lower()).strip("-")[:90]
    return s or "root"


def bucket_of(path: str, depth: int) -> str:
    dirs = [p for p in path.split("/") if p][:-1]
    return "/" + "/".join(dirs[:depth]) if dirs else "/"


def part_limit(guild: discord.Guild, cfg: dict) -> int:
    cap = int(cfg.get("max_part_mb", 20)) * 1024 * 1024
    return max(1024 * 1024, min(cap, guild.filesize_limit) - 64 * 1024)


# ------------------------------------------------------------------ discord helpers
def allowed_ids(guild: discord.Guild) -> set[int]:
    cfg = load_cfg()
    return {guild.owner_id, guild.me.id, *[int(x) for x in cfg.get("allowed_user_ids", [])]}


def backups_exist(guild: discord.Guild) -> bool:
    return discord.utils.get(guild.text_channels, name=MARKER) is not None


async def wipe_guild(guild: discord.Guild, keep: discord.abc.GuildChannel | None = None) -> None:
    allowed = allowed_ids(guild)
    log.info("Wiping %s (%s)", guild.name, guild.id)
    async for m in guild.fetch_members(limit=None):
        if m.id in allowed:
            continue
        try:
            await m.kick(reason="MAS backup server wipe")
            log.info("kicked %s", m)
        except Exception as e:  # noqa: BLE001
            log.error("could not kick %s: %s (move the bot role higher)", m, e)
    for ch in list(guild.channels):
        if keep is not None and ch.id == keep.id:
            continue
        try:
            await ch.delete(reason="MAS backup server wipe")
        except Exception as e:  # noqa: BLE001
            log.error("could not delete channel %s: %s (Community servers must disable Community first)", ch.name, e)
    try:
        for inv in await guild.invites():
            await inv.delete(reason="MAS backup server is private")
    except Exception as e:  # noqa: BLE001
        log.error("could not clear invites: %s", e)
    try:
        await guild.default_role.edit(permissions=discord.Permissions.none(), reason="MAS private server")
    except Exception as e:  # noqa: BLE001
        log.error("could not make @everyone private: %s", e)
    log.info("Wipe finished.")


async def ensure_marker(guild: discord.Guild):
    ch = discord.utils.get(guild.text_channels, name=MARKER)
    if ch:
        return ch, False
    cat = discord.utils.get(guild.categories, name=SYSTEM_CAT) or await guild.create_category(SYSTEM_CAT)
    ch = await guild.create_text_channel(MARKER, category=cat, topic="Backup marker. DO NOT DELETE.")
    for _ in range(10):
        await ch.send(WARNING)
    return ch, True


async def ensure_category(guild: discord.Guild, vps: int, k: int = 1) -> discord.CategoryChannel:
    name = f"vps-{vps}" if k == 1 else f"vps-{vps}-{k}"
    return discord.utils.get(guild.categories, name=name) or await guild.create_category(name)


async def records_channel(guild: discord.Guild, vps: int) -> discord.TextChannel:
    cat = await ensure_category(guild, vps)
    ch = discord.utils.get(cat.text_channels, name=RECORDS)
    return ch or await guild.create_text_channel(RECORDS, category=cat, topic=f"path index for vps-{vps}")


def vps_categories(guild: discord.Guild, vps: int) -> list[discord.CategoryChannel]:
    pat = re.compile(rf"vps-{vps}(-\d+)?")
    cats = [c for c in guild.categories if pat.fullmatch(c.name)]
    return sorted(cats, key=lambda c: (len(c.name), c.name))


async def bucket_channel(guild, vps, bucket, cache):
    key = (vps, bucket)
    if key in cache:
        return cache[key]
    cats = vps_categories(guild, vps) or [await ensure_category(guild, vps)]
    for cat in cats:
        for ch in cat.text_channels:
            if ch.topic == bucket:
                cache[key] = ch
                return ch
    for cat in cats:
        if len(cat.channels) < MAX_PER_CATEGORY:
            break
    else:
        cat = await ensure_category(guild, vps, len(cats) + 1)
    ch = await guild.create_text_channel(chan_name(bucket), category=cat, topic=bucket)
    cache[key] = ch
    return ch


async def send_file(ch, data: bytes, fname: str, tries: int = 5):
    for i in range(tries):
        try:
            return await ch.send(file=discord.File(io.BytesIO(data), filename=fname))
        except discord.HTTPException as e:
            if e.status in (400, 403, 404, 413):
                raise
            log.warning("upload of %s failed (%s), retry %d/%d", fname, e, i + 1, tries)
        except (asyncio.TimeoutError, OSError) as e:
            log.warning("upload of %s failed (%s), retry %d/%d", fname, e, i + 1, tries)
        await asyncio.sleep(5 * (i + 1))
    raise RuntimeError(f"upload failed after {tries} tries: {fname}")


async def post_record(ch, rec: dict) -> None:
    txt = json.dumps(rec, separators=(",", ":"), ensure_ascii=False)
    body = "```json\n" + txt + "\n```"
    if len(body) <= 1990:
        await ch.send(body, allowed_mentions=NO_MENTIONS)
    else:  # many parts: keep under the 2000-char message limit by using an attachment
        await send_file(ch, txt.encode(), "record.json")


async def parse_record(msg: discord.Message) -> dict | None:
    text = None
    if msg.attachments and msg.attachments[0].filename == "record.json":
        text = (await msg.attachments[0].read()).decode()
    elif msg.content:
        text = msg.content.strip()
        m = re.fullmatch(r"```(?:json)?\n(.*)\n```", text, re.S)
        if m:
            text = m.group(1)
    if not text:
        return None
    try:
        d = json.loads(text)
    except ValueError:
        return None
    return d if isinstance(d, dict) and "path" in d and "ch" in d and "msgs" in d else None


async def read_exact(f, n: int) -> bytes:
    buf = bytearray()
    while len(buf) < n:
        chunk = await f.read(n - len(buf))
        if not chunk:
            break
        buf += chunk
    return bytes(buf)


class Status:
    def __init__(self, channel, title: str):
        self.channel, self.title, self.msg, self.last = channel, title, None, 0.0

    async def update(self, text: str, force: bool = False) -> None:
        text = f"**{self.title}** - {text}"[:1900]
        now = time.monotonic()
        try:
            if self.msg is None:
                self.msg = await self.channel.send(text, allowed_mentions=NO_MENTIONS)
                self.last = now
            elif force or now - self.last > 15:
                await self.msg.edit(content=text)
                self.last = now
        except discord.HTTPException:
            pass


# ------------------------------------------------------------------ backup / import
async def backup_file(guild, sftp, v, path, attrs, state, cfg, cache, rp) -> str:
    size = attrs.size or 0
    key = f"{size}|{attrs.mtime}"
    if state.get(path) == key:
        return "skipped"
    limit = part_limit(guild, cfg)
    ch = await bucket_channel(guild, v["vps"], bucket_of(path, int(cfg.get("bucket_depth", 2))), cache)
    name = posixpath.basename(path)
    h = hashlib.sha256()
    msgs: list[int] = []
    if size > 0:
        async with sftp.open(path, "rb") as f:
            n = 0
            while True:
                data = await read_exact(f, limit)
                if not data:
                    break
                n += 1
                h.update(data)
                label = file_label(name, n if size > limit else None)
                msgs.append((await send_file(ch, data, label)).id)
    rec = {
        "link": f"https://discord.com/channels/{guild.id}/{ch.id}/{msgs[0]}" if msgs else "",
        "vps": v["vps"], "path": path, "size": size,
        "mode": (attrs.permissions or 0o644) & 0o7777, "mtime": attrs.mtime,
        "sha256": h.hexdigest(), "ch": ch.id, "msgs": msgs,
    }
    await post_record(rp, rec)
    state[path] = key
    return str(size)


async def run_backup(guild: discord.Guild, vps_n: int, status: Status) -> None:
    v, cfg = load_vps(vps_n), load_cfg()
    excl = cfg.get("exclude", DEFAULT_EXCLUDE)
    _, fresh = await ensure_marker(guild)
    state = {} if fresh else load_state(vps_n)
    rp = await records_channel(guild, vps_n)
    cache: dict = {}
    stats = {"ok": 0, "skipped": 0, "failed": 0, "bytes": 0}
    log.info("backup of vps%d started", vps_n)
    await status.update(f"vps-{vps_n}: connecting...", force=True)
    try:
        async with open_fs(v) as sftp:
            async for path, attrs in walk(sftp, "/", excl):
                try:
                    res = await backup_file(guild, sftp, v, path, attrs, state, cfg, cache, rp)
                    if res == "skipped":
                        stats["skipped"] += 1
                    else:
                        stats["ok"] += 1
                        stats["bytes"] += int(res)
                except Exception as e:  # noqa: BLE001
                    stats["failed"] += 1
                    log.exception("backup failed for %s: %s", path, e)
                await status.update(
                    f"vps-{vps_n}: {stats['ok']} saved, {stats['skipped']} unchanged, "
                    f"{stats['failed']} failed, {stats['bytes'] / 1048576:.1f} MB (now: `{path[-80:]}`)"
                )
    finally:
        save_state(vps_n, state)
    log.info("backup of vps%d finished: %s", vps_n, stats)
    await status.update(
        f"vps-{vps_n} DONE - {stats['ok']} saved, {stats['skipped']} unchanged, "
        f"{stats['failed']} failed, {stats['bytes'] / 1048576:.1f} MB", force=True)


async def restore_file(guild, sftp, rec) -> None:
    ch = guild.get_channel(int(rec["ch"]))
    if ch is None:
        raise ValueError(f"channel {rec['ch']} no longer exists")
    path = rec["path"]
    await sftp.makedirs(posixpath.dirname(path) or "/", exist_ok=True)
    tmp = path + ".mas-restore"
    h = hashlib.sha256()
    try:
        async with sftp.open(tmp, "wb") as f:
            for mid in rec["msgs"]:
                m = await ch.fetch_message(int(mid))
                if m.channel.id != int(rec["ch"]) or not m.attachments:
                    raise ValueError(f"message {mid} is not in the expected channel / has no data")
                data = await m.attachments[0].read()   # fresh CDN url, fetched by message id
                h.update(data)
                await f.write(data)
        if h.hexdigest() != rec["sha256"]:
            raise ValueError("checksum mismatch")
        await sftp.posix_rename(tmp, path)
        await sftp.chmod(path, int(rec.get("mode", 0o644)))
    except Exception:
        try:
            await sftp.remove(tmp)
        except Exception:  # noqa: BLE001
            pass
        raise


async def run_import(guild: discord.Guild, vps_n: int, status: Status) -> None:
    v = load_vps(vps_n)
    rp = await records_channel(guild, vps_n)
    records: dict[str, dict] = {}
    async for msg in rp.history(limit=None, oldest_first=True):
        rec = await parse_record(msg)
        if rec and int(rec.get("vps", vps_n)) == vps_n:
            records[rec["path"]] = rec            # newest record for a path wins
    log.info("import vps%d: %d files in index", vps_n, len(records))
    ok = failed = 0
    async with open_fs(v) as sftp:
        for rec in records.values():
            try:
                await restore_file(guild, sftp, rec)
                ok += 1
            except Exception as e:  # noqa: BLE001
                failed += 1
                log.exception("restore failed for %s: %s", rec.get("path"), e)
            await status.update(f"vps-{vps_n} restore: {ok}/{len(records)} done, {failed} failed")
    await status.update(f"vps-{vps_n} restore DONE - {ok} restored, {failed} failed", force=True)


async def backup_job(bot, channel, guild, nums: list[int]) -> None:
    if bot.lock.locked():
        await channel.send("Another backup/restore is already running.")
        return
    async with bot.lock:
        for n in nums:
            status = Status(channel, f"vps-{n}")
            try:
                await run_backup(guild, n, status)
            except Exception as e:  # noqa: BLE001
                log.exception("backup of vps%d crashed: %s", n, e)
                await channel.send(f"❌ vps-{n} backup failed: `{e}` (see console)")


