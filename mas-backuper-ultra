class Confirm(discord.ui.View):
    def __init__(self, owner_id: int, yes: str = "Confirm", no: str = "Cancel"):
        super().__init__(timeout=300)
        self.owner_id, self.ok = owner_id, None
        self.yes_btn.label, self.no_btn.label = yes, no

    async def interaction_check(self, i: discord.Interaction) -> bool:
        return i.user.id == self.owner_id

    @discord.ui.button(style=discord.ButtonStyle.danger)
    async def yes_btn(self, i: discord.Interaction, b: discord.ui.Button):
        self.ok = True
        await i.response.edit_message(view=None)
        self.stop()

    @discord.ui.button(style=discord.ButtonStyle.secondary)
    async def no_btn(self, i: discord.Interaction, b: discord.ui.Button):
        self.ok = False
        await i.response.edit_message(view=None)
        self.stop()


class VpsAddModal(discord.ui.Modal, title="Add VPS"):
    number = discord.ui.TextInput(label="VPS number", placeholder="2", max_length=3)
    host = discord.ui.TextInput(label="VPS IP / host", placeholder="1.2.3.4", max_length=255)
    port = discord.ui.TextInput(label="SSH port", default="22", max_length=5)
    user = discord.ui.TextInput(label="Username", default="root", max_length=64)
    password = discord.ui.TextInput(label="Password", max_length=200)

    async def on_submit(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        try:
            n = int(self.number.value)
            if n < 1:
                raise ValueError("VPS number must be 1 or higher")
            if vps_file(n).exists():
                raise ValueError(f"vps{n} already exists")
            v = {"host": self.host.value.strip(), "port": int(self.port.value),
                 "user": self.user.value.strip(), "password": self.password.value, "vps": n}
            await test_ssh(v)
            save_vps(n, v)
            await ensure_category(interaction.guild, n)
            await records_channel(interaction.guild, n)
            log.info("VPS %d added via /vps add", n)
            await interaction.followup.send(
                f"✅ vps-{n} added. Run `/backup vps:{n}` to start backing it up.", ephemeral=True)
        except Exception as e:  # noqa: BLE001
            log.exception("/vps add failed: %s", e)
            await interaction.followup.send(f"❌ Could not add VPS: `{e}`", ephemeral=True)

    async def on_error(self, interaction: discord.Interaction, error: Exception):
        log.exception("modal error: %s", error)


async def guard(interaction: discord.Interaction) -> bool:
    cfg = load_cfg()
    if interaction.guild is None or interaction.guild_id != int(cfg.get("guild_id", 0)):
        await interaction.response.send_message("Wrong server.", ephemeral=True)
        return False
    if interaction.user.id != interaction.guild.owner_id:
        await interaction.response.send_message("Only the server owner can use this.", ephemeral=True)
        return False
    return True


