@app_commands.command(name="setup", description="Wipe this server (except owner + bot) and set up VPS backups")
async def cmd_setup(interaction: discord.Interaction):
    if not await guard(interaction):
        return
    guild, chan = interaction.guild, interaction.channel
    if backups_exist(guild):
        await interaction.response.send_message("Existing backup data found (`mas-backups`). Nothing was deleted.")
        for _ in range(10):
            await chan.send(WARNING)
        await chan.send("Use `/importbackup vps:<n>` to restore it to a VPS, or `/focusbackup` to delete "
                        "all old backup data and start from scratch.")
        return
    view = Confirm(interaction.user.id, "Yes, wipe everything", "Cancel")
    await interaction.response.send_message(
        "⚠ This deletes **every channel** and kicks **every member** except the owner and this bot. Continue?",
        view=view)
    await view.wait()
    if not view.ok:
        return
    await wipe_guild(guild, keep=chan)
    nums = vps_numbers()
    if not nums:
        await chan.send("Server cleaned. No VPS added yet - use `/vps add`.")
        return
    ask = Confirm(interaction.user.id, "Yes, backup whole VPS now", "Later")
    await chan.send(f"Server cleaned. Backup the whole VPS now? (vps {', '.join(map(str, nums))})", view=ask)
    await ask.wait()
    if ask.ok:
        await backup_job(interaction.client, chan, guild, nums)
    else:
        await chan.send("Okay - run `/backup` whenever you're ready.")


