@app_commands.command(name="importbackup", description="Restore backed-up files from Discord onto a VPS")
async def cmd_import(interaction: discord.Interaction, vps: int):
    if not await guard(interaction):
        return
    if not backups_exist(interaction.guild) or not vps_file(vps).exists():
        await interaction.response.send_message("No backup found, or that VPS isn't added.", ephemeral=True)
        return
    view = Confirm(interaction.user.id, "Restore (overwrites files)", "Cancel")
