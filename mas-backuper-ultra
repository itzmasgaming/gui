    finally:
        conn.close()
        await conn.wait_closed()
    return res


class _Attrs:
    def __init__(self, st):
        self.permissions, self.size, self.mtime = st.st_mode, st.st_size, int(st.st_mtime)


class _Entry:
    def __init__(self, name, st):
        self.filename, self.attrs = name, _Attrs(st)


class _LocalFile:
    def __init__(self, path, mode):
        self.path, self.mode, self.f = path, mode, None

    async def __aenter__(self):
        self.f = await asyncio.to_thread(open, self.path, self.mode)
        return self

    async def __aexit__(self, *a):
        await asyncio.to_thread(self.f.close)

    async def read(self, n):
        return await asyncio.to_thread(self.f.read, n)

    async def write(self, b):
        return await asyncio.to_thread(self.f.write, b)


class LocalSFTP:
    """Same interface as the SFTP client, but for the machine the bot runs on (no SSH needed)."""

    async def readdir(self, p):
        def _r():
            out = []
            with os.scandir(p) as it:
                for e in it:
                    try:
                        out.append(_Entry(e.name, e.stat(follow_symlinks=False)))
                    except OSError:
                        pass
            return out
        return await asyncio.to_thread(_r)

    def open(self, path, mode):
        return _LocalFile(path, mode)

    async def makedirs(self, p, exist_ok=True):
        await asyncio.to_thread(os.makedirs, p, exist_ok=exist_ok)

    async def posix_rename(self, a, b):
        await asyncio.to_thread(os.replace, a, b)

    async def chmod(self, p, mode):
        await asyncio.to_thread(os.chmod, p, mode)

    async def utime(self, p, times):
        await asyncio.to_thread(os.utime, p, times)

    async def remove(self, p):
        await asyncio.to_thread(os.remove, p)


@contextlib.asynccontextmanager
async def open_fs(v: dict):
    """vps flagged local -> this machine; otherwise SFTP over SSH."""
    if v.get("local"):
        yield LocalSFTP()
        return
    conn = await ssh_connect(v)
    try:
        async with conn.start_sftp_client() as sftp:
            yield sftp
    finally:
        conn.close()
        await conn.wait_closed()


def excluded(path: str, excl: list[str]) -> bool:
    for e in excl:
        e = e.rstrip("/")
        if path == e or path.startswith(e + "/"):
            return True
    # never back up the bot's own data (token!) if the VPS is the bot host
    return any(p in (".mas-backup", "mas-backup") for p in path.split("/"))


# Files that hold an IP / port / keys / tunnel or session needed to reach the VPS.
# /importbackup and /copybackup never restore these, so a restore can't cut your access.
#   plain path  -> that file/folder and everything under it
#   has * or ?  -> glob; without a "/" it is matched against every folder/file name in the path
IMPORT_SKIP = [
    "*sshx*",                                   # sshx binary, sessions, logs (/usr/local/bin/sshx, ~/.sshx, /tmp/mas-sshx*)
    "/etc/ssh", "/root/.ssh", "/home/*/.ssh",   # sshd config (port), host keys, authorized_keys, known_hosts
    "/etc/hosts", "/etc/hostname", "/etc/resolv.conf", "/etc/network", "/etc/netplan",
    "/etc/NetworkManager/system-connections", "/etc/systemd/network", "/etc/cloud",
    "/etc/ufw", "/etc/iptables", "/etc/nftables.conf",    # firewall rules (open/closed ports)
    "/etc/wireguard", "/etc/openvpn", "/var/lib/tailscale",
]


def import_skipped(path: str, rules: list[str]) -> bool:
    parts = path.split("/")
    for r in rules:
        if "*" in r or "?" in r:
            if "/" in r:
                if fnmatch.fnmatchcase(path, r) or fnmatch.fnmatchcase(path, r.rstrip("/") + "/*"):
                    return True
            elif any(fnmatch.fnmatchcase(x, r) for x in parts if x):
                return True
        else:
            r = r.rstrip("/")
            if path == r or path.startswith(r + "/"):
                return True
    return False


async def walk(sftp, root: str, excl: list[str]):
    stack = [root]
    while stack:
        d = stack.pop()
        if excluded(d, excl):
            continue
        try:
            entries = await sftp.readdir(d)
        except Exception as e:  # noqa: BLE001
            log.error("cannot list %s: %s", d, e)
            continue
        for e in entries:
            name = e.filename.decode(errors="replace") if isinstance(e.filename, bytes) else e.filename
            if name in (".", ".."):
                continue
            full = d.rstrip("/") + "/" + name
            perm = e.attrs.permissions or 0
            if stat.S_ISDIR(perm):
                stack.append(full)
            elif stat.S_ISREG(perm):      # symlinks/devices/sockets are skipped
                yield full, e.attrs


