def upterm_pubkey() -> str:
    """The bot's public key (made once). It goes into the command the VPS owner runs, so ONLY this bot can join."""
    if not UPTERM_KEY.exists():
        DATA_DIR.mkdir(parents=True, exist_ok=True)
        key = asyncssh.generate_private_key("ssh-ed25519")
        fd = os.open(UPTERM_KEY, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(key.export_private_key())
        os.chmod(UPTERM_KEY, 0o600)
    pub = asyncssh.read_private_key(str(UPTERM_KEY)).export_public_key().decode().split()
    return f"{pub[0]} {pub[1]} mas-bot"


def upterm_command() -> str:
    """The one command the VPS owner pastes on the VPS: installs Upterm, starts a background session, prints the ssh line."""
    return ("ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); mkdir -p ~/.mas && "
            f"curl -fsSL {UPTERM_URL}/upterm_linux_$ARCH.tar.gz | tar xz -C ~/.mas upterm && "
            f"echo '{upterm_pubkey()}' > ~/.mas/bot.pub && "
            "~/.mas/upterm host --accept --detach --skip-host-key-check --authorized-keys ~/.mas/bot.pub -- sh")


def parse_upterm(text: str) -> tuple[str, str, int]:
    """Pull (token, host, port) out of whatever the person pasted: the `ssh TOKEN@host [-p N]` line, the whole
    output of the command, an ssh:// link, or a bare TOKEN@host."""
    t = text.replace("`", " ").replace("➤", " ")
    m = re.search(r"(?<![\w/])ssh\s+(?:-\S+\s+)*([^\s@/]+)@([A-Za-z0-9.\-]+)(?::(\d+))?(?:\s+-p\s*(\d+))?", t)
    if not m:
        m = re.search(r"ssh://([^\s@/]+)@([A-Za-z0-9.\-]+)(?::(\d+))?()", t)
    if not m:
        m = re.search(r"(?<![\w/])([A-Za-z0-9+/=_:\-]{8,})@([A-Za-z0-9.\-]+)(?::(\d+))?()", t)
    if not m:
        raise ValueError("I couldn't find an `ssh TOKEN@host` line in what you pasted.")
    token, host = m.group(1), m.group(2)
    port = int(m.group(3) or m.group(4) or 22)
    if not 0 < port < 65536:
        raise ValueError("That port number isn't valid.")
    return token, host, port


def remote_label(v: dict, port: bool = False) -> str:
    """Short 'where is this VPS' text. An Upterm VPS never shows its token."""
    if v.get("upterm"):
        return f"Upterm tunnel ({v.get('host', UPTERM_HOST)})"
    return str(v.get("user", "?")) + "@" + str(v.get("host", "?")) + (":" + str(v.get("port", 22)) if port else "")


async def ssh_connect(v: dict):
    if v.get("upterm"):          # key login to the Upterm relay; the "user" is the session token
        return await asyncio.wait_for(asyncssh.connect(
            v.get("host", UPTERM_HOST), port=int(v.get("port", 22)), username=v["user"],
            client_keys=[str(UPTERM_KEY)], known_hosts=None, keepalive_interval=30,
            preferred_auth="publickey"), 25)
    # known_hosts=None disables host-key checking (simple, but open to MITM).
    return await asyncssh.connect(
        v["host"], port=int(v.get("port", 22)), username=v.get("user", "root"),
        password=v.get("password") or None, known_hosts=None, keepalive_interval=30,
    )


