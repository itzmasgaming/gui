# ------------------------------------------------------------------ shared helpers for /sshx and /access
_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07]*\x07")


def conn_error(e: Exception) -> str:
    if isinstance(e, asyncssh.PermissionDenied):
        return "The VPS answered but refused the login (did the user/password change?)."
    if isinstance(e, asyncio.TimeoutError):
        return "The VPS did not answer in time (it may be offline)."
    return (str(e) or type(e).__name__)[:300]


async def run_script(v: dict, script: str, timeout: float = 60) -> str:
    """Run a small shell script on the VPS (or on this machine for a local VPS) and return its output."""
    if v.get("local"):
        proc = await asyncio.create_subprocess_exec(
            "sh", "-s", stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.STDOUT)
        data, _ = await asyncio.wait_for(proc.communicate(script.encode()), timeout)
        return data.decode(errors="replace")
    conn = await asyncio.wait_for(ssh_connect(v), 15)
    try:
        if v.get("upterm"):
            return (await upterm_exec(conn, script, timeout, 200000)).decode(errors="replace")
        res = await asyncio.wait_for(conn.run("sh -s", input=script, check=False), timeout)
        out = res.stdout
        return out if isinstance(out, str) else (out or b"").decode(errors="replace")
    finally:
        conn.close()
        await conn.wait_closed()


def where_of(v: dict) -> str:
    return "this machine (local)" if v.get("local") else remote_label(v, True)


