# Run with:  bash <(curl -fsSL https://raw.githubusercontent.com/itzmasgaming/gui/main/mas-discord-bot-backuper.txt)

AQUA=$'\e[38;5;51m'; RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; BOLD=$'\e[1m'; RST=$'\e[0m'
W=48

if [[ $EUID -eq 0 ]]; then DATA_DIR="/opt/mas-backup"; else DATA_DIR="$HOME/.mas-backup"; fi
export MAS_DATA_DIR="$DATA_DIR"
PY="$DATA_DIR/venv/bin/python"
BOT="$DATA_DIR/mas_backup_bot.py"
LOG="$DATA_DIR/bot.log"
PIDFILE="$DATA_DIR/bot.pid"

center() {
  local t="$1" pad l r
  pad=$(( W - ${#t} )); l=$(( pad / 2 )); r=$(( pad - l ))
  printf '┃%*s%s%*s┃\n' "$l" '' "$t" "$r" ''
}

header() {
  local sub="$1" line
  line="$(printf '━%.0s' $(seq 1 $W))"
  clear
  echo
  echo "${AQUA}┏${line}┓"
  center ""
  center "◆ MAS GUI ◆"
  center "$sub"
  center "v6.0"
  center ""
  echo "┗${line}┛${RST}"
  echo
}

err()   { echo "  ${RED}✖ $*${RST}"; }
ok()    { echo "  ${GRN}✔ $*${RST}"; }
warn()  { echo "  ${YLW}⚠ $*${RST}"; }
pause() { echo; read -rp "  Press Enter to continue..." _; }

