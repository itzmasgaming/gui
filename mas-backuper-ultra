#!/bin/bash
# MAS GUI - protected loader (15 layers: base64 + ROT, gzip packed)
# self-decoding wrapper - do not edit
case "${BASH_SOURCE[0]}" in
  /dev/fd/*) [ -z "${MAS_LD:-}" ] && exec env MAS_LD=1 bash <(tr -d '\r' <&"${BASH_SOURCE[0]#/dev/fd/}") "$@" ;;
  *) grep -q $'\r' "${BASH_SOURCE[0]}" && [ -z "${MAS_LD:-}" ] && exec env MAS_LD=1 bash <(tr -d '\r' <"${BASH_SOURCE[0]}") "$@" ;;
esac

_C1=$'\033[1;36m'; _C2=$'\033[1;33m'; _C3=$'\033[1;32m'; _C0=$'\033[0m'
printf '\n'
printf '  %s============================================%s\n' "$_C1" "$_C0"
printf '  %s   MAS Gui  -  Protected Loader%s\n' "$_C1" "$_C0"
printf '  %s============================================%s\n' "$_C1" "$_C0"
printf '\n'
printf '  %s>>> Loading GUI, please wait a few minutes...%s\n' "$_C2" "$_C0"
printf '  %s    It is loading - this takes a few seconds to a few minutes.%s\n' "$_C0" "$_C0"
printf '\n'

_spin() {
  local s='|/-\\' i=0
  while :; do
    printf '\r  %s[%s]%s decoding protected payload ... ' "$_C2" "${s:i++%4:1}" "$_C0"
    sleep 0.15
  done
}
_spin &
_spid=$!
trap 'kill $_spid 2>/dev/null' EXIT

p=""

_pad=""

kill "$_spid" 2>/dev/null
wait "$_spid" 2>/dev/null
printf '\r%*s\r' 80 ''
printf '  %s[+]%s payload decoded - starting...\n\n' "$_C3" "$_C0"

exec bash <(printf %s "$p" | tr 'PQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNO' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'OPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMN' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'NOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLM' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'MNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHIJKL' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'LMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHIJK' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'KLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHIJ' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'JKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGHI' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'IJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFGH' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'HIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEFG' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'GHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDEF' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'FGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCDE' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'EFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABCD' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'DEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzABC' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'CDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzAB' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | tr 'BCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyzA' 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz' | base64 -d | gunzip)
