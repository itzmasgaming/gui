SSHX_SCRIPT = r'''
export PATH="$PATH:/usr/local/bin:/usr/bin:$HOME/.local/bin:$HOME/.sshx/bin:$HOME/bin:/root/.local/bin"
if ! command -v sshx >/dev/null 2>&1; then
  if command -v curl >/dev/null 2>&1; then
    curl -sSf https://sshx.io/get | sh >/tmp/mas-sshx-install.log 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- https://sshx.io/get | sh >/tmp/mas-sshx-install.log 2>&1
  else
    echo "NO_FETCH=1"; exit 0
  fi
fi
BIN=$(command -v sshx 2>/dev/null)
if [ -z "$BIN" ]; then
  echo "NO_SSHX=1"
  echo "LOG=$(tail -c 300 /tmp/mas-sshx-install.log 2>/dev/null | tr '\n' ' ')"
  exit 0
fi
LOG=$(mktemp /tmp/mas-sshx.XXXXXX 2>/dev/null || echo /tmp/mas-sshx.$$)
if command -v setsid >/dev/null 2>&1; then
  setsid nohup "$BIN" >"$LOG" 2>&1 </dev/null &
else
  nohup "$BIN" >"$LOG" 2>&1 </dev/null &
fi
PID=$!
ESC=$(printf '\033')
i=0; URL=""
while [ $i -lt 40 ]; do
  URL=$(sed "s/${ESC}\[[0-9;?]*[A-Za-z]//g" "$LOG" 2>/dev/null | grep -o 'https://sshx\.io/[^[:space:]]*' | head -n1)
  [ -n "$URL" ] && break
  i=$((i+1)); sleep 1
done
echo "PID=$PID"
echo "URL=$URL"
[ -z "$URL" ] && echo "LOG=$(sed "s/${ESC}\[[0-9;?]*[A-Za-z]//g" "$LOG" 2>/dev/null | tail -c 400 | tr '\n' ' ')"
'''
_SSHX_URL = re.compile(r"https://sshx\.io/[^\s\"'<>]+")


class SshxView(discord.ui.View):
    """Private message: a link button (the link is never printed as text) + a stop button."""

    def __init__(self, owner_id: int, n: int, v: dict, pid: str, url: str):
        super().__init__(timeout=3600)
        self.owner_id, self.n, self.v, self.pid = owner_id, n, v, pid
        self.clear_items()
        self.add_item(discord.ui.Button(label="Open sshx terminal", emoji="🔗", style=discord.ButtonStyle.link, url=url))
        self.add_item(self.stop_btn)

    async def interaction_check(self, i: discord.Interaction) -> bool:
        return i.user.id == self.owner_id

    @discord.ui.button(label="Stop session", emoji="🛑", style=discord.ButtonStyle.danger)
    async def stop_btn(self, i: discord.Interaction, b: discord.ui.Button):
        await i.response.edit_message(embed=ui("wait", f"Stopping sshx on vps-{self.n}…"), view=None)
        try:
            if self.pid.isdigit():
                await run_script(self.v, f"kill {self.pid} 2>/dev/null; sleep 1; kill -9 {self.pid} 2>/dev/null; echo done", 30)
            await i.edit_original_response(embed=ui("ok", "sshx session stopped",
                                                    f"The link for **vps-{self.n}** no longer works."))
        except Exception as e:  # noqa: BLE001
            await i.edit_original_response(embed=ui("error", "Could not stop the session", conn_error(e)))
        self.stop()


