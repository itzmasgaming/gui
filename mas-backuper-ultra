def client_id_from_token(token: str) -> int:
    part = token.split(".")[0]
    return int(base64.b64decode(part + "=" * (-len(part) % 4)).decode())


class WipeClient(discord.Client):
    def __init__(self, gid: int):
        intents = discord.Intents.default()
        intents.members = True
        super().__init__(intents=intents)
        self.gid, self.code = gid, 1

    async def on_ready(self):
        try:
            guild = self.get_guild(self.gid)
            if guild is None:
                log.error("The bot is not in that server. Invite it first (option 1 prints the link).")
                return
            found = backup_findings(guild)
            if found:                                   # look BEFORE touching anything
                log.error("Backup data found (%s). Nothing was deleted.", ", ".join(found[:6]))
                self.code = 4
                return
            talk = await ensure_talk(guild)
            await wipe_guild(guild, keep=talk)
            await talk.send("Server is clean and private. Run `/setup` after adding a VPS (menu option 2).")
            log.info("Server is clean and private. Command channel: #%s", talk.name)
            self.code = 0
        except Exception as e:  # noqa: BLE001
            log.exception("wipe failed: %s", e)
        finally:
            await self.close()


class InspectClient(discord.Client):
    """Read-only: exit 0 = empty server, 4 = backup data found, 3 = bot not in the server."""

    def __init__(self, gid: int):
        super().__init__(intents=discord.Intents.default())
        self.gid, self.code = gid, 3

    async def on_ready(self):
        g = self.get_guild(self.gid)
        if g:
            found = backup_findings(g)
            if found:
                log.info("Existing backup data found: %s", ", ".join(found[:8]))
                self.code = 4
            else:
                log.info("No backup data in this server.")
                self.code = 0
        await self.close()


class ProtectClient(discord.Client):
    """Makes a server with backups private WITHOUT deleting anything or kicking anyone."""

    def __init__(self, gid: int):
        super().__init__(intents=discord.Intents.default())
        self.gid, self.code = gid, 1

    async def on_ready(self):
        try:
            g = self.get_guild(self.gid)
            if g:
                await ensure_talk(g)
                try:
                    for inv in await g.invites():
                        await inv.delete(reason="MAS backup server is private")
                    await g.default_role.edit(permissions=discord.Permissions.none(), reason="MAS private server")
                except Exception as e:  # noqa: BLE001
                    log.error("could not fully lock the server: %s", e)
                log.info("Server kept as is (nothing deleted). Command channel: #%s", TALK)
                self.code = 0
        except Exception as e:  # noqa: BLE001
            log.exception("protect failed: %s", e)
        finally:
            await self.close()


class CheckClient(discord.Client):
    def __init__(self, gid: int):
        super().__init__(intents=discord.Intents.default())
        self.gid, self.code = gid, 3

    async def on_ready(self):
        g = self.get_guild(self.gid)
        if g:
            log.info("Bot is in the server: %s", g.name)
            self.code = 0
        await self.close()


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["set-token", "migrate-token", "set-guild", "invite", "wipe",
                                    "add-local", "add-vps", "check", "inspect", "protect", "run"])
    args = ap.parse_args()
    setup_logging()
    cfg = load_cfg()

    if args.cmd == "set-token":
        token = os.environ.get("MAS_TOKEN", "").strip()
        try:
            client_id_from_token(token)
        except Exception:  # noqa: BLE001
            log.error("That doesn't look like a bot token.")
            return 1
        env = load_env()
        env["DISCORD_TOKEN"] = token
        save_env(env)
        if "token" in cfg:                       # never keep the secret in two places
            cfg.pop("token")
            save_cfg(cfg)
        log.info("Token saved to %s (chmod 600).", ENV_FILE)
        return 0

    if args.cmd == "migrate-token":
        print(migrate_token())
        return 0

    if args.cmd == "set-guild":
        cfg["guild_id"] = int(os.environ["MAS_GUILD"])
        save_cfg(cfg)
        return 0

    if args.cmd == "add-local":
        for n in vps_numbers():
            if load_vps(n).get("local"):
                log.info("This VPS is already added as vps%d.", n)
                print(n)
                return 0
        n = next_vps_number()
        save_vps(n, {"local": True, "host": "localhost", "user": "local"})
        print(n)
        return 0

    if args.cmd == "add-vps":
        v = {"host": os.environ["MAS_V_HOST"], "port": int(os.environ["MAS_V_PORT"]),
             "user": os.environ["MAS_V_USER"], "password": os.environ["MAS_V_PASS"]}
        try:
            asyncio.run(test_ssh(v))
        except Exception as e:  # noqa: BLE001
            log.error("SSH connection failed: %s", e)
            return 1
        n = next_vps_number()
        save_vps(n, v)
        print(n)
        return 0

    token = get_token()
    if not token:
        log.error("No bot token configured. Use menu option 1.")
        return 1

    if args.cmd == "invite":
        perms = discord.Permissions(
            view_channel=True, send_messages=True, embed_links=True, attach_files=True,
            read_message_history=True, manage_channels=True, manage_guild=True,
            manage_roles=True, kick_members=True)
        print(discord.utils.oauth_url(client_id_from_token(token), permissions=perms,
                                      scopes=("bot", "applications.commands")))
        return 0

    if "guild_id" not in cfg:
        log.error("No server configured. Use menu option 1.")
        return 1

    try:
        if args.cmd == "check":
            c = CheckClient(int(cfg["guild_id"]))
            c.run(token, log_handler=None)
            return c.code
        if args.cmd in ("inspect", "protect"):
            c = (InspectClient if args.cmd == "inspect" else ProtectClient)(int(cfg["guild_id"]))
            c.run(token, log_handler=None)
            return c.code
        if args.cmd == "wipe":
            c = WipeClient(int(cfg["guild_id"]))
            c.run(token, log_handler=None)
            return c.code
        Bot(cfg).run(token, log_handler=None)
    except discord.LoginFailure:
        log.error("Discord rejected the bot token.")
        return 1
    except discord.PrivilegedIntentsRequired:
        log.error("Enable 'Server Members Intent' in the Developer Portal (Bot tab).")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
MAS_BOT_EOF
}

# where the latest copy of this script lives (first one that works is used)
SELF_URL="${MAS_SELF_URL:-https://itzmasgaming.github.io/gui/$MAS_FILE}"
FALLBACK_URL="${MAS_FALLBACK_URL:-https://raw.githubusercontent.com/$MAS_REPO/main/$MAS_FILE}"

fetch_latest() {   # fetch_latest <output-file>
  local u
  for u in "$SELF_URL" "$FALLBACK_URL"; do
    curl -fsSL --max-time 20 "$u?$(date +%s)" -o "$1" 2>/dev/null && [[ -s "$1" ]] && return 0
  done
  return 1
}

run_quiet() {   # run a command, keep its output in install.log, show the tail only on failure
  mkdir -p "$DATA_DIR"
  "$@" >> "$DATA_DIR/install.log" 2>&1 || { tail -n 8 "$DATA_DIR/install.log" | sed 's/^/    /'; return 1; }
}

# pkg_install base|build  -> installs system packages with whatever package manager the VPS has
pkg_install() {
  local S="" pk
  if [[ $EUID -ne 0 ]]; then
    command -v sudo >/dev/null 2>&1 || { err "Root is needed to install packages. Re-run as root (sudo -i)."; return 1; }
    S="sudo"
  fi
  if command -v apt-get >/dev/null 2>&1; then
    case "$1" in
      base)  pk="python3 python3-venv python3-pip curl ca-certificates" ;;
      build) pk="build-essential python3-dev libffi-dev libssl-dev" ;;
    esac
    run_quiet $S env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a apt-get update -qq || return 1
    run_quiet $S env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a apt-get install -y -qq -o DPkg::Lock::Timeout=180 $pk
  elif command -v dnf >/dev/null 2>&1 || command -v yum >/dev/null 2>&1; then
    local pm="dnf"; command -v dnf >/dev/null 2>&1 || pm="yum"
    case "$1" in
      base)  pk="python3 python3-pip curl ca-certificates" ;;
      build) pk="gcc python3-devel libffi-devel openssl-devel" ;;
    esac
    run_quiet $S $pm install -y -q $pk
  elif command -v apk >/dev/null 2>&1; then
    case "$1" in
      base)  pk="python3 py3-pip curl ca-certificates" ;;
      build) pk="build-base python3-dev libffi-dev openssl-dev" ;;
    esac
    run_quiet $S apk add --no-cache $pk
  elif command -v pacman >/dev/null 2>&1; then
    case "$1" in
      base)  pk="python python-pip curl ca-certificates" ;;
      build) pk="base-devel" ;;
    esac
    run_quiet $S pacman -Sy --noconfirm --needed $pk
  elif command -v zypper >/dev/null 2>&1; then
    case "$1" in
      base)  pk="python3 python3-pip curl ca-certificates" ;;
      build) pk="gcc python3-devel libffi-devel libopenssl-devel" ;;
    esac
    run_quiet $S zypper -n install $pk
  else
    err "Unknown package manager. Install python3 (3.9+), venv, pip and curl manually."
    return 1
  fi
}

ensure_deps() {
  mkdir -p "$DATA_DIR" && chmod 700 "$DATA_DIR"

  # 1) system packages (python3 + venv + pip + curl) - installed automatically if missing
  if ! command -v python3 >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1 \
     || ! python3 -c 'import venv, ensurepip' >/dev/null 2>&1; then
    echo "  Installing system packages (python3, venv, pip, curl)... this can take a minute"
    pkg_install base || { err "Could not install the required system packages."; return 1; }
  fi
  if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
    err "Python 3.9 or newer is required (found $(python3 -V 2>&1)). Use a newer OS image."
    return 1
  fi

  # 2) virtual environment (a half-created one without pip is rebuilt)
  if [[ ! -x "$DATA_DIR/venv/bin/python" || ! -x "$DATA_DIR/venv/bin/pip" || ! -f "$DATA_DIR/venv/pyvenv.cfg" ]]; then
    echo "  Creating Python environment..."
    rm -rf "$DATA_DIR/venv"
    python3 -m venv "$DATA_DIR/venv" >> "$DATA_DIR/install.log" 2>&1 || {
      pkg_install base && rm -rf "$DATA_DIR/venv" && python3 -m venv "$DATA_DIR/venv" >> "$DATA_DIR/install.log" 2>&1
    } || { err "Could not create the Python environment (see $DATA_DIR/install.log)."; return 1; }
  fi

  # 3) python libraries (build tools are installed only if a wheel isn't available for this CPU)
  if ! "$PY" -c "import discord, asyncssh" 2>/dev/null; then
    echo "  Installing discord.py + asyncssh..."
    if ! run_quiet "$PY" -m pip install -q -U pip discord.py asyncssh; then
      echo "  Installing build tools and retrying..."
      pkg_install build && run_quiet "$PY" -m pip install -q -U discord.py asyncssh \
        || { err "pip install failed (see $DATA_DIR/install.log)"; return 1; }
    fi
  fi
  return 0
}

ensure_env() {
  ensure_deps || return 1
  write_bot
  "$PY" "$BOT" migrate-token >/dev/null 2>&1   # token lives in .env, not in config.json
  return 0
}

start_bot() {
  if [[ $EUID -eq 0 ]] && command -v systemctl >/dev/null 2>&1; then
    cat > /etc/systemd/system/mas-backup-bot.service <<UNIT
[Unit]
Description=MAS Auto Backup Bot
After=network-online.target
Wants=network-online.target

[Service]
Environment=MAS_DATA_DIR=$DATA_DIR
ExecStart=$PY $BOT run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
    systemctl daemon-reload
    systemctl enable mas-backup-bot >/dev/null 2>&1
    systemctl restart mas-backup-bot
    ok "Bot is online (systemd service: mas-backup-bot)"
    echo "  Console/errors:  journalctl -u mas-backup-bot -f"
  else
    [[ -f "$PIDFILE" ]] && kill "$(cat "$PIDFILE")" 2>/dev/null
    nohup "$PY" "$BOT" run >> "$LOG" 2>&1 &
    echo $! > "$PIDFILE"
    ok "Bot is online (pid $(cat "$PIDFILE"))"
    echo "  Console/errors:  tail -f $LOG"
  fi
}

bot_running() {
  if [[ $EUID -eq 0 ]] && command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet mas-backup-bot 2>/dev/null; then
    return 0
  fi
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

# returns 0 if something was stopped
do_stop() {
  local stopped=1
  if [[ $EUID -eq 0 ]] && command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q mas-backup-bot; then
    systemctl stop mas-backup-bot
    systemctl disable mas-backup-bot >/dev/null 2>&1   # stay off after a reboot too
    stopped=0
  fi
  if [[ -f "$PIDFILE" ]]; then
    if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      kill "$(cat "$PIDFILE")" 2>/dev/null
      stopped=0
    fi
    rm -f "$PIDFILE"
  fi
  return $stopped
}

stop_bot() {
  header "Stop Bot"
  if do_stop; then
    ok "Bot stopped. Use option 5 to start it again."
  else
    warn "Bot was not running."
  fi
  pause
}

bot_status() {
  header "Bot Status"
  if [[ $EUID -eq 0 ]] && command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files | grep -q mas-backup-bot; then
    systemctl --no-pager status mas-backup-bot | head -n 12
  elif [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    ok "Running (pid $(cat "$PIDFILE"))"
  else
    warn "Bot is not running."
  fi
  echo
  echo "  Last log lines:"
  [[ -f "$LOG" ]] && tail -n 15 "$LOG" | sed 's/^/    /'
  pause
}

# ---------------------------------------------------------------- 1) Setup Discord bot
setup_discord_bot() {
  header "Setup Discord Bot"
  ensure_env || { pause; return; }

  echo "  1) Go to https://discord.com/developers/applications"
  echo "  2) Create an app -> Bot tab -> enable ${BOLD}Server Members Intent${RST}"
  echo "  3) Copy the bot token"
  echo
  read -rsp "  Bot token: " token; echo
  [[ -z "$token" ]] && { err "No token entered."; pause; return; }
  MAS_TOKEN="$token" "$PY" "$BOT" set-token || { pause; return; }
  unset token

  echo
  echo "  Invite the bot to your ${BOLD}backup-only${RST} server with this link"
  echo "  (it already contains the required permissions):"
  echo
  "$PY" "$BOT" invite
  echo
  echo "  After it joins, drag the bot's role to the TOP of the role list"
  echo "  (Server Settings -> Roles) so it is allowed to remove members."
  echo
  read -rp "  Press Enter once the bot has joined the server..." _

  read -rp "  Server ID (17-20 digits): " gid
  if ! [[ "$gid" =~ ^[0-9]{17,20}$ ]]; then
    err "That doesn't look like a Discord server ID."; pause; return
  fi
  MAS_GUILD="$gid" "$PY" "$BOT" set-guild || { pause; return; }

  # LOOK FIRST: never wipe a server that already holds backups
  echo
  echo "  Checking the server for existing backup data..."
  "$PY" "$BOT" inspect; rc=$?
  case $rc in
    0) ;;   # empty server: safe to set up
    3) echo; err "The bot isn't in that server yet. Add it with the invite link above, then try again."
       pause; return ;;
    4) echo
       ok "Existing backup data found - NOTHING was deleted and nobody was removed."
       "$PY" "$BOT" protect
       echo
       start_bot
       echo
       echo "  In Discord (#talk-cmds-here):"
       echo "    /importbackup vps:<n>   restore that VPS from the backup"
       echo "    /focusbackup vps:<n>    delete the old backup and start fresh (only if you want that)"
       pause; return ;;
    *) echo; err "Could not inspect the server (see error above). Nothing was changed."
       pause; return ;;
  esac

  echo
  echo "  ${RED}${BOLD}⚠ WARNING${RST}"
  echo "  This server is empty of backups and will be ${BOLD}WIPED${RST}:"
  echo "    • every member except you (the owner) and the bot is removed"
  echo "    • every channel and category is deleted"
  echo "    • the server is made private (invites removed, anyone who joins is kicked)"
  echo "  Only use a server that exists ${BOLD}only for backups${RST}."
  echo
  read -rp "  Type the server ID again to confirm: " again
  if [[ "$again" != "$gid" ]]; then
    warn "IDs did not match. Cancelled, nothing was changed."; pause; return
  fi

  "$PY" "$BOT" wipe; rc=$?
  if [[ $rc -eq 0 ]]; then
    echo
    start_bot      # keeps the server private: anyone who joins gets kicked
  elif [[ $rc -eq 4 ]]; then
    warn "Backup data appeared in the server - wipe refused, nothing was deleted."
  fi
  pause
}

# ---------------------------------------------------------------- start bot (checks server first)
start_bot_flow() {
  if ! grep -q '"guild_id"' "$DATA_DIR/config.json" 2>/dev/null; then
    err "Run option 1 (Setup Discord bot) first."; return 1
  fi
  while true; do
    echo "  Checking if the bot is in the server..."
    "$PY" "$BOT" check; rc=$?
    if [[ $rc -eq 0 ]]; then
      start_bot
      return 0
    elif [[ $rc -eq 3 ]]; then
      echo; err "Bot isn't in the server."
    else
      echo; err "Could not check the server (see error above)."
    fi
    echo
    echo "  Invite link (add the bot, then choose 2):"
    "$PY" "$BOT" invite
    echo
    echo "  ${AQUA}❯${RST} 1 Change server ID"
    echo "  ${AQUA}❯${RST} 2 Try again"
    echo "  ${AQUA}❯${RST} 0 Exit"
    echo
    read -rp "  Select an option: " c
    case "$c" in
      1) read -rp "  New server ID (17-20 digits): " gid
         if [[ "$gid" =~ ^[0-9]{17,20}$ ]]; then
           MAS_GUILD="$gid" "$PY" "$BOT" set-guild && ok "Server ID changed."
         else
           err "That doesn't look like a Discord server ID."
         fi ;;
      2) ;;
      0) return 1 ;;
      *) err "Invalid option" ;;
    esac
    echo
  done
}

# ---------------------------------------------------------------- 2) Setup LVIB
setup_lvib() {
  header "Setup LVIB"
  ensure_env || { pause; return; }
  if ! grep -q '"guild_id"' "$DATA_DIR/config.json" 2>/dev/null; then
    err "Run option 1 (Setup Discord bot) first."; pause; return
  fi

  # The bot runs on the VPS it backs up, so no IP / port / password is needed.
  num="$("$PY" "$BOT" add-local)" || { err "Could not add this VPS."; pause; return; }
  ok "This VPS is loaded as vps${num}  ($DATA_DIR/vps${num}.itzmasgaming)"
  echo
  start_bot_flow && {
    echo
    echo "  Next: in your Discord backup server (#talk-cmds-here), run  ${BOLD}/setup${RST}"
    echo "  Other VPS later:  ${BOLD}/vps add${RST}"
  }
  pause
}

# ---------------------------------------------------------------- 5) Start bot
start_bot_menu() {
  header "Start Bot"
  ensure_env || { pause; return; }
  start_bot_flow
  pause
}

# ---------------------------------------------------------------- 7) Update bot
update_bot() {
  header "Update Bot"
  command -v curl >/dev/null || { err "curl is required"; pause; return; }
  ensure_deps || { pause; return; }

  local was_running=0 tmp new
  bot_running && was_running=1

  echo "  Stopping bot..."
  do_stop >/dev/null 2>&1

  echo "  Downloading the latest bot code..."
  tmp="$(mktemp)"; new="$(mktemp)"
  if ! fetch_latest "$tmp"; then
    err "Download failed. Tried: $SELF_URL  and  $FALLBACK_URL"
    rm -f "$tmp" "$new"
    [[ $was_running -eq 1 ]] && start_bot
    pause; return
  fi

  # pull the embedded bot out of the downloaded file
  awk '/^cat > "\$BOT" <<.MAS_BOT_EOF.$/{f=1;next} /^MAS_BOT_EOF$/{f=0} f' "$tmp" > "$new"
  if [[ ! -s "$new" ]] || ! python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$new" 2>/dev/null; then
    err "Downloaded code looks broken - keeping the current bot."
    rm -f "$tmp" "$new"
    [[ $was_running -eq 1 ]] && start_bot
    pause; return
  fi

  [[ -f "$BOT" ]] && cp "$BOT" "$BOT.bak"
  mv "$new" "$BOT"; rm -f "$tmp"
  ok "Bot code updated (previous version kept as mas_backup_bot.py.bak)"

  # token: make sure it lives in .env (if it's already there, only the code changes)
  case "$("$PY" "$BOT" migrate-token 2>/dev/null)" in
    moved)          ok "Token moved from config.json into $DATA_DIR/.env" ;;
    already-in-env) ok "Token already in .env (removed the duplicate from config.json)" ;;
    ok)             ok "Token already in .env" ;;
    *)              warn "No token saved yet - use option 1." ;;
  esac

  if [[ $was_running -eq 1 ]]; then
    echo
    start_bot
  else
    echo "  Bot was off - use option 5 to start it."
  fi
  pause
}

# ---------------------------------------------------------------- Auto Backup menu
auto_backup_menu() {
  while true; do
    header "Auto Backup"
    echo "  ${AQUA}❯${RST} 1 Setup Discord bot"
    echo "  ${AQUA}❯${RST} 2 Setup LVIB (Load VPS into bot)"
    echo "  ${AQUA}❯${RST} 3 Bot status / logs"
    echo "  ${AQUA}❯${RST} 4 Coming soon"
    echo "  ${AQUA}❯${RST} 5 Start bot"
    echo "  ${AQUA}❯${RST} 6 Stop bot"
    echo "  ${AQUA}❯${RST} 7 Update bot"
    echo "  ${AQUA}❯${RST} 0 Back"
    echo
    read -rp "  Select an option: " choice
    case "$choice" in
      1) setup_discord_bot ;;
      2) setup_lvib ;;
      3) bot_status ;;
      4) echo "  Coming soon..."; sleep 1 ;;
      5) start_bot_menu ;;
      6) stop_bot ;;
      7) update_bot ;;
      0) return ;;
      *) err "Invalid option"; sleep 1 ;;
    esac
  done
}

# ---------------------------------------------------------------- 3) Version
show_version() {
  header "Version"
  local latest_ver latest_date iso bot_ver api
  api="${MAS_API_URL:-https://api.github.com/repos/$MAS_REPO/commits?path=$MAS_FILE&per_page=1}"

  bot_ver="$(grep -m1 '^VERSION = ' "$BOT" 2>/dev/null | cut -d'"' -f2)"
  echo "  ${BOLD}This copy${RST}"
  echo "    Menu : v$MAS_VERSION   (built $MAS_UPDATED)"
  if [[ -n "$bot_ver" ]]; then echo "    Bot  : v$bot_ver"; else echo "    Bot  : not installed yet (use option 1)"; fi
  echo
  echo "  Checking GitHub for the latest version..."
  local remote rtmp
  rtmp="$(mktemp)"
  fetch_latest "$rtmp" && remote="$(cat "$rtmp")"
  rm -f "$rtmp"
  latest_ver="$(printf '%s\n' "$remote" | grep -m1 '^MAS_VERSION=' | cut -d'"' -f2)"
  latest_date="$(printf '%s\n' "$remote" | grep -m1 '^MAS_UPDATED=' | cut -d'"' -f2)"
  # the commit time on GitHub is the real "last updated" moment, when it can be read
  iso="$(curl -fsSL --max-time 10 "$api" 2>/dev/null | grep -o '"date": *"[^"]*"' | tail -n1 | cut -d'"' -f4)"
  if [[ -n "$iso" ]]; then
    latest_date="$(date -u -d "$iso" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || echo "${iso/T/ } UTC")"
  fi
  echo
  if [[ -z "$latest_ver" ]]; then
    warn "Could not reach GitHub (offline, or the file moved)."
  else
    echo "  ${BOLD}Latest on GitHub${RST}"
    echo "    v$latest_ver   (updated $latest_date)"
    echo
    if [[ "$latest_ver" == "$MAS_VERSION" ]]; then
      ok "You're up to date."
    elif [[ "$(printf '%s\n%s\n' "$MAS_VERSION" "$latest_ver" | sort -V | tail -n1)" == "$latest_ver" ]]; then
      warn "A newer version is available: run the command again, then use Auto Backup -> 7 (Update bot)."
    else
      ok "This copy is newer than what is on GitHub."
    fi
  fi
  pause
}

