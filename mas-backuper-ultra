    cfg = load_cfg()
    try:
        m = int(cfg.get("main_guild_id") or 0)
    except (TypeError, ValueError):
        return 0
    return m if m != int(cfg.get("guild_id", 0) or 0) else 0


def load_ident() -> dict:
    try:
        d = json.loads(ID_FILE.read_text())
    except Exception:  # noqa: BLE001
        d = {}
    d.setdefault("counts", {})
    d.setdefault("locked", False)
    d.setdefault("offender", None)
    return d


def save_ident(d: dict) -> None:
    write_private(ID_FILE, d)


def backups_locked() -> bool:
    return bool(load_ident().get("locked"))


def lock_embed(st: dict | None = None) -> discord.Embed:
    st = st or load_ident()
    off = st.get("offender")
    who = f"<@{off}>" if off else "someone I couldn't identify"
    need = off or CONFIRM_ID
    return ui("error", "Backups are paused",
              f"The server name/logo was changed more than **{MAX_CHANGES} times** by {who}. "
              "**No backup will run** until this is confirmed.",
              [("▶️ To resume", f"<@{need}> must run `/confirm user:{need}`")])


def confirm_check(st: dict, runner: int, user_text: str) -> tuple[bool, str, int | None]:
    """Who may lift the lock: the person who caused it, or CONFIRM_ID. `user` must be the person it is about."""
    if not st.get("locked"):
        return False, "Backups are not paused, there is nothing to confirm.", None
    m = re.search(r"\d{15,20}", user_text or "")
    if not m:
        return False, "Give a user ID, like `/confirm user:123456789012345678`.", None
    uid, off = int(m.group(0)), st.get("offender")
    want = off or CONFIRM_ID
    if uid != want:
        return False, f"That isn't the user this lock is about. It is about `{want}`.", None
    if runner not in {CONFIRM_ID, off}:
        return False, "Only the user who caused the lock (or the bot owner) can confirm it.", None
    return True, "Confirmed. Backups can run again.", uid


async def ensure_warn(guild: discord.Guild) -> discord.TextChannel:
