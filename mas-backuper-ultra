async def _safe_edit(inter: discord.Interaction, **kw) -> None:
    try:
        await inter.edit_original_response(**kw)
    except discord.HTTPException as e:
        log.warning("info-vps: could not update the message: %s", e)


async def run_info(inter: discord.Interaction, n: int) -> None:
    guild = dbg(inter)
    try:
        v = load_vps(n)
    except Exception as e:  # noqa: BLE001
        await _safe_edit(inter, content=None, embed=ui("error", f"Could not read vps-{n}", f"```{str(e)[:300]}```"), view=None)
        return
    running = inter.client.lock.locked()
    await _safe_edit(inter, content=None, embed=discord.Embed(
        description=f"🔎 Connecting to **vps-{n}**…", color=discord.Color(0x00E5FF)), view=None)
    live = await fetch_live(v)
    info = parse_info(live["raw"]) if live.get("raw") else None
    bk = backup_totals(guild, n)
    if live["state"] != "online":
        await _safe_edit(inter, embed=build_info_embed(n, v, live, info, bk, None, None, running),
                         view=InfoView(inter.user.id, n))
        return
    await _safe_edit(inter, embed=build_info_embed(n, v, live, info, bk, None, 0, running))

    async def progress(count: int) -> None:
        await _safe_edit(inter, embed=build_info_embed(n, v, live, info, bk, None, count, running))

    try:
        scan = await coverage_scan(v, bk["state"], progress)
    except Exception as e:  # noqa: BLE001
        log.exception("info-vps scan failed: %s", e)
        live["error"] = f"file scan failed: {str(e)[:150]}"
        scan = None
    await _safe_edit(inter, embed=build_info_embed(n, v, live, info, bk, scan, None, running),
                     view=InfoView(inter.user.id, n))


