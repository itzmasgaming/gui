def dbg(i) -> discord.Guild:
    """The database (backup) server. Commands typed in the main server act on this one."""
    cl = i.client
    return cl.get_guild(int(load_cfg().get("guild_id", 0))) or i.guild


async def guard(interaction: discord.Interaction) -> bool:
    cfg = load_cfg()
    ok_ids = {int(cfg.get("guild_id", 0)), main_gid()} - {0}
    if interaction.guild is None or interaction.guild_id not in ok_ids:
        await reply(interaction, ui("error", "Wrong server", "This bot only works in its own backup server and its main server."), ephemeral=True)
        return False
    if interaction.user.id != interaction.guild.owner_id:
        await reply(interaction, ui("error", "Owner only", "Only the server owner can use this bot."), ephemeral=True)
        return False
    talk = await ensure_talk(interaction.guild)
    if interaction.channel_id != talk.id:
        await reply(interaction, ui("warn", "Wrong channel", f"I only talk in {talk.mention}. Run the command there."),
                    ephemeral=True)
        return False
    if dbg(interaction) is None or dbg(interaction).id != int(cfg.get("guild_id", 0)):
        await reply(interaction, ui("error", "Database server unavailable", "The bot isn't in the database (backup) server right now."), ephemeral=True)
        return False
    return True


async def send_nodes(interaction: discord.Interaction) -> None:
    if not await guard(interaction):
        return
    nums = vps_numbers()
    if not nums:
        await reply(interaction, ui("info", "No VPS yet", "Add your first one with `/vps add`."), ephemeral=True)
        return
    fields = []
    for n in nums[:25]:
        try:
            v = load_vps(n)
        except Exception:  # noqa: BLE001
            continue
        where = "this machine (local)" if v.get("local") else \
            remote_label(v, True)
        if vps_has_data(dbg(interaction), n) and not v.get("synced"):
            st = f"⏳ waiting: `/importbackup vps:{n}` or `/focusbackup vps:{n}`"
        elif v.get("last_backup"):
            st = f"✅ last backup <t:{int(v['last_backup'])}:R>"
        else:
            st = "⚪ no backup yet"
        fields.append((f"🖥️ vps-{n}", f"📡 `{where}`\n{st}", len(nums) > 1))
    await reply(interaction, ui("info", "VPS nodes", f"**{len(fields)}** VPS added • `/info-vps number:<n>` for full details",
                                fields), ephemeral=True)


