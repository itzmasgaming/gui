class TermView(discord.ui.View):
    def __init__(self, owner_id: int, n: int, term: TermSession):
        super().__init__(timeout=900)
        self.owner_id, self.n, self.term = owner_id, n, term

    async def interaction_check(self, i: discord.Interaction) -> bool:
        return i.user.id == self.owner_id

    async def on_timeout(self) -> None:
        await self.term.close()
        if TERMS.get(self.n) is self.term:
            TERMS.pop(self.n, None)

    async def execute(self, i: discord.Interaction, cmd: str) -> None:
        if self.term.lock.locked():
            await reply(i, ui("warn", "Still running", "Wait for the current command to finish."), ephemeral=True)
            return
        async with self.term.lock:
            await i.response.edit_message(embed=self.term.embed(busy=cmd), view=self)
            try:
                await self.term.run(cmd)
            except Exception as e:  # noqa: BLE001
                log.warning("terminal command failed on vps%d: %s", self.n, e)
                self.term.lines.append(f"✖ {conn_error(e)}")
            try:
                await i.edit_original_response(embed=self.term.embed(), view=self)
            except discord.HTTPException as e:
                log.warning("terminal: could not update the message: %s", e)

    @discord.ui.select(placeholder="⚡ Quick commands", options=[
        discord.SelectOption(label=lbl, value=key, emoji=ic, description=cmd[:100])
        for key, (ic, lbl, cmd) in QUICK.items()])
    async def quick(self, i: discord.Interaction, select: discord.ui.Select):
        await self.execute(i, QUICK[select.values[0]][2])

    @discord.ui.button(label="Run command", emoji="⌨️", style=discord.ButtonStyle.primary)
    async def run_btn(self, i: discord.Interaction, b: discord.ui.Button):
        await i.response.send_modal(CmdModal(self))

    @discord.ui.button(label="Clear", emoji="🧹", style=discord.ButtonStyle.secondary)
    async def clear_btn(self, i: discord.Interaction, b: discord.ui.Button):
        self.term.lines.clear()
        await i.response.edit_message(embed=self.term.embed(), view=self)

    @discord.ui.button(label="Disconnect", emoji="🔌", style=discord.ButtonStyle.danger)
    async def close_btn(self, i: discord.Interaction, b: discord.ui.Button):
        await self.term.close()
        if TERMS.get(self.n) is self.term:
            TERMS.pop(self.n, None)
        await i.response.edit_message(embed=ui("ok", f"Terminal closed • vps-{self.n}", "The connection was closed."), view=None)
        self.stop()


