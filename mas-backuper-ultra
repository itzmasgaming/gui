def allowed_ids(guild: discord.Guild) -> set[int]:
    cfg = load_cfg()
    return {guild.owner_id, guild.me.id, *[int(x) for x in cfg.get("allowed_user_ids", [])]}


def backup_findings(guild: discord.Guild) -> list[str]:
    """Everything in this server that shows backup data exists (empty list = nothing to lose)."""
    found = []
    if discord.utils.get(guild.text_channels, name=MARKER):
        found.append(f"#{MARKER}")
    if discord.utils.get(guild.text_channels, name=RECORDS):
        found.append(f"#{RECORDS}")
    for c in guild.categories:
        if c.name == SYSTEM_CAT or re.fullmatch(r"vps-\d+(-\d+)?", c.name):
            found.append(f"category {c.name}")
    return found


def backups_exist(guild: discord.Guild) -> bool:
    return bool(backup_findings(guild))


def vps_categories(guild: discord.Guild, vps: int) -> list[discord.CategoryChannel]:
    pat = re.compile(rf"vps-{vps}(-\d+)?")
    cats = [c for c in guild.categories if pat.fullmatch(c.name)]
    return sorted(cats, key=lambda c: (len(c.name), c.name))


def vps_has_data(guild: discord.Guild, vps: int) -> bool:
    """True if vps-N holds backed-up files (a category with only the empty index channel doesn't count)."""
    return any(ch.name != RECORDS for cat in vps_categories(guild, vps) for ch in cat.channels)


async def delete_many(items, reason: str, batch: int = 5) -> None:
    """Delete channels/kick members a few at a time (much faster than one by one)."""
    for i in range(0, len(items), batch):
        chunk = items[i:i + batch]
        res = await asyncio.gather(*(it.delete(reason=reason) for it in chunk), return_exceptions=True)
        for it, r in zip(chunk, res):
            if isinstance(r, Exception):
                log.error("could not delete %s: %s (Community servers must disable Community first)", it, r)


async def ensure_talk(guild: discord.Guild) -> discord.TextChannel:
    ch = discord.utils.get(guild.text_channels, name=TALK)
    if ch:
        return ch
    return await guild.create_text_channel(
        TALK, topic="Use bot commands and talk here. Backups never touch this channel.")


async def wipe_guild(guild: discord.Guild, keep: discord.abc.GuildChannel | None = None) -> None:
    found = backup_findings(guild)
    if found:
        raise RuntimeError("Refusing to wipe: this server contains backup data (" + ", ".join(found[:6]) +
                           "). Nothing was deleted. Use /focusbackup to delete backups on purpose.")
    allowed = allowed_ids(guild)
    log.info("Wiping %s (%s)", guild.name, guild.id)
    victims = []
    async for m in guild.fetch_members(limit=None):
        if m.id not in allowed:
            victims.append(m)
    for i in range(0, len(victims), 5):
        chunk = victims[i:i + 5]
        res = await asyncio.gather(*(m.kick(reason="MAS backup server wipe") for m in chunk),
                                   return_exceptions=True)
        for m, r in zip(chunk, res):
            if isinstance(r, Exception):
                log.error("could not kick %s: %s (move the bot role higher)", m, r)
            else:
                log.info("kicked %s", m)
    keep_ids = {c.id for c in guild.text_channels if c.name == TALK}
    if keep is not None:
        keep_ids.add(keep.id)
    await delete_many([c for c in guild.channels if c.id not in keep_ids], "MAS backup server wipe")
    try:
        for inv in await guild.invites():
            await inv.delete(reason="MAS backup server is private")
    except Exception as e:  # noqa: BLE001
        log.error("could not clear invites: %s", e)
    try:
        await guild.default_role.edit(permissions=discord.Permissions.none(), reason="MAS private server")
    except Exception as e:  # noqa: BLE001
        log.error("could not make @everyone private: %s", e)
    log.info("Wipe finished.")


async def ensure_marker(guild: discord.Guild):
    ch = discord.utils.get(guild.text_channels, name=MARKER)
    if ch:
        return ch, False
    cat = discord.utils.get(guild.categories, name=SYSTEM_CAT) or await guild.create_category(SYSTEM_CAT)
    ch = await guild.create_text_channel(MARKER, category=cat, topic="Backup marker. DO NOT DELETE.")
    for _ in range(10):
        await ch.send(WARNING)
    return ch, True


