_UPTERM_LOCK = asyncio.Lock()


async def upterm_exec(conn, script: str, timeout: float = 60, limit: int = 60000, flags: dict | None = None) -> bytes:
    """Upterm gives every guest the host's ONE shared shell: it cannot run a command per call.
    So the script is typed into that shell (base64, short lines), run from a temp file, and its output is cut out
    between two markers. It never types `exit`, that would end the shared session. Returns the script's output."""
    flags = flags if flags is not None else {}
    nonce = os.urandom(5).hex()
    tmp = f"/tmp/.mas-{nonce}"
    b64 = base64.b64encode(script.encode()).decode()
    buf = bytearray()
    async with _UPTERM_LOCK:                       # one shared shell = one job at a time
        proc = await conn.create_process(term_type="dumb", request_pty="force", encoding=None)

        def send(text: str) -> None:
            proc.stdin.write(text.encode())

        async def pump() -> None:
            try:
                while True:
                    chunk = await proc.stdout.read(4096)
                    if not chunk:
                        return
                    buf.extend(chunk)
            except Exception:  # noqa: BLE001
                return

        reader = asyncio.create_task(pump())
        begin = re.compile(rb"(?<![%\w])__MAS_BEGIN_" + nonce.encode() + rb"\r?\n")
        end = re.compile(rb"__MAS_END_" + nonce.encode() + rb"_(\d+)")
        try:
            # 1) quiet the terminal (no echo, no prompt) and wait for the BEGIN marker
            send("stty -echo 2>/dev/null; PS1=; PS2=; printf '__MAS_BEGIN_%s\\n' " + nonce + "\n")
            t_end = time.monotonic() + 15
            mb = None
            while time.monotonic() < t_end and mb is None and not reader.done():
                mb = begin.search(bytes(buf))
                await asyncio.sleep(0.05)
            if mb is None:
                raise RuntimeError("the Upterm session did not answer (is `upterm host` still running on the VPS?)")
            mark = mb.end()
            # 2) send the script in short lines, run it, print the END marker
            for i in range(0, len(b64), 800):
                send(f"printf %s '{b64[i:i + 800]}' >> {tmp}.b64\n")
            send(f"base64 -d {tmp}.b64 > {tmp}.sh 2>/dev/null; rm -f {tmp}.b64; "
                 f"if command -v bash >/dev/null 2>&1; then bash {tmp}.sh </dev/null 2>&1; else sh {tmp}.sh </dev/null 2>&1; fi; "
                 f"__r=$?; rm -f {tmp}.sh; printf '\\n__MAS_END_%s_%s\\n' {nonce} \"$__r\"\n")
            t_end = time.monotonic() + timeout
            m = None
            while time.monotonic() < t_end:
                if len(buf) - mark > limit:
                    flags["cut"] = True
                    break
                m = end.search(bytes(buf), mark)
                if m or reader.done():
                    break
                await asyncio.sleep(0.05)
            if m is None:
                if not flags.get("cut"):
                    flags["timeout"] = True
                send("\x03")                        # Ctrl-C the running script, then tidy up
                await asyncio.sleep(1)
                send(f"rm -f {tmp}.b64 {tmp}.sh\n")
                await asyncio.sleep(0.5)
                m = end.search(bytes(buf), mark)
            data = bytes(buf)[mark:(m.start() if m else len(buf))]
            return data.replace(b"\r\n", b"\n")[:limit]
        finally:
            reader.cancel()
            proc.close()


async def test_upterm(v: dict) -> dict:
    """Connects to the Upterm session and checks the two things the bot needs: files (SFTP) and commands."""
    conn = await ssh_connect(v)
    res = {"sftp": False, "shell": False}
    try:
        try:
            async with conn.start_sftp_client() as sftp:
                await sftp.listdir("/")
                res["sftp"] = True
        except Exception as e:  # noqa: BLE001
