async def cmd_backup(interaction: discord.Interaction, vps: int = 0):
    if not await guard(interaction):
        return
    nums = vps_numbers() if vps == 0 else [vps]
    if not nums or any(not vps_file(n).exists() for n in nums):
        await interaction.response.send_message("No such VPS. Use `/vps add` first.", ephemeral=True)
        return
    await interaction.response.send_message(f"Starting backup of vps {', '.join(map(str, nums))}...")
    await backup_job(interaction.client, interaction.channel, interaction.guild, nums)


@app_commands.command(name="importbackup", description="Restore a VPS's backed-up files from Discord to their old paths")
async def cmd_import(interaction: discord.Interaction, vps: int):
    if not await guard(interaction):
        return
    if not vps_file(vps).exists():
        await interaction.response.send_message(f"vps-{vps} isn't added. Use `/vps add` first.", ephemeral=True)
        return
    if not vps_categories(interaction.guild, vps):
        await interaction.response.send_message(f"No backup data for vps-{vps} in this server.", ephemeral=True)
        return
    view = Confirm(interaction.user.id, "Restore (overwrites files)", "Cancel")
    await interaction.response.send_message(
        f"⚠ This reads `{RECORDS}` and **overwrites** matching files on vps-{vps} with the backed-up "
        f"versions, at their old paths. Continue?", view=view)
    await view.wait()
    if not view.ok:
        return
    bot, chan = interaction.client, interaction.channel
    if bot.lock.locked():
        await chan.send("Another backup/restore is already running.")
        return
    async with bot.lock:
        try:
            await run_import(interaction.guild, vps, Status(chan, f"vps-{vps}"))
        except Exception as e:  # noqa: BLE001
            log.exception("import failed: %s", e)
            await chan.send(f"❌ Import failed: `{e}` (see console)")


@app_commands.command(name="focusbackup", description="Delete a VPS's old backup data and start it fresh (0 = every VPS)")
async def cmd_focus(interaction: discord.Interaction, vps: int = 0):
    if not await guard(interaction):
        return
    if vps and not vps_file(vps).exists():
        await interaction.response.send_message(f"vps-{vps} isn't added. Use `/vps add` first.", ephemeral=True)
        return
    what = f"all backup data of **vps-{vps}**" if vps else "**all backup data of every VPS**"
    view = Confirm(interaction.user.id, "Delete old backup + start fresh", "Cancel")
    await interaction.response.send_message(
        f"⚠ This **permanently deletes {what}** (every channel in the category first, then the category) "
        f"and creates it again from scratch. Continue?", view=view)
    await view.wait()
    if not view.ok:
        return
    guild, chan = interaction.guild, interaction.channel
    nums = [vps] if vps else vps_numbers()
    if vps:
        await delete_vps_data(guild, vps)
    else:
        for cat in list(guild.categories):
            m = re.fullmatch(r"vps-(\d+)(-\d+)?", cat.name)
            if m:
                await delete_vps_data(guild, int(m.group(1)))
            elif cat.name == SYSTEM_CAT:
                await delete_many(list(cat.channels), "focusbackup")
                await cat.delete(reason="focusbackup")
    for n in nums:
        state_file(n).unlink(missing_ok=True)
        v = load_vps(n)
        v["synced"] = True
        save_vps(n, v)
        await ensure_category(guild, n)
        await records_channel(guild, n)
    await ensure_talk(guild)
    await chan.send("Old backup data deleted and fresh categories created. Starting backup...")
    await backup_job(interaction.client, chan, guild, nums)


# ------------------------------------------------------------------ bot
class Bot(discord.Client):
    def __init__(self, cfg: dict):
        intents = discord.Intents.default()
        intents.members = True                      # privileged: enable in the Developer Portal
        super().__init__(intents=intents)
        self.cfg = cfg
        self.tree = app_commands.CommandTree(self)
        self.lock = asyncio.Lock()
        self.gid = int(cfg["guild_id"])

    async def setup_hook(self):
        g = discord.Object(id=self.gid)
        for c in (cmd_setup, vps_group, cmd_nodes, cmd_backup, cmd_import, cmd_focus):
            self.tree.add_command(c, guild=g)
        await self.tree.sync(guild=g)
        if float(self.cfg.get("interval_hours", 0)) > 0:
            asyncio.create_task(self.auto_loop())

    async def on_ready(self):
        log.info("Bot online as %s (MAS bot v%s, updated %s)", self.user, VERSION, UPDATED)
        guild = self.get_guild(self.gid)
        if guild is None:
            log.warning("Bot isn't in the configured server (%s). Invite it, then restart.", self.gid)
        else:
            try:
                await ensure_talk(guild)
            except Exception as e:  # noqa: BLE001
                log.error("could not create #%s: %s", TALK, e)
        for g in self.guilds:
            if g.id != self.gid:
                log.warning("leaving unexpected server %s", g.name)
                await g.leave()

    async def on_member_join(self, member: discord.Member):
        if member.guild.id != self.gid or member.id in allowed_ids(member.guild):
            return
        try:
            await member.kick(reason="MAS backup server is private")
            log.info("kicked joiner %s", member)
        except Exception as e:  # noqa: BLE001
            log.error("could not kick joiner %s: %s", member, e)

    async def auto_loop(self):
        await self.wait_until_ready()
        hours = float(self.cfg["interval_hours"])
        while not self.is_closed():
            await asyncio.sleep(hours * 3600)
            guild = self.get_guild(self.gid)
            ch = guild and discord.utils.get(guild.text_channels, name=TALK)
            if guild and ch and backups_exist(guild) and vps_numbers():
                await backup_job(self, ch, guild, vps_numbers())


