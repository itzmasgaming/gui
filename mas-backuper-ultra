class TermSession:
    """One private shell for a VPS. Each command runs in the remembered folder (cd works); the output is
    captured with a time and size limit. Not interactive: use `top -bn1`, not `top`."""

    def __init__(self, v: dict, n: int):
        self.v, self.n, self.conn = v, n, None
        self.cwd, self.home, self.ident = "~", "", ""
        self.lines: list[str] = []
        self.last_rc = None
        self.lock = asyncio.Lock()
        self.started = time.time()
        self.alive = True

    async def _ensure_conn(self) -> None:
        if self.v.get("local"):
            return
        if self.conn is None or self.conn.is_closed():
            self.conn = await asyncio.wait_for(ssh_connect(self.v), 15)

    def _script(self, cmd: str) -> str:
        return (f"cd {shlex.quote(self.cwd)} 2>/dev/null || cd \"$HOME\" 2>/dev/null\n"
                f"{cmd}\n"
                "__mas_rc=$?\n"
                "printf '\\n__MAS_RC__%s\\n__MAS_PWD__%s\\n__MAS_ID__%s@%s\\n__MAS_HOME__%s\\n' "
                "\"$__mas_rc\" \"$(pwd)\" \"$(id -un 2>/dev/null)\" \"$(hostname 2>/dev/null)\" \"$HOME\"\n")

    async def open(self) -> None:
        await self._ensure_conn()
        await self.run("true", record=False)          # learns the home folder + user@host
        self.last_rc = None

    async def run(self, cmd: str, timeout: float = 60, limit: int = 60000, record: bool = True) -> None:
        await self._ensure_conn()
        script = self._script(cmd)
        out = bytearray()
        flags = {"timeout": False, "cut": False}

        async def pump(stream) -> None:
            while True:
                chunk = await stream.read(4096)
                if not chunk:
                    return
                out.extend(chunk)
                if len(out) > limit:
                    flags["cut"] = True
                    return

        if self.v.get("local"):
            sh = shutil.which("bash") or "sh"
            proc = await asyncio.create_subprocess_exec(
                sh, "-c", script, stdin=asyncio.subprocess.DEVNULL, stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT, start_new_session=True)
            try:
                await asyncio.wait_for(pump(proc.stdout), timeout)
            except asyncio.TimeoutError:
                flags["timeout"] = True
            if proc.returncode is None:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    pass
            try:
                await asyncio.wait_for(proc.wait(), 5)
            except asyncio.TimeoutError:
                pass
        elif self.v.get("upterm"):
            out.extend(await upterm_exec(self.conn, script, timeout, limit, flags))
        else:
            inner = (f"if command -v bash >/dev/null 2>&1; then exec bash -c {shlex.quote(script)}; "
                     f"else exec sh -c {shlex.quote(script)}; fi")
            proc = await self.conn.create_process(f"sh -c {shlex.quote(inner)}", request_pty="force",
                                                  term_type="dumb", encoding=None, stdin=asyncssh.DEVNULL)
            try:
                await asyncio.wait_for(pump(proc.stdout), timeout)
            except asyncio.TimeoutError:
                flags["timeout"] = True
            finally:
                proc.close()                              # pty: closing the channel hangs up the command
        text = _ANSI_RE.sub("", bytes(out).decode(errors="replace")).replace("\r\n", "\n").replace("\r", "\n")
        cut = text.find("\n__MAS_RC__")
        shown = text[:cut] if cut != -1 else text
        for key, attr in (("RC", None), ("PWD", "cwd"), ("ID", "ident"), ("HOME", "home")):
            m = re.search(rf"__MAS_{key}__(.*)", text)
            if m:
                val = m.group(1).strip()
                if key == "RC":
                    self.last_rc = int(val) if val.isdigit() else None
                elif val:
                    setattr(self, attr, val)
        if not record:
            return
        first = cmd.strip().splitlines()[0] if cmd.strip() else ""
        if len(cmd.strip().splitlines()) > 1:
            first += " …"
        self.lines.append(f"{self.prompt()} {first}")
        for ln in shown.rstrip("\n").split("\n"):
            if ln != "" or shown.strip():
                self.lines.append(ln[:200] + ("…" if len(ln) > 200 else ""))
        if flags["timeout"]:
            self.lines.append(f"⏱ stopped after {int(timeout)}s")
        if flags["cut"]:
            self.lines.append("✂ output cut (too long)")

    def short_cwd(self) -> str:
        if self.home and self.cwd.startswith(self.home):
            return "~" + self.cwd[len(self.home):]
        return self.cwd

    def prompt(self) -> str:
        return f"{self.ident or f'vps-{self.n}'}:{self.short_cwd()}$"

    def screen(self) -> str:
        text = "\n".join(self.lines).replace("```", "'''")
        if len(text) > 3300:
            text = text[-3300:]
            text = "… (older output scrolled away)\n" + text[text.find("\n") + 1:]
        return text or "# connected - press ⌨️ Run command or pick a quick command"

    def embed(self, busy: str | None = None) -> discord.Embed:
        e = discord.Embed(title=f"💻  Terminal • vps-{self.n}", description=f"```bash\n{self.screen()}\n```",
                          color=discord.Color(0x00E5FF if self.alive else 0x95A5A6), timestamp=discord.utils.utcnow())
        status = "🔴 closed" if not self.alive else (f"⏳ running `{busy.strip().splitlines()[0][:40]}`" if busy else "🟢 connected")
        rc = "—" if self.last_rc is None else (f"✅ {self.last_rc}" if self.last_rc == 0 else f"❌ {self.last_rc}")
        e.add_field(name="📡 Status", value=status, inline=True)
        e.add_field(name="📂 Folder", value=f"`{self.short_cwd()}`", inline=True)
        e.add_field(name="↩️ Last exit", value=rc, inline=True)
        e.set_footer(text=f"{FOOTER} • Terminal • private • 60s per command, not interactive")
        return e

    async def close(self) -> None:
        self.alive = False
        if self.conn is not None:
            self.conn.close()
            try:
                await asyncio.wait_for(self.conn.wait_closed(), 5)
            except Exception:  # noqa: BLE001
                pass
            self.conn = None


class CmdModal(discord.ui.Modal, title="Run command"):
