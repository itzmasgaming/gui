def safe_name(name: str) -> str:
    return name.replace(" ", SEP)


def file_label(name: str, part: int | None) -> str:
    base = safe_name(name)[:150]
    return base if part is None else f"{base}{SEP}part{part}"


def chan_name(bucket: str) -> str:
    s = re.sub(r"[^a-z0-9_-]+", "-", bucket.lower()).strip("-")[:90]
    return s or "root"


def bucket_of(path: str, depth: int) -> str:
    dirs = [p for p in path.split("/") if p][:-1]
    return "/" + "/".join(dirs[:depth]) if dirs else "/"


def part_limit(guild: discord.Guild, cfg: dict) -> int:
    cap = int(cfg.get("max_part_mb", 20)) * 1024 * 1024
    return max(1024 * 1024, min(cap, guild.filesize_limit) - 64 * 1024)


